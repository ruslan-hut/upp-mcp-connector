// Фрагмент для модуля ОБЫЧНОЙ формы элемента справочника MCP_УчетныеЗаписи.
//
// Это не самостоятельный модуль: код обычной формы хранится в Form.bin и в репозиторий
// не попадает. Файл лежит здесь как версионируемый исходник того, что вставлено в форму.
// При изменении обработчика — править здесь тоже, иначе репозиторий разойдётся с базой.
//
// Вся логика ключа живёт в модуле объекта (Catalogs.MCP_УчетныеЗаписи.ObjectModule.bsl);
// экспортные процедуры модуля объекта доступны в модуле обычной формы напрямую по имени.

// Обработчик кнопки «Сгенерировать ключ» командной панели формы.
// Имя процедуры должно совпадать с тем, что подставил Конфигуратор при создании действия.
//
Процедура ДействиеСгенерироватьКлюч(Кнопка)

	Если ЗначениеЗаполнено(КлючДоступа) Тогда

		// Перевыпуск ключа - действие с последствиями: старый ключ перестанет пускать
		// в форму логина гейта. Спрашиваем подтверждение, чтобы это не делалось случайно.
		Ответ = Вопрос("Ключ уже выдан. Сгенерировать новый?"
			+ Символы.ПС + Символы.ПС
			+ "Старый ключ перестанет подходить для входа сразу после записи."
			+ " Уже выданные гейтом сессии при этом продолжат работать —"
			+ " чтобы оборвать их, отзовите доступ на стороне гейта.",
			РежимДиалогаВопрос.ДаНет,
			,
			КодВозвратаДиалога.Нет,
			"Перевыпуск ключа MCP");

		Если Ответ <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;

	КонецЕсли;

	ПерегенерироватьКлюч();

	Модифицированность = Истина;

	Сообщить("Новый ключ доступа сформирован. Он начнёт действовать после записи элемента.");

КонецПроцедуры // ДействиеСгенерироватьКлюч()
