// Назначение: HTTP-сервис MCP — точка входа для Go-гейта (onec-mcp).
// Куда положить: HTTPСервис MCP, модуль сервиса.
//
// Шаблоны URL и обработчики (см. tasks/mcp/ЭТАП1_Конфигуратор.md):
//   GET  /health           -> HealthCheck
//   POST /auth/verify      -> AuthVerify
//   POST /resolve/{entity} -> ResolveEntity
//   POST /reports/{type}   -> ReportsType
//   POST /admin/{action}   -> Admin
//
// Контракт: ~/projects/onec-mcp/docs/onec-integration.md

#Region Обработчики

// GET /mcp/health — проверка живости для гейта. Отдаёт серверное время,
// чтобы расхождение часов с гейтом было видно сразу.
//
Функция HealthCheck(Запрос) Экспорт

	Данные = Новый Структура;
	Данные.Вставить("status", "ok");
	Данные.Вставить("time", MCP_JSON.ДатаВСтроку(ТекущаяДата()));

	Возврат Ответ(Данные);

КонецФункции // HealthCheck()

// POST /mcp/auth/verify — проверка ключа доступа. Тело: {"key":"..."}.
// При успехе 200 {sub, name, scopes}, иначе 401.
//
// Текст ошибки намеренно расплывчатый, а сам ключ никуда не логируется:
// по ответу нельзя выяснить, существует ключ или нет.
//
Функция AuthVerify(Запрос) Экспорт

	Ошибка = Неопределено;

	Тело = Запрос.ПолучитьТелоКакСтроку();

	Данные = MCP_JSON.Распаковать(Тело, Ошибка);

	Если Ошибка <> Неопределено Тогда
		Возврат Ответ(, 400, "Invalid JSON");
	КонецЕсли;

	КлючДоступа = MCP_Утилиты.Значение(Данные, "key");

	Если КлючДоступа = Неопределено ИЛИ ПустаяСтрока(СокрЛП(Строка(КлючДоступа))) Тогда
		Возврат Ответ(, 400, "key is required");
	КонецЕсли;

	Попытка
		Сведения = MCP.ПроверитьКлюч(КлючДоступа);
	Исключение
		Возврат Ответ(, 500, ОписаниеОшибки());
	КонецПопытки;

	Если Сведения = Неопределено Тогда
		Возврат Ответ(, 401, "Invalid access key");
	КонецЕсли;

	Возврат Ответ(Сведения);

КонецФункции // AuthVerify()

// POST /mcp/resolve/{entity} — поиск по справочнику.
// Тело: {"query":"...", "limit":10, "include_groups":false}.
//
Функция ResolveEntity(Запрос) Экспорт

	Ошибка = Неопределено;

	Сущность = Запрос.ПараметрыURL.Получить("entity");

	Если Сущность = Неопределено Тогда
		Возврат Ответ(, 400, "Entity not provided");
	КонецЕсли;

	ОшибкаПрав = ТребуетсяСкоуп(Запрос, MCP.СкоупДляСущности(Сущность));

	Если ОшибкаПрав <> Неопределено Тогда
		Возврат ОшибкаПрав;
	КонецЕсли;

	Если НЕ MCP.СущностьПоддерживается(Сущность) Тогда
		Возврат Ответ(, 400, "Entity not supported: " + Строка(Сущность));
	КонецЕсли;

	Тело = Запрос.ПолучитьТелоКакСтроку();

	Данные = MCP_JSON.Распаковать(Тело, Ошибка);

	Если Ошибка <> Неопределено Тогда
		Возврат Ответ(, 400, Ошибка);
	КонецЕсли;

	СтрокаПоиска = MCP_Утилиты.Значение(Данные, "query");

	// Без строки поиска запрос бессмыслен: уйдёт в ПОДОБНО '%%' и вернёт первые попавшиеся
	Если СтрокаПоиска = Неопределено ИЛИ ПустаяСтрока(СокрЛП(Строка(СтрокаПоиска))) Тогда
		Возврат Ответ(, 400, "query is required");
	КонецЕсли;

	Лимит = MCP_Утилиты.ВЧисло(MCP_Утилиты.Значение(Данные, "limit"));
	ВключатьГруппы = MCP_Утилиты.ВБулево(MCP_Утилиты.Значение(Данные, "include_groups"));

	Попытка

		Кандидаты = MCP.НайтиКандидатов(Сущность,
			СокрЛП(Строка(СтрокаПоиска)),
			Лимит,
			ВключатьГруппы,
			ЗаголовокSub(Запрос));

	Исключение
		// Любая ошибка должна стать JSON-ответом: иначе платформа отдаст HTML-страницу
		// ошибки и сломает разбор на стороне гейта.
		Возврат ОтветНаОшибку(ОписаниеОшибки());
	КонецПопытки;

	Возврат Ответ(Новый Структура("candidates", Кандидаты));

КонецФункции // ResolveEntity()

// POST /mcp/reports/{type} — отчёты. На этапе 1 реализованных типов нет.
//
Функция ReportsType(Запрос) Экспорт

	Ошибка = Неопределено;

	ТипОтчета = Запрос.ПараметрыURL.Получить("type");

	Если ТипОтчета = Неопределено Тогда
		Возврат Ответ(, 400, "Report type not provided");
	КонецЕсли;

	ОшибкаПрав = ТребуетсяСкоуп(Запрос, MCP.СкоупДляОтчета(ТипОтчета));

	Если ОшибкаПрав <> Неопределено Тогда
		Возврат ОшибкаПрав;
	КонецЕсли;

	Если НЕ MCP.ОтчетПоддерживается(ТипОтчета) Тогда
		Возврат Ответ(, 400, "Report type not supported: " + Строка(ТипОтчета));
	КонецЕсли;

	Тело = Запрос.ПолучитьТелоКакСтроку();

	Параметры = MCP_JSON.Распаковать(Тело, Ошибка);

	Если Ошибка <> Неопределено Тогда
		Возврат Ответ(, 400, Ошибка);
	КонецЕсли;

	// Право на закупочную стоимость и учётную запись вычисляем ИЗ ЗАГОЛОВКОВ (доверенный
	// источник) и ВСЕГДА перезаписываем ключи, затирая всё, что мог подсунуть клиент в теле.
	Если ТипЗнч(Параметры) = Тип("Соответствие") Тогда
		Параметры.Вставить("_allow_cost", ЕстьСкоуп(Запрос, "mcp:report:cost"));
		Параметры.Вставить("_sub", ЗаголовокSub(Запрос));
	КонецЕсли;

	Попытка
		Данные = MCP.СформироватьОтчет(ТипОтчета, Параметры);
	Исключение
		Возврат ОтветНаОшибку(ОписаниеОшибки());
	КонецПопытки;

	Возврат Ответ(Данные);

КонецФункции // ReportsType()

// POST /mcp/admin/{action} — журнал регистрации и поиск документа.
// На этапе 1 не реализовано; скоуп проверяем сразу, чтобы поведение
// не менялось при появлении реализации.
//
Функция Admin(Запрос) Экспорт

	Действие = Запрос.ПараметрыURL.Получить("action");

	Если Действие = Неопределено Тогда
		Возврат Ответ(, 400, "Action not provided");
	КонецЕсли;

	ОшибкаПрав = ТребуетсяСкоуп(Запрос, "mcp:admin:eventlog");

	Если ОшибкаПрав <> Неопределено Тогда
		Возврат ОшибкаПрав;
	КонецЕсли;

	Возврат Ответ(, 400, "Unknown admin action: " + Строка(Действие));

КонецФункции // Admin()

#EndRegion

#Region Служебные

// Сборка HTTP-ответа. При Статус <> 200 тело подменяется на {error, message}.
//
Функция Ответ(Данные = Неопределено, Статус = 200, Сообщение = "")

	Ошибка = Неопределено;

	Если Статус <> 200 Тогда

		КодОшибки = "WRONG_DATA";

		Если Статус = 401 Тогда
			КодОшибки = "UNAUTHORIZED";
		ИначеЕсли Статус = 403 Тогда
			КодОшибки = "FORBIDDEN";
		ИначеЕсли Статус = 500 Тогда
			КодОшибки = "DATABASE_ERROR";
		КонецЕсли;

		Данные = Новый Структура("error, message", КодОшибки, Сообщение);

	КонецЕсли;

	Текст = MCP_JSON.Упаковать(Данные, Ошибка);

	Если Ошибка <> Неопределено Тогда

		Результат = Новый HTTPСервисОтвет(500);
		Результат.Заголовки.Вставить("Content-Type", "text/plain; charset=utf-8");
		Текст = Ошибка;

	Иначе

		Результат = Новый HTTPСервисОтвет(Статус);
		Результат.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");

	КонецЕсли;

	// Тело успешного ответа содержит данные учёта - в журнал пишем только ошибки
	Если Статус <> 200 Тогда
		MCP_Утилиты.Лог("E", "response", Строка(Статус) + " " + Текст);
	КонецЕсли;

	Результат.УстановитьТелоИзСтроки(Текст, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);

	Возврат Результат;

КонецФункции // Ответ()

// Ответ на исключение из модуля MCP. Ошибки бизнес-уровня помечены маркером в тексте
// (MCP_FORBIDDEN / MCP_BAD_REQUEST), потому что платформа оборачивает ВызватьИсключение
// в описание с координатами модуля - маркер ищем подстрокой и отдаём 403/400 вместо 500.
// Конвенция общая с rior-cf: обе базы обслуживают один контракт и должны отдавать
// одинаковые коды на одну и ту же ситуацию.
//
Функция ОтветНаОшибку(ТекстОшибки)

	Маркеры = Новый Соответствие;
	Маркеры.Вставить("MCP_FORBIDDEN:", 403);
	Маркеры.Вставить("MCP_BAD_REQUEST:", 400);

	Для Каждого Маркер Из Маркеры Цикл

		Позиция = Найти(ТекстОшибки, Маркер.Ключ);

		Если Позиция > 0 Тогда

			Возврат Ответ(, Маркер.Значение,
				СокрЛП(Сред(ТекстОшибки, Позиция + СтрДлина(Маркер.Ключ))));

		КонецЕсли;

	КонецЦикла;

	Возврат Ответ(, 500, ТекстОшибки);

КонецФункции // ОтветНаОшибку()

// Проверка обязательного скоупа. Возвращает HTTPСервисОтвет при отказе
// или Неопределено при успехе.
//
Функция ТребуетсяСкоуп(Запрос, ТребуемыйСкоуп)

	Если ЕстьСкоуп(Запрос, ТребуемыйСкоуп) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Ответ(, 403, "scope " + ТребуемыйСкоуп + " required");

КонецФункции // ТребуетсяСкоуп()

// Есть ли скоуп в заголовке X-MCP-Scopes.
//
// Отсутствие заголовка означает легаси-режим гейта без OAuth — доступ разрешаем
// (совместимость со статическим токеном). Заголовок с пустым значением от этого
// отличается: он означает "прав нет", и такой вызов отклоняется.
//
Функция ЕстьСкоуп(Запрос, Скоуп)

	Заголовок = ЗначениеЗаголовка(Запрос, "X-MCP-Scopes");

	Если Заголовок = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Для Каждого Элемент Из СтрРазделить(Строка(Заголовок), ",", Ложь) Цикл

		Если СокрЛП(Элемент) = Скоуп Тогда
			Возврат Истина;
		КонецЕсли;

	КонецЦикла;

	Возврат Ложь;

КонецФункции // ЕстьСкоуп()

// Значение заголовка X-MCP-Sub — UUID учётной записи, которую 1С сама вернула
// из /auth/verify. Доверенный источник: заголовок ставит гейт, тело запроса на него
// не влияет. По нему определяются права на фирмы.
//
Функция ЗаголовокSub(Запрос)

	Значение = ЗначениеЗаголовка(Запрос, "X-MCP-Sub");

	Возврат ?(Значение = Неопределено, "", СокрЛП(Строка(Значение)));

КонецФункции // ЗаголовокSub()

// Регистронезависимый поиск заголовка. Имена заголовков регистронезависимы (RFC 7230),
// но Запрос.Заголовки.Получить() в 1С регистрозависим, а Go канонизирует имя
// в "X-Mcp-Scopes". Без перебора заголовок "не находится", молча срабатывает
// легаси-ветка и проверка прав отключается.
//
Функция ЗначениеЗаголовка(Запрос, Имя)

	ИмяНРег = НРег(Имя);

	Для Каждого Заголовок Из Запрос.Заголовки Цикл

		Если НРег(Заголовок.Ключ) = ИмяНРег Тогда
			Возврат Заголовок.Значение;
		КонецЕсли;

	КонецЦикла;

	Возврат Неопределено;

КонецФункции // ЗначениеЗаголовка()

#EndRegion
