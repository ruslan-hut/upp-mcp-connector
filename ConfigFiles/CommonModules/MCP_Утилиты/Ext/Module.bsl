// Назначение: мелкие помощники MCP-сервиса.
// Куда положить: ОбщийМодуль MCP_Утилиты (Сервер = Истина, Вызов сервера = Ложь).

#Region ПрограммныйИнтерфейс

// Число из произвольного значения. Всё, что не разобралось, даёт 0.
// Нужно потому, что JSON приходит от LLM: limit может прийти строкой "10",
// числом 10 или мусором.
//
Функция ВЧисло(Значение) Экспорт

	Если Значение = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат ?(Значение, 1, 0);
	КонецЕсли;

	Строка = СокрЛП(Строка(Значение));

	Если ПустаяСтрока(Строка) Тогда
		Возврат 0;
	КонецЕсли;

	// Оставляем только цифры, знак минуса и первую точку/запятую
	Результат = "";
	ТочкаБыла = Ложь;

	Для Позиция = 1 По СтрДлина(Строка) Цикл

		Символ = Сред(Строка, Позиция, 1);

		Если Найти("0123456789", Символ) > 0 Тогда

			Результат = Результат + Символ;

		ИначеЕсли (Символ = "." ИЛИ Символ = ",") И НЕ ТочкаБыла И Результат <> "" Тогда

			Результат = Результат + ".";
			ТочкаБыла = Истина;

		ИначеЕсли Символ = "-" И Результат = "" Тогда

			Результат = "-";

		КонецЕсли;

	КонецЦикла;

	Если ПустаяСтрока(Результат) ИЛИ Результат = "-" ИЛИ Прав(Результат, 1) = "." Тогда
		Возврат 0;
	КонецЕсли;

	Попытка
		Возврат Число(Результат);
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции // ВЧисло()

// Булево из произвольного значения JSON: true / "true" / 1 считаются Истиной.
//
Функция ВБулево(Значение) Экспорт

	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение <> 0;
	КонецЕсли;

	Возврат НРег(СокрЛП(Строка(Значение))) = "true";

КонецФункции // ВБулево()

// Массив строк из значения JSON. Терпит как массив, так и одиночную строку.
// Пустые элементы отбрасываются.
//
Функция ВМассивСтрок(Значение) Экспорт

	Результат = Новый Массив;

	Если Значение = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Массив") Тогда

		Для Каждого Элемент Из Значение Цикл

			Строка = СокрЛП(Строка(Элемент));

			Если НЕ ПустаяСтрока(Строка) Тогда
				Результат.Добавить(Строка);
			КонецЕсли;

		КонецЦикла;

		Возврат Результат;

	КонецЕсли;

	Строка = СокрЛП(Строка(Значение));

	Если НЕ ПустаяСтрока(Строка) Тогда
		Результат.Добавить(Строка);
	КонецЕсли;

	Возврат Результат;

КонецФункции // ВМассивСтрок()

// Значение по ключу из тела запроса. Тело может прийти Соответствием (обычный разбор)
// или Структурой - функция работает с обоими.
//
Функция Значение(Тело, Имя, ЗначениеПоУмолчанию = Неопределено) Экспорт

	Если ТипЗнч(Тело) = Тип("Соответствие") Тогда

		Результат = Тело.Получить(Имя);
		Возврат ?(Результат = Неопределено, ЗначениеПоУмолчанию, Результат);

	КонецЕсли;

	Если ТипЗнч(Тело) = Тип("Структура") Тогда

		Результат = Неопределено;

		Если Тело.Свойство(Имя, Результат) Тогда
			Возврат ?(Результат = Неопределено, ЗначениеПоУмолчанию, Результат);
		КонецЕсли;

	КонецЕсли;

	Возврат ЗначениеПоУмолчанию;

КонецФункции // Значение()

// Запись в журнал регистрации. В отличие от rior-cf не требует своего регистра сведений.
//
// Параметры:
//  Уровень - Строка - "I" | "W" | "E" | "D".
//  Событие - Строка - имя события, попадает в колонку "Событие" журнала.
//  Текст   - Строка - сообщение.
//
Процедура Лог(Уровень, Событие, Текст) Экспорт

	Если Уровень = "E" Тогда
		УровеньЖР = УровеньЖурналаРегистрации.Ошибка;
	ИначеЕсли Уровень = "W" Тогда
		УровеньЖР = УровеньЖурналаРегистрации.Предупреждение;
	ИначеЕсли Уровень = "D" Тогда
		УровеньЖР = УровеньЖурналаРегистрации.Примечание;
	Иначе
		УровеньЖР = УровеньЖурналаРегистрации.Информация;
	КонецЕсли;

	// Журнал регистрации - не место для мегабайтных тел запросов
	Сообщение = Лев(Строка(Текст), 4000);

	Попытка
		ЗаписьЖурналаРегистрации("MCP." + Событие, УровеньЖР, , , Сообщение);
	Исключение
		// Журналирование не должно валить обработку запроса
	КонецПопытки;

КонецПроцедуры // Лог()

// Экранирование спецсимволов оператора ПОДОБНО. Без него введённые пользователем
// "%" и "_" превращаются в шаблон и запрос молча возвращает не то, что просили.
// Использовать вместе с конструкцией: ПОДОБНО &Шаблон СПЕЦСИМВОЛ "~"
//
Функция ЭкранироватьПодобно(Знач Строка) Экспорт

	Строка = СтрЗаменить(Строка, "~", "~~");
	Строка = СтрЗаменить(Строка, "%", "~%");
	Строка = СтрЗаменить(Строка, "_", "~_");
	Строка = СтрЗаменить(Строка, "[", "~[");

	Возврат Строка;

КонецФункции // ЭкранироватьПодобно()

// Уникальный идентификатор из строки. Возвращает Неопределено, если строка не UUID.
// Нужно, чтобы резолверы принимали не только название, но и готовый UUID.
//
Функция УникальныйИдентификаторИзСтроки(Знач Строка) Экспорт

	Строка = СокрЛП(Строка(Строка));

	Если СтрДлина(Строка) <> 36 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Возврат Новый УникальныйИдентификатор(Строка);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции // УникальныйИдентификаторИзСтроки()

#EndRegion
