      // Назначение: сериализация и разбор JSON для MCP-сервиса.
// Куда положить: ОбщийМодуль MCP_JSON (Сервер = Истина, Вызов сервера = Ложь).
// Порт CommonModules/JSON из rior-cf, урезанный до того, что нужно MCP.

#Region ПрограммныйИнтерфейс

// Сериализует объект в строку JSON.
//
// Параметры:
//  Объект - Произвольный - структура, соответствие, массив.
//  Ошибка - Строка - описание ошибки, если сериализация не удалась.
//  Форматировать - Булево - Истина = с отступами (для отладки).
//
// Возвращаемое значение:
//  Строка - JSON. Пустая строка при ошибке.
//
Функция Упаковать(Объект, Ошибка = Неопределено, Форматировать = Ложь) Экспорт

	Результат = "";

	Попытка

		Запись = Новый ЗаписьJSON;

		Если Форматировать Тогда
			Параметры = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Unix, Символы.Таб);
		Иначе
			Параметры = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет);
		КонецЕсли;

		Запись.УстановитьСтроку(Параметры);

		ЗаписатьJSON(Запись, Объект);

		Результат = Запись.Закрыть();

	Исключение

		Ошибка = "JSON marshall: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());

	КонецПопытки;

	Возврат Результат;

КонецФункции // Упаковать()

// Разбирает строку JSON.
//
// Параметры:
//  Строка - Строка - тело запроса.
//  Ошибка - Строка - описание ошибки, если разбор не удался.
//
// Возвращаемое значение:
//  Соответствие, Массив - результат разбора.
//  Неопределено - при ошибке (Ошибка заполнена).
//
Функция Распаковать(Строка, Ошибка = Неопределено) Экспорт

	Если ПустаяСтрока(Строка) Тогда

		Ошибка = "Empty payload";
		Возврат Неопределено;

	КонецЕсли;

	Попытка

		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Строка);
		// Истина - читать объекты в Соответствие, а не в Структуру: ключи JSON могут содержать
		// символы, недопустимые в именах свойств структуры (например "product_ids" пройдёт,
		// а любой ключ с дефисом или начинающийся с цифры - уже нет).
		Объект = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();

	Исключение

		Ошибка = "JSON unmarshall: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Неопределено;

	КонецПопытки;

	Если ТипЗнч(Объект) <> Тип("Соответствие") И ТипЗнч(Объект) <> Тип("Массив") Тогда

		Ошибка = "Not an object";
		Возврат Неопределено;

	КонецЕсли;

	Возврат Объект;

КонецФункции // Распаковать()

// Дата в строку ISO 8601 "ГГГГ-ММ-ДДTчч:мм:сс".
//
Функция ДатаВСтроку(Дата) Экспорт

	Если ТипЗнч(Дата) <> Тип("Дата") Тогда
		Возврат "";
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Дата) Тогда
		Возврат "";
	КонецЕсли;

	Возврат Формат(Дата, "ДФ=yyyy-MM-ddTHH:mm:ss");

КонецФункции // ДатаВСтроку()

// Дата в строку "ГГГГ-ММ-ДД" (без времени).
//
Функция ДатаВСтрокуКоротко(Дата) Экспорт

	Если ТипЗнч(Дата) <> Тип("Дата") Тогда
		Возврат "";
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Дата) Тогда
		Возврат "";
	КонецЕсли;

	Возврат Формат(Дата, "ДФ=yyyy-MM-dd");

КонецФункции // ДатаВСтрокуКоротко()

// Разбирает дату из строки. Понимает "2026-08-26", "2026-08-26T14:03:21"
// и "2026-08-26 14:03:21" (пробел вместо T).
//
// Возвращаемое значение:
//  Дата - разобранная дата. Пустая дата ('00010101'), если строка не распознана.
//
Функция ДатаИзСтроки(Знач Строка) Экспорт

	Строка = СокрЛП(Строка(Строка));

	Если ПустаяСтрока(Строка) Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;

	// Поддержка формата с пробелом вместо разделителя T
	Если СтрДлина(Строка) > 11 И Сред(Строка, 11, 1) = " " Тогда
		Строка = СтрЗаменить(Строка, " ", "T");
	КонецЕсли;

	Если СтрДлина(Строка) = 10 Тогда

		ЧастьДаты = Строка;
		ЧастьВремени = "00:00:00";

	Иначе

		Если Найти(Строка, "T") <> 11 ИЛИ СтрДлина(Строка) < 19 Тогда
			Возврат Дата(1, 1, 1);
		КонецЕсли;

		ЧастьДаты = Сред(Строка, 1, 10);
		ЧастьВремени = Сред(Строка, 12, 8);

	КонецЕсли;

	Год = MCP_Утилиты.ВЧисло(Сред(ЧастьДаты, 1, 4));
	Месяц = MCP_Утилиты.ВЧисло(Сред(ЧастьДаты, 6, 2));
	День = MCP_Утилиты.ВЧисло(Сред(ЧастьДаты, 9, 2));

	Час = MCP_Утилиты.ВЧисло(Сред(ЧастьВремени, 1, 2));
	Минута = MCP_Утилиты.ВЧисло(Сред(ЧастьВремени, 4, 2));
	Секунда = MCP_Утилиты.ВЧисло(Сред(ЧастьВремени, 7, 2));

	// Дата() падает на нулевых составляющих - отсекаем заведомо неверные значения
	Если Год < 1 ИЛИ Месяц < 1 ИЛИ Месяц > 12 ИЛИ День < 1 ИЛИ День > 31 Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;

	Попытка
		Результат = Дата(Год, Месяц, День, Час, Минута, Секунда);
	Исключение
		Возврат Дата(1, 1, 1);
	КонецПопытки;

	Возврат Результат;

КонецФункции // ДатаИзСтроки()

#EndRegion
