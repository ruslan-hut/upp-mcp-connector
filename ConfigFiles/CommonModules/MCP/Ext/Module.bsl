// Назначение: ядро MCP-сервиса — авторизация ключей, права на фирмы, резолв справочников.
// Куда положить: ОбщийМодуль MCP (Сервер = Истина, Вызов сервера = Ложь).
//
// Этап 1: авторизация, фирмы, резолв customer / warehouse / product / firm.
// Отчёты (СформироватьОтчет) добавляются начиная с этапа 2.
//
// Контракт гейта: ~/projects/onec-mcp/docs/onec-integration.md

#Region Авторизация

// Проверка ключа доступа MCP. Вызывается из POST /mcp/auth/verify.
//
// Возвращаемое значение:
//  Структура - {sub, name, scopes}: sub - UUID учётной записи (гейт вернёт его обратно
//              в заголовке X-MCP-Sub), name - представление сотрудника,
//              scopes - Массив строк вида "mcp:resolve".
//  Неопределено - ключ не найден, помечен на удаление или неактивен.
//
Функция ПроверитьКлюч(КлючДоступа) Экспорт

	Если ПустаяСтрока(СокрЛП(Строка(КлючДоступа))) Тогда
		Возврат Неопределено;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	УчетныеЗаписи.Ссылка КАК Ссылка,
	|	УчетныеЗаписи.Сотрудник КАК Сотрудник
	|ИЗ
	|	Справочник.MCP_УчетныеЗаписи КАК УчетныеЗаписи
	|ГДЕ
	|	НЕ УчетныеЗаписи.ПометкаУдаления
	|	И УчетныеЗаписи.Активен
	|	И УчетныеЗаписи.КлючДоступа = &КлючДоступа";

	Запрос.УстановитьПараметр("КлючДоступа", Строка(КлючДоступа));

	Выборка = Запрос.Выполнить().Выбрать();

	Если НЕ Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("sub", Строка(Выборка.Ссылка.УникальныйИдентификатор()));
	Результат.Вставить("name", Строка(Выборка.Сотрудник));
	Результат.Вставить("scopes", СкоупыУчетнойЗаписи(Выборка.Ссылка));

	Возврат Результат;

КонецФункции // ПроверитьКлюч()

// Массив строковых скоупов учётной записи из табличной части Скоупы.
//
Функция СкоупыУчетнойЗаписи(УчетнаяЗапись)

	Скоупы = Новый Массив;

	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Скоупы.Скоуп КАК Скоуп
	|ИЗ
	|	Справочник.MCP_УчетныеЗаписи.Скоупы КАК Скоупы
	|ГДЕ
	|	Скоупы.Ссылка = &Ссылка";

	Запрос.УстановитьПараметр("Ссылка", УчетнаяЗапись);

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		Строка = СкоупВСтроку(Выборка.Скоуп);

		Если НЕ ПустаяСтрока(Строка) Тогда
			Скоупы.Добавить(Строка);
		КонецЕсли;

	КонецЦикла;

	Возврат Скоупы;

КонецФункции // СкоупыУчетнойЗаписи()

// Значение перечисления MCP_Скоупы -> каноническое OAuth-имя скоупа.
// При добавлении значения в перечисление обязательно добавить ветку сюда,
// иначе скоуп будет молча проигнорирован и инструмент не появится у пользователя.
//
Функция СкоупВСтроку(ЗначениеПеречисления)

	Если ЗначениеПеречисления = Перечисления.MCP_Скоупы.Resolve Тогда
		Возврат "mcp:resolve";

	ИначеЕсли ЗначениеПеречисления = Перечисления.MCP_Скоупы.SalesReport Тогда
		Возврат "mcp:report:sales";

	ИначеЕсли ЗначениеПеречисления = Перечисления.MCP_Скоупы.StockReport Тогда
		Возврат "mcp:report:stock";

	ИначеЕсли ЗначениеПеречисления = Перечисления.MCP_Скоупы.MoneyReport Тогда
		Возврат "mcp:report:money";

	ИначеЕсли ЗначениеПеречисления = Перечисления.MCP_Скоупы.CostData Тогда
		Возврат "mcp:report:cost";

	ИначеЕсли ЗначениеПеречисления = Перечисления.MCP_Скоупы.AdminEventLog Тогда
		Возврат "mcp:admin:eventlog";

	КонецЕсли;

	Возврат "";

КонецФункции // СкоупВСтроку()

// Учётная запись по значению заголовка X-MCP-Sub.
// Возвращает Неопределено, если заголовка нет или он не соответствует активной записи.
//
Функция УчетнаяЗаписьПоИдентификатору(Идентификатор) Экспорт

	УИД = MCP_Утилиты.УникальныйИдентификаторИзСтроки(Идентификатор);

	Если УИД = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);

	Ссылка = Справочники.MCP_УчетныеЗаписи.ПолучитьСсылку(УИД);

	// ПолучитьСсылку() не проверяет существование объекта - проверяем запросом
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	УчетныеЗаписи.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.MCP_УчетныеЗаписи КАК УчетныеЗаписи
	|ГДЕ
	|	УчетныеЗаписи.Ссылка = &Ссылка
	|	И НЕ УчетныеЗаписи.ПометкаУдаления
	|	И УчетныеЗаписи.Активен";

	Запрос.УстановитьПараметр("Ссылка", Ссылка);

	Выборка = Запрос.Выполнить().Выбрать();

	Если НЕ Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Выборка.Ссылка;

КонецФункции // УчетнаяЗаписьПоИдентификатору()

#EndRegion

#Region Ошибки

// Маркеры ошибок бизнес-уровня. Платформа оборачивает ВызватьИсключение в описание
// с координатами модуля, поэтому HTTP-слой ищет маркер подстрокой и отдаёт 403/400
// вместо общего 500. Конвенция общая с rior-cf - обе базы обслуживают один контракт.
//
Функция ОшибкаДоступа(Сообщение) Экспорт

	Возврат "MCP_FORBIDDEN: " + Сообщение;

КонецФункции // ОшибкаДоступа()

Функция ОшибкаЗапроса(Сообщение) Экспорт

	Возврат "MCP_BAD_REQUEST: " + Сообщение;

КонецФункции // ОшибкаЗапроса()

#EndRegion

#Region Фирмы

// Список организаций, разрешённых учётной записи.
//
// Возвращаемое значение:
//  Массив - ссылки на Справочник.Организации. ПУСТОЙ МАССИВ ОЗНАЧАЕТ "БЕЗ ОГРАНИЧЕНИЙ"
//           (работаем без учёта фирмы), а не "ничего нельзя".
//
// Ограничение включается самим фактом заполнения ТЧ Организации у учётной записи:
// одна строка - одна фирма, несколько строк - несколько. Не заполнено - ограничения нет.
// Нет X-MCP-Sub (легаси-режим со статическим токеном) - тоже без ограничения:
// разграничение живёт на учётной записи, а без неё ограничивать нечем.
//
Функция РазрешенныеФирмы(Идентификатор) Экспорт

	Результат = Новый Массив;

	УчетнаяЗапись = УчетнаяЗаписьПоИдентификатору(Идентификатор);

	Если УчетнаяЗапись = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Организации.Организация КАК Организация
	|ИЗ
	|	Справочник.MCP_УчетныеЗаписи.Организации КАК Организации
	|ГДЕ
	|	Организации.Ссылка = &Ссылка
	|	И Организации.Организация <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)";

	Запрос.УстановитьПараметр("Ссылка", УчетнаяЗапись);

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Выборка.Организация);
	КонецЦикла;

	Возврат Результат;

КонецФункции // РазрешенныеФирмы()

// Итоговый отбор по фирмам для отчёта. Читает filters.firm_ids и служебный ключ _sub,
// который HTTP-слой кладёт в параметры из доверенного заголовка X-MCP-Sub.
//
// Возвращаемое значение:
//  Массив - ссылки Организаций для отбора. ПУСТОЙ = отбор не нужен (ключ без ограничений
//           и фильтр не задан).
//
// Исключения:
//  MCP_FORBIDDEN   - запрошены только недоступные ключу фирмы.
//  MCP_BAD_REQUEST - переданные firm_ids не разобрались ни в одну существующую фирму.
//
// Пустой firm_ids при ограниченном ключе даёт отбор по ВСЕМ разрешённым фирмам, а не
// отсутствие отбора - иначе ограничение обходилось бы простым отсутствием фильтра.
//
Функция ОтборПоФирмам(Параметры) Экспорт

	Запрошенные = Новый Массив;

	Фильтры = MCP_Утилиты.Значение(Параметры, "filters");

	Если Фильтры <> Неопределено Тогда

		СырыеИД = MCP_Утилиты.ВМассивСтрок(MCP_Утилиты.Значение(Фильтры, "firm_ids"));

		Для Каждого Элемент Из СырыеИД Цикл

			УИД = MCP_Утилиты.УникальныйИдентификаторИзСтроки(Элемент);

			Если УИД = Неопределено Тогда
				Продолжить;
			КонецЕсли;

			Ссылка = Справочники.Организации.ПолучитьСсылку(УИД);

			Если ФирмаСуществует(Ссылка) Тогда
				Запрошенные.Добавить(Ссылка);
			КонецЕсли;

		КонецЦикла;

		// Все переданные id оказались мусором (битый UUID / удалённая фирма): молча подменять
		// их разрешённым списком нельзя - отчёт получится не по тем фирмам, о которых спросили.
		Если СырыеИД.Количество() > 0 И Запрошенные.Количество() = 0 Тогда
			ВызватьИсключение ОшибкаЗапроса("firm_ids: no existing firm resolved");
		КонецЕсли;

	КонецЕсли;

	Разрешенные = РазрешенныеФирмы(MCP_Утилиты.Значение(Параметры, "_sub", ""));

	Если Разрешенные.Количество() = 0 Тогда
		Возврат Запрошенные;
	КонецЕсли;

	Если Запрошенные.Количество() = 0 Тогда
		Возврат Разрешенные;
	КонецЕсли;

	РазрешенныеСоответствие = Новый Соответствие;

	Для Каждого Фирма Из Разрешенные Цикл
		РазрешенныеСоответствие.Вставить(Фирма, Истина);
	КонецЦикла;

	Результат = Новый Массив;

	Для Каждого Фирма Из Запрошенные Цикл

		Если РазрешенныеСоответствие.Получить(Фирма) = Истина Тогда
			Результат.Добавить(Фирма);
		КонецЕсли;

	КонецЦикла;

	Если Результат.Количество() = 0 Тогда
		// Именно 403, а не пустой отчёт: пустой результат LLM истолкует
		// как "продаж не было", а не как "нет доступа".
		ВызватьИсключение ОшибкаДоступа("firm not allowed");
	КонецЕсли;

	Возврат Результат;

КонецФункции // ОтборПоФирмам()

Функция ФирмаСуществует(Ссылка)

	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Организации.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	Организации.Ссылка = &Ссылка";

	Запрос.УстановитьПараметр("Ссылка", Ссылка);

	Возврат НЕ Запрос.Выполнить().Пустой();

КонецФункции // ФирмаСуществует()

#EndRegion

#Region Сущности

// Внешнее имя сущности (как её видит гейт и LLM) -> внутреннее имя обработчика поиска.
// Возвращает Неопределено для неподдерживаемой сущности - обработчик ответит 400.
//
Функция СущностьПоддерживается(Сущность) Экспорт

	Поддерживаемые = "customer,warehouse,product,firm,sales_channel,cash,cost_article,operation,material";

	Возврат Найти("," + Поддерживаемые + ",", "," + СокрЛП(Строка(Сущность)) + ",") > 0;

КонецФункции // СущностьПоддерживается()

// Требуемый скоуп для резолва сущности. Синхронизировать с ToolScopes в гейте
// (internal/mcp/tools.go).
//
Функция СкоупДляСущности(Сущность) Экспорт

	Если Сущность = "cash" ИЛИ Сущность = "operation" ИЛИ Сущность = "cost_article" Тогда
		Возврат "mcp:report:money";
	КонецЕсли;

	Если Сущность = "material" Тогда
		Возврат "mcp:report:cost";
	КонецЕсли;

	Возврат "mcp:resolve";

КонецФункции // СкоупДляСущности()

#EndRegion

#Region Резолв

// Диспетчер поиска кандидатов.
//
// Параметры:
//  Сущность       - Строка - customer | warehouse | product | firm | sales_channel
//                            | cash | cost_article | operation.
//  Термин         - Строка - строка поиска (или готовый UUID).
//  Лимит          - Число  - максимум строк; нормализуется в 1..100.
//  ВключатьГруппы - Булево - для иерархических справочников отдавать и группы.
//  Идентификатор  - Строка - X-MCP-Sub, нужен для ограничения по фирмам.
//
// Возвращаемое значение:
//  Массив - структуры кандидатов {id, label, ...}.
//
Функция НайтиКандидатов(Сущность, Термин, Лимит = 0, ВключатьГруппы = Ложь, Идентификатор = "") Экспорт

	Лимит = ?(Лимит <= 0, 10, Мин(Лимит, 100));

	Если Сущность = "customer" Тогда
		Возврат НайтиКонтрагентов(Термин, Лимит, ВключатьГруппы);

	ИначеЕсли Сущность = "warehouse" Тогда
		Возврат НайтиСклады(Термин, Лимит, ВключатьГруппы);

	ИначеЕсли Сущность = "product" Тогда
		Возврат НайтиНоменклатуру(Термин, Лимит, ВключатьГруппы, Ложь);

	ИначеЕсли Сущность = "material" Тогда
		Возврат НайтиНоменклатуру(Термин, Лимит, ВключатьГруппы, Истина);

	ИначеЕсли Сущность = "firm" Тогда
		Возврат НайтиОрганизации(Термин, Лимит, Идентификатор);

	ИначеЕсли Сущность = "cash" Тогда
		Возврат НайтиДенежныеСчета(Термин, Лимит);

	ИначеЕсли Сущность = "cost_article" Тогда
		Возврат НайтиСтатьиЗатрат(Термин, Лимит, ВключатьГруппы);

	ИначеЕсли Сущность = "operation" Тогда
		Возврат НайтиСтатьиДДС(Термин, Лимит);

	ИначеЕсли Сущность = "sales_channel" Тогда
		// В УПП нет прямого аналога канала продаж. Инструмент входит в общий mcp:resolve
		// и появляется у LLM, поэтому отвечаем корректным пустым списком, а не 400:
		// ошибка вынудила бы модель повторять вызов, пустой список она понимает сразу.
		Возврат Новый Массив;

	КонецЕсли;

	Возврат Новый Массив;

КонецФункции // НайтиКандидатов()

Функция НайтиКонтрагентов(Термин, Лимит, ВключатьГруппы)

	Кандидаты = Новый Массив;

	УИД = MCP_Утилиты.УникальныйИдентификаторИзСтроки(Термин);

	Запрос = Новый Запрос;

	Если УИД <> Неопределено Тогда

		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Контрагенты.Ссылка КАК Ссылка,
		|	Контрагенты.Наименование КАК Наименование,
		|	Контрагенты.Код КАК Код,
		|	Контрагенты.ЭтоГруппа КАК ЭтоГруппа,
		|	Контрагенты.ПометкаУдаления КАК ПометкаУдаления
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.Ссылка = &Ссылка";

		Запрос.УстановитьПараметр("Ссылка", Справочники.Контрагенты.ПолучитьСсылку(УИД));

	Иначе

		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 100
		|	Контрагенты.Ссылка КАК Ссылка,
		|	Контрагенты.Наименование КАК Наименование,
		|	Контрагенты.Код КАК Код,
		|	Контрагенты.ЭтоГруппа КАК ЭтоГруппа,
		|	Контрагенты.ПометкаУдаления КАК ПометкаУдаления
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	(Контрагенты.Наименование ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""~""
		|		ИЛИ Контрагенты.НаименованиеПолное ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""~""
		|		ИЛИ Контрагенты.Код ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""~""
		|		ИЛИ Контрагенты.КодПоЕДРПОУ ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""~"")
		|	И (&ВключатьГруппы ИЛИ НЕ Контрагенты.ЭтоГруппа)
		|УПОРЯДОЧИТЬ ПО
		|	Контрагенты.Наименование";

		Запрос.УстановитьПараметр("Шаблон", Шаблон(Термин));
		Запрос.УстановитьПараметр("ВключатьГруппы", ВключатьГруппы);

	КонецЕсли;

	Выборка = Запрос.Выполнить().Выбрать();

