КонецФункции // НайтиКонтрагентов()

Функция НайтиСклады(Термин, Лимит, ВключатьГруппы)

	Кандидаты = Новый Массив;

	УИД = MCP_Утилиты.УникальныйИдентификаторИзСтроки(Термин);

	Запрос = Новый Запрос;

	Если УИД <> Неопределено Тогда

		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Склады.Ссылка КАК Ссылка,
		|	Склады.Наименование КАК Наименование,
		|	Склады.Код КАК Код,
		|	Склады.ЭтоГруппа КАК ЭтоГруппа,
		|	Склады.ПометкаУдаления КАК ПометкаУдаления
		|ИЗ
		|	Справочник.Склады КАК Склады
		|ГДЕ
		|	Склады.Ссылка = &Ссылка";

		Запрос.УстановитьПараметр("Ссылка", Справочники.Склады.ПолучитьСсылку(УИД));

	Иначе

		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 100
		|	Склады.Ссылка КАК Ссылка,
		|	Склады.Наименование КАК Наименование,
		|	Склады.Код КАК Код,
		|	Склады.ЭтоГруппа КАК ЭтоГруппа,
		|	Склады.ПометкаУдаления КАК ПометкаУдаления
		|ИЗ
		|	Справочник.Склады КАК Склады
		|ГДЕ
		|	(Склады.Наименование ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""~""
		|		ИЛИ Склады.Код ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""~"")
		|	И (&ВключатьГруппы ИЛИ НЕ Склады.ЭтоГруппа)
		|УПОРЯДОЧИТЬ ПО
		|	Склады.Наименование";

		Запрос.УстановитьПараметр("Шаблон", Шаблон(Термин));
		Запрос.УстановитьПараметр("ВключатьГруппы", ВключатьГруппы);

	КонецЕсли;

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() И Кандидаты.Количество() < Лимит Цикл

		Кандидат = Новый Структура;
		Кандидат.Вставить("id", Строка(Выборка.Ссылка.УникальныйИдентификатор()));
		Кандидат.Вставить("label", Строка(Выборка.Наименование));
		Кандидат.Вставить("code", СокрЛП(Строка(Выборка.Код)));
		Кандидат.Вставить("archived", Выборка.ПометкаУдаления);
		Кандидат.Вставить("is_group", Выборка.ЭтоГруппа);

		Кандидаты.Добавить(Кандидат);

	КонецЦикла;

	Возврат Кандидаты;

КонецФункции // НайтиСклады()

// Резолв product и material. Контракт обещает, что два резолвера делят один справочник
// и НЕ пересекаются, поэтому роль определяется реквизитом ВидВоспроизводства (решение
// заказчика 2026-08-31): материалы - то, что закупают, продукция - всё остальное.
//
// Условие намеренно несимметрично: материалы это РАВНО Закупка, продукция - НЕ РАВНО.
// Незаполненный вид воспроизводства попадает в продукцию, а не проваливается между
// резолверами - иначе такая позиция стала бы недостижимой для обоих.
//
Функция НайтиНоменклатуру(Термин, Лимит, ВключатьГруппы, ТолькоМатериалы = Ложь)

	Кандидаты = Новый Массив;

	УИД = MCP_Утилиты.УникальныйИдентификаторИзСтроки(Термин);

	Запрос = Новый Запрос;

	Если УИД <> Неопределено Тогда

		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Номенклатура.Ссылка КАК Ссылка,
		|	Номенклатура.Наименование КАК Наименование,
		|	Номенклатура.Артикул КАК Артикул,
		|	Номенклатура.БазоваяЕдиницаИзмерения КАК Единица,
		|	Номенклатура.ЭтоГруппа КАК ЭтоГруппа,
		|	Номенклатура.ПометкаУдаления КАК ПометкаУдаления
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Ссылка = &Ссылка
		|	И (Номенклатура.ЭтоГруппа
		|		ИЛИ &ТолькоМатериалы = (Номенклатура.ВидВоспроизводства = &Закупка))";

		Запрос.УстановитьПараметр("Ссылка", Справочники.Номенклатура.ПолучитьСсылку(УИД));

	Иначе

		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 100
		|	Номенклатура.Ссылка КАК Ссылка,
		|	Номенклатура.Наименование КАК Наименование,
		|	Номенклатура.Артикул КАК Артикул,
		|	Номенклатура.БазоваяЕдиницаИзмерения КАК Единица,
		|	Номенклатура.ЭтоГруппа КАК ЭтоГруппа,
		|	Номенклатура.ПометкаУдаления КАК ПометкаУдаления
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	(Номенклатура.Наименование ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""~""
		|		ИЛИ Номенклатура.НаименованиеПолное ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""~""
		|		ИЛИ Номенклатура.Артикул ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""~""
		|		ИЛИ Номенклатура.Код ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""~"")
		|	И (&ВключатьГруппы ИЛИ НЕ Номенклатура.ЭтоГруппа)
		|	И (Номенклатура.ЭтоГруппа
		|		ИЛИ &ТолькоМатериалы = (Номенклатура.ВидВоспроизводства = &Закупка))
		|УПОРЯДОЧИТЬ ПО
		|	Номенклатура.Наименование";

		Запрос.УстановитьПараметр("Шаблон", Шаблон(Термин));
		Запрос.УстановитьПараметр("ВключатьГруппы", ВключатьГруппы);

	КонецЕсли;

	// Группы иерархического справочника вида воспроизводства не имеют - отдаём их обоим
	// резолверам, иначе отбор по товарной группе стал бы недоступен для материалов.
	Запрос.УстановитьПараметр("ТолькоМатериалы", ТолькоМатериалы);
	Запрос.УстановитьПараметр("Закупка", Перечисления.ВидыВоспроизводстваНоменклатуры.Закупка);

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() И Кандидаты.Количество() < Лимит Цикл

		Кандидат = Новый Структура;
		Кандидат.Вставить("id", Строка(Выборка.Ссылка.УникальныйИдентификатор()));
		Кандидат.Вставить("label", Строка(Выборка.Наименование));
		Кандидат.Вставить("code", СокрЛП(Строка(Выборка.Артикул)));
		Кандидат.Вставить("unit", Строка(Выборка.Единица));
		Кандидат.Вставить("archived", Выборка.ПометкаУдаления);
		Кандидат.Вставить("is_group", Выборка.ЭтоГруппа);

		Кандидаты.Добавить(Кандидат);

	КонецЦикла;

	Возврат Кандидаты;

КонецФункции // НайтиНоменклатуру()

// Организации = сущность "firm" контракта. Выдаём только фирмы, разрешённые ключу:
// иначе сам список раскрывал бы структуру группы компаний тому, кому доступна одна фирма.
//
Функция НайтиОрганизации(Термин, Лимит, Идентификатор)

	Кандидаты = Новый Массив;

	// Ограничение по организациям здесь СОЗНАТЕЛЬНО не применяется (решение заказчика
	// от 2026-08-28): ТЧ "Организации" учётной записи - задел на будущие отборы, а не
	// право доступа. Резолвер отдаёт все организации базы; понадобится ограничивать -
	// возвращаем сюда РазрешенныеФирмы(Идентификатор), функция готова и осталась.
	УИД = MCP_Утилиты.УникальныйИдентификаторИзСтроки(Термин);

	Запрос = Новый Запрос;

	Если УИД <> Неопределено Тогда

		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Организации.Ссылка КАК Ссылка,
		|	Организации.Наименование КАК Наименование,
		|	Организации.Код КАК Код,
		|	Организации.ПометкаУдаления КАК ПометкаУдаления
		|ИЗ
		|	Справочник.Организации КАК Организации
		|ГДЕ
		|	Организации.Ссылка = &Ссылка";

		Запрос.УстановитьПараметр("Ссылка", Справочники.Организации.ПолучитьСсылку(УИД));

	Иначе

		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 100
		|	Организации.Ссылка КАК Ссылка,
		|	Организации.Наименование КАК Наименование,
		|	Организации.Код КАК Код,
		|	Организации.ПометкаУдаления КАК ПометкаУдаления
		|ИЗ
		|	Справочник.Организации КАК Организации
		|ГДЕ
		|	Организации.Наименование ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""~""
		|	ИЛИ Организации.НаименованиеПолное ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""~""
		|	ИЛИ Организации.Код ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""~""
		|УПОРЯДОЧИТЬ ПО
		|	Организации.Наименование";

		Запрос.УстановитьПараметр("Шаблон", Шаблон(Термин));

	КонецЕсли;

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() И Кандидаты.Количество() < Лимит Цикл

		Кандидат = Новый Структура;
		Кандидат.Вставить("id", Строка(Выборка.Ссылка.УникальныйИдентификатор()));
		Кандидат.Вставить("label", Строка(Выборка.Наименование));
		Кандидат.Вставить("code", СокрЛП(Строка(Выборка.Код)));
		Кандидат.Вставить("archived", Выборка.ПометкаУдаления);

		Кандидаты.Добавить(Кандидат);

	КонецЦикла;

	Возврат Кандидаты;

КонецФункции // НайтиОрганизации()

// Шаблон для ПОДОБНО с экранированием спецсимволов.
//
// Резолв cash. Денежный счёт в УПП - это касса ИЛИ банковский счёт: в регистрах денег
// оба лежат в одном СОСТАВНОМ измерении БанковскийСчетКасса. Поэтому резолвер ищет по
// двум справочникам сразу - иначе половина остатков была бы недостижима фильтром.
// Счета контрагентов отсекаем: своих денег предприятия на них нет.
//
Функция НайтиДенежныеСчета(Термин, Лимит)

	Кандидаты = Новый Массив;

	УИД = MCP_Утилиты.УникальныйИдентификаторИзСтроки(Термин);

	Запрос = Новый Запрос;

	Если УИД <> Неопределено Тогда

		Запрос.Текст =
		"ВЫБРАТЬ
		|	Кассы.Ссылка КАК Ссылка,
		|	Кассы.Наименование КАК Наименование,
		|	Кассы.Код КАК Код,
		|	Кассы.ПометкаУдаления КАК ПометкаУдаления
		|ИЗ
		|	Справочник.Кассы КАК Кассы
		|ГДЕ
		|	Кассы.Ссылка = &Касса
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Счета.Ссылка,
		|	Счета.Наименование,
		|	Счета.НомерСчета,
		|	Счета.ПометкаУдаления
		|ИЗ
		|	Справочник.БанковскиеСчета КАК Счета
		|ГДЕ
		|	Счета.Ссылка = &Счет";

		Запрос.УстановитьПараметр("Касса", Справочники.Кассы.ПолучитьСсылку(УИД));
		Запрос.УстановитьПараметр("Счет", Справочники.БанковскиеСчета.ПолучитьСсылку(УИД));

	Иначе

		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 100
		|	Кассы.Ссылка КАК Ссылка,
		|	Кассы.Наименование КАК Наименование,
		|	Кассы.Код КАК Код,
		|	Кассы.ПометкаУдаления КАК ПометкаУдаления
		|ИЗ
		|	Справочник.Кассы КАК Кассы
		|ГДЕ
		|	(Кассы.Наименование ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""~""
		|		ИЛИ Кассы.Код ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""~"")
		|	И НЕ Кассы.ЭтоГруппа
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Счета.Ссылка,
		|	Счета.Наименование,
		|	Счета.НомерСчета,
		|	Счета.ПометкаУдаления
		|ИЗ
		|	Справочник.БанковскиеСчета КАК Счета
		|ГДЕ
		|	(Счета.Наименование ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""~""
		|		ИЛИ Счета.НомерСчета ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""~"")
		|	И Счета.Владелец ССЫЛКА Справочник.Организации
		|
		|УПОРЯДОЧИТЬ ПО
		|	Наименование";

		Запрос.УстановитьПараметр("Шаблон", Шаблон(Термин));

	КонецЕсли;

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() И Кандидаты.Количество() < Лимит Цикл

		Кандидат = Новый Структура;
		Кандидат.Вставить("id", Строка(Выборка.Ссылка.УникальныйИдентификатор()));
		Кандидат.Вставить("label", Строка(Выборка.Наименование));
		Кандидат.Вставить("code", СокрЛП(Строка(Выборка.Код)));
		Кандидат.Вставить("archived", Выборка.ПометкаУдаления);

		Кандидаты.Добавить(Кандидат);

	КонецЦикла;

	Возврат Кандидаты;

КонецФункции // НайтиДенежныеСчета()

// Резолв cost_article - Справочник.СтатьиЗатрат.
//
// Внимание: этот справочник НЕ используется в регистрах движения денег, поэтому
// cash_flow фильтр cost_article_ids не принимает (отвечает 400 с подсказкой про
// operation_ids). Резолвер оставлен честным - он ищет настоящие статьи затрат,
// которые понадобятся на этапе производства.
//
Функция НайтиСтатьиЗатрат(Термин, Лимит, ВключатьГруппы)

	Возврат НайтиВСправочникеСтатей(Термин, Лимит, ВключатьГруппы, "Справочник.СтатьиЗатрат",
		Справочники.СтатьиЗатрат);

КонецФункции // НайтиСтатьиЗатрат()

// Резолв operation - Справочник.СтатьиДвиженияДенежныхСредств. Именно эти статьи и есть
// "виды движения денег" контракта: другого измерения-классификатора у регистра
// ДвиженияДенежныхСредств нет.
//
// Группы отдаём ВСЕГДА, а не по флагу: у инструмента resolve_operation параметра
// include_groups нет, а статьи ДДС в этой базе разложены по папкам. Без групп id папки
// неоткуда взять, и отбор "все расчёты с поставщиками" стал бы недоступен.
//
Функция НайтиСтатьиДДС(Термин, Лимит)

	Возврат НайтиВСправочникеСтатей(Термин, Лимит, Истина, "Справочник.СтатьиДвиженияДенежныхСредств",
		Справочники.СтатьиДвиженияДенежныхСредств);

КонецФункции // НайтиСтатьиДДС()

Функция НайтиВСправочникеСтатей(Термин, Лимит, ВключатьГруппы, ИмяТаблицы, Менеджер)

	Кандидаты = Новый Массив;

	УИД = MCP_Утилиты.УникальныйИдентификаторИзСтроки(Термин);

	Запрос = Новый Запрос;

	Если УИД <> Неопределено Тогда

		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Статьи.Ссылка КАК Ссылка,
		|	Статьи.Наименование КАК Наименование,
		|	Статьи.Код КАК Код,
		|	Статьи.ЭтоГруппа КАК ЭтоГруппа,
		|	Статьи.ПометкаУдаления КАК ПометкаУдаления
		|ИЗ
		|	" + ИмяТаблицы + " КАК Статьи
		|ГДЕ
		|	Статьи.Ссылка = &Ссылка";

		Запрос.УстановитьПараметр("Ссылка", Менеджер.ПолучитьСсылку(УИД));

	Иначе

		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 100
		|	Статьи.Ссылка КАК Ссылка,
		|	Статьи.Наименование КАК Наименование,
		|	Статьи.Код КАК Код,
		|	Статьи.ЭтоГруппа КАК ЭтоГруппа,
		|	Статьи.ПометкаУдаления КАК ПометкаУдаления
		|ИЗ
		|	" + ИмяТаблицы + " КАК Статьи
		|ГДЕ
		|	(Статьи.Наименование ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""~""
		|		ИЛИ Статьи.Код ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""~"")
		|	И (&ВключатьГруппы ИЛИ НЕ Статьи.ЭтоГруппа)
		|УПОРЯДОЧИТЬ ПО
		|	Статьи.Наименование";

		Запрос.УстановитьПараметр("Шаблон", Шаблон(Термин));
		Запрос.УстановитьПараметр("ВключатьГруппы", ВключатьГруппы);

	КонецЕсли;

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() И Кандидаты.Количество() < Лимит Цикл

		Кандидат = Новый Структура;
		Кандидат.Вставить("id", Строка(Выборка.Ссылка.УникальныйИдентификатор()));
		Кандидат.Вставить("label", Строка(Выборка.Наименование));
		Кандидат.Вставить("code", СокрЛП(Строка(Выборка.Код)));
		Кандидат.Вставить("archived", Выборка.ПометкаУдаления);
		Кандидат.Вставить("is_group", Выборка.ЭтоГруппа);

		Кандидаты.Добавить(Кандидат);

	КонецЦикла;

	Возврат Кандидаты;

КонецФункции // НайтиВСправочникеСтатей()

Функция Шаблон(Термин)

	Возврат "%" + MCP_Утилиты.ЭкранироватьПодобно(СокрЛП(Строка(Термин))) + "%";

КонецФункции // Шаблон()

#EndRegion

#Region Отчеты

// Реализованные типы отчётов. Этап 2 - stock, этап 3 - продажи (три типа),
// этап 4 - деньги и взаиморасчёты (четыре типа).
// Неперечисленный тип обработчик /reports/{type} отклоняет с 400, не доходя до запроса.
// По мере роста этапов сюда добавляются типы, а в СформироватьОтчет - ветки.
//
Функция ОтчетПоддерживается(ТипОтчета) Экспорт

	Реализованные = "stock,sales,top_products,customer_summary,cash_balance,cash_flow,receivables,payables,"
		+ "specification,specification_cost,specification_where_used,specification_list,"
		+ "specification_explode,specification_versions,production_output,production_consumption,"
		+ "production_document";

	Если ПустаяСтрока(Реализованные) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Найти("," + Реализованные + ",", "," + СокрЛП(Строка(ТипОтчета)) + ",") > 0;

КонецФункции // ОтчетПоддерживается()

// Требуемый скоуп для типа отчёта. Синхронизировать с ToolScopes в гейте
// (internal/mcp/tools.go): расхождение означает, что инструмент виден в списке,
// но падает с 403 при вызове.
//
Функция СкоупДляОтчета(ТипОтчета) Экспорт

	Если ТипОтчета = "stock" ИЛИ ТипОтчета = "availability" ИЛИ ТипОтчета = "goods_in_transit" Тогда
		Возврат "mcp:report:stock";
	КонецЕсли;

	Если ТипОтчета = "product_details" Тогда
		Возврат "mcp:resolve";
	КонецЕсли;

	Если ТипОтчета = "cash_balance" ИЛИ ТипОтчета = "cash_flow"
		ИЛИ ТипОтчета = "receivables" ИЛИ ТипОтчета = "payables"
		ИЛИ ТипОтчета = "purchases" Тогда
		Возврат "mcp:report:money";
	КонецЕсли;

	Если Лев(ТипОтчета, 13) = "specification" ИЛИ Лев(ТипОтчета, 10) = "production" Тогда
		Возврат "mcp:report:cost";
	КонецЕсли;

	// sales, top_products, customer_summary
	Возврат "mcp:report:sales";

КонецФункции // СкоупДляОтчета()

// Диспетчер отчётов. Служебные ключи в Параметрах положены HTTP-слоем из доверенных
// заголовков: _sub (X-MCP-Sub, для ОтборПоФирмам) и _allow_cost (право на себестоимость).
//
Функция СформироватьОтчет(ТипОтчета, Параметры) Экспорт

	Если ТипОтчета = "stock" Тогда
		Возврат ОстаткиТоваров(Параметры);

	ИначеЕсли ТипОтчета = "sales" Тогда
		Возврат Продажи(Параметры);

	ИначеЕсли ТипОтчета = "top_products" Тогда
		Возврат ТопТоваров(Параметры);

	ИначеЕсли ТипОтчета = "customer_summary" Тогда
		Возврат СводкаПоКлиенту(Параметры);

	ИначеЕсли ТипОтчета = "cash_balance" Тогда
		Возврат ОстаткиДенег(Параметры);

	ИначеЕсли ТипОтчета = "cash_flow" Тогда
		Возврат ДвижениеДенег(Параметры);

	ИначеЕсли ТипОтчета = "receivables" Тогда
		Возврат Дебиторка(Параметры);

	ИначеЕсли ТипОтчета = "payables" Тогда
		Возврат Кредиторка(Параметры);

	ИначеЕсли ТипОтчета = "specification" Тогда
		Возврат СоставТовара(Параметры);

	ИначеЕсли ТипОтчета = "specification_cost" Тогда
		Возврат СтоимостьСостава(Параметры);

	ИначеЕсли ТипОтчета = "specification_where_used" Тогда
		Возврат ГдеИспользуется(Параметры);

	ИначеЕсли ТипОтчета = "specification_list" Тогда
		Возврат СписокСпецификаций(Параметры);

	ИначеЕсли ТипОтчета = "production_output" Тогда
		Возврат ВыпускПродукцииОтчет(Параметры);

	ИначеЕсли ТипОтчета = "production_consumption" Тогда
		Возврат РасходМатериаловОтчет(Параметры);

	ИначеЕсли ТипОтчета = "specification_explode" Тогда
		Возврат Разузлование(Параметры);

	ИначеЕсли ТипОтчета = "specification_versions" Тогда
		Возврат ВерсииСостава(Параметры);

	ИначеЕсли ТипОтчета = "production_document" Тогда
		Возврат ПроизводственныйДокумент(Параметры);

	КонецЕсли;

	ВызватьИсключение "Report type not implemented: " + Строка(ТипОтчета);

КонецФункции // СформироватьОтчет()

#EndRegion

#Region ОстаткиТоваров

// Отчёт stock - остатки товаров на дату.
//
// Количество берём из РегистрНакопления.ТоварыНаСкладах (управленческий контур,
// решение от 2026-08-28, пересматривает первоначальный выбор ТоварыОрганизаций).
// Причина: в этой базе учёт товаров организаций ведётся БЕЗ разреза складов
// (см. ОбщиеВБВ.ДвиженияПоТоварамОрганизаций - склад пишется только при
// ВестиУчетТоваровОрганизацийВРазрезеСкладов), и измерение Склад в ТоварыОрганизаций
// пустое почти во всех строках. Склад - основная группировка этого инструмента,
// поэтому источник выбран тот, где он заполнен.
//
// Плата за это - в регистре НЕТ измерения Организация, поэтому разрез по фирмам
// на остатках недоступен: group_by "firm" и filters.firm_ids отвечают 400 с объяснением
// причины (ИзмеренияОстатков, ПроверитьДоступностьФирм). Ограничение по организациям
// с учётной записи при этом не применяется - см. комментарий в ПроверитьДоступностьФирм.
//
// Сумму берём из РегистрНакопления.ПартииТоваровНаСкладах. Это СЕБЕСТОИМОСТЬ остатка,
// поэтому мера amount открыта только ключу со скоупом mcp:report:cost; иначе владелец
// одного mcp:report:stock узнавал бы закупочные цены, которых ему не открывали.
//

// Резерв берём из РегистрНакопления.ТоварыВРезервеНаСкладах (тот же управленческий
// контур, те же измерения Склад и Номенклатура). available = qty - reserved: именно
// доступный остаток отвечает на вопрос "сколько можно продать", тогда как qty включает
// уже обещанное чужим заказам.
//
// Состав остатка - только кондиционный товар: Качество = "Новый" ЛИБО незаполненное.
// Брак и уценка (отдельные элементы справочника Качество) в остаток не попадают:
// на вопрос "сколько товара есть" ожидается ответ про то, чем предприятие может
// распорядиться.
//
// Возвращаемое значение:
//  Структура - {columns, rows, totals} формата контракта.
//
Функция ОстаткиТоваров(Параметры)

	Фильтры = MCP_Утилиты.Значение(Параметры, "filters");

	// В УПП у номенклатуры нет реквизитов жизненного цикла, на которые рассчитан общий
	// контракт. Молча проигнорировать фильтр нельзя: на вопрос "остатки по выведенным
	// позициям" пришли бы остатки по всем, и подмену выборки никто бы не заметил.
	Если MCP_Утилиты.ВМассивСтрок(MCP_Утилиты.Значение(Фильтры, "product_status")).Количество() > 0 Тогда
		ВызватьИсключение ОшибкаЗапроса("product_status is not supported: Номенклатура has no lifecycle status in this database");
	КонецЕсли;

	Измерения = ИзмеренияОстатков(Параметры);
	Меры = МерыОстатков(Параметры, MCP_Утилиты.Значение(Параметры, "_allow_cost", Ложь) = Истина);

	НужнаСтоимость = (Меры.Найти("amount") <> Неопределено);
	НуженРезерв = (Меры.Найти("reserved") <> Неопределено ИЛИ Меры.Найти("available") <> Неопределено);

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;

	Запрос.УстановитьПараметр("Граница", ГраницаОстатков(Параметры));
	// Кондиционным считаем и "Новый", и НЕЗАПОЛНЕННОЕ качество. Второе обязательно:
	// типовые запросы этой базы (в т.ч. TelegramApp) читают партии вообще без условия
	// по качеству, а жёсткий отбор "Качество = Новый" обнулил бы стоимость там, где
	// измерение просто не заполняется. Брак и уценка (отдельные элементы справочника)
	// при этом по-прежнему отсекаются.
	Запрос.УстановитьПараметр("Качество", Справочники.Качество.Новый);
	Запрос.УстановитьПараметр("КачествоНеЗадано", Справочники.Качество.ПустаяСсылка());

	// Отборы уходят В ПАРАМЕТРЫ ВИРТУАЛЬНОЙ ТАБЛИЦЫ, а не в ГДЕ: иначе платформа сначала
	// свернёт остатки по всему регистру и отфильтрует уже посчитанный результат.
	Условия = "";

	Товары = СсылкиФильтра(Фильтры, "product_ids", Справочники.Номенклатура, "Справочник.Номенклатура");

	Если Товары.Количество() > 0 Тогда
		// В ИЕРАРХИИ - чтобы id товарной группы из resolve_product(include_groups = true)
		// работал как отбор по всей группе, как обещает описание инструмента.
		Условия = Условия + " И Номенклатура В ИЕРАРХИИ (&Товары)";
		Запрос.УстановитьПараметр("Товары", Товары);
	КонецЕсли;

	Склады = СсылкиФильтра(Фильтры, "warehouse_ids", Справочники.Склады, "Справочник.Склады");

	Если Склады.Количество() > 0 Тогда
		Условия = Условия + " И Склад В ИЕРАРХИИ (&Склады)";
		Запрос.УстановитьПараметр("Склады", Склады);
	КонецЕсли;

	ПроверитьДоступностьФирм(Параметры, Фильтры);

	Запрос.Текст = ТекстЗапросаОстатков(Измерения, Меры, НужнаСтоимость, НуженРезерв, Условия,
		ЛимитСтрок(Параметры), СпецификацииСортировки(Параметры));

	Пакет = Запрос.ВыполнитьПакет();

	Возврат РезультатОстатков(Пакет[Пакет.ВГраница() - 1], Пакет[Пакет.ВГраница()], Измерения, Меры);

КонецФункции // ОстаткиТоваров()

// Текст пакета: временная таблица движений + детальная выборка + итоги.
//
// Свод считаем по ССЫЛКАМ, а наименования подтягиваем соединением уже к свёрнутому
// результату. Разыменование через точку (ВсеОстатки.Номенклатура.Наименование) в
// СГРУППИРОВАТЬ ПО заставило бы платформу соединять справочник с каждой строкой
// остатков ДО свёртки - на складе в десятки тысяч позиций это лишняя работа.
//
Функция ТекстЗапросаОстатков(Измерения, Меры, НужнаСтоимость, НуженРезерв, Условия, Лимит, Сортировка)

	// Количество и стоимость лежат в РАЗНЫХ регистрах с разным набором измерений,
	// поэтому не соединяем их, а складываем ОБЪЕДИНИТЬ ВСЕ: при соединении строка,
	// которой нет во втором регистре (партия списана, товар остался), потерялась бы
	// целиком вместе с количеством.
	Текст =
	"ВЫБРАТЬ
	|	Остатки.Склад КАК Склад,
	|	Остатки.Номенклатура КАК Номенклатура,
	|	Остатки.КоличествоОстаток КАК Количество,
	|	0 КАК Стоимость,
	|	0 КАК Резерв
	|ПОМЕСТИТЬ ВсеОстатки
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Остатки(&Граница, (Качество = &Качество
	|		ИЛИ Качество = &КачествоНеЗадано)" + Условия + ") КАК Остатки";

	Если НужнаСтоимость Тогда

		// Партионный регистр детальнее (партия, заказ, организация), поэтому его
		// строки сворачиваются к тем же измерениям, что и у количества.
		Текст = Текст + "
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Партии.Склад,
		|	Партии.Номенклатура,
		|	0,
		|	Партии.СтоимостьОстаток,
		|	0
		|ИЗ
		|	РегистрНакопления.ПартииТоваровНаСкладах.Остатки(&Граница, (Качество = &Качество
		|		ИЛИ Качество = &КачествоНеЗадано)" + Условия + ") КАК Партии";

	КонецЕсли;

	Если НуженРезерв Тогда

		// У регистра резервов нет измерения Качество - отбор по нему тут не ставим,
		// иначе резерв обнулился бы так же, как это уже случилось со стоимостью.
		Текст = Текст + "
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Резервы.Склад,
		|	Резервы.Номенклатура,
		|	0,
		|	0,
		|	Резервы.КоличествоОстаток
		|ИЗ
		|	РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(&Граница" + УсловиеРезервов(Условия) + ") КАК Резервы";

	КонецЕсли;

	ПоляСвода = Новый Массив;
	ПоляГруппировки = Новый Массив;
	ПоляВыбора = Новый Массив;
	Соединения = Новый Массив;
	ПоляИндекса = Новый Массив;
	НуженСправочникТоваров = Ложь;

	Для Каждого Измерение Из Измерения Цикл

		Описание = ОписаниеИзмерения(Измерение);

		ПоляСвода.Добавить(Описание.Ключ + " КАК " + Описание.Ссылка);
		ПоляГруппировки.Добавить(Описание.Ключ);

		ПоляИндекса.Добавить(Описание.Ссылка);

		ПоляВыбора.Добавить("Свод." + Описание.Ссылка + " КАК " + Описание.Ссылка);
		ПоляВыбора.Добавить(Описание.Таблица + ".Наименование КАК " + Описание.Имя);

		Соединения.Добавить("ЛЕВОЕ СОЕДИНЕНИЕ " + Описание.Справочник + " КАК " + Описание.Таблица
			+ Символы.ПС + Символы.Таб + "ПО " + Описание.Таблица + ".Ссылка = Свод." + Описание.Ссылка);

		Если Измерение = "product_group" Тогда
			НуженСправочникТоваров = Истина;
		КонецЕсли;

	КонецЦикла;

	ПоляСвода.Добавить("СУММА(ВсеОстатки.Количество) КАК Количество");
	ПоляСвода.Добавить("СУММА(ВсеОстатки.Стоимость) КАК Стоимость");
	ПоляСвода.Добавить("СУММА(ВсеОстатки.Резерв) КАК Резерв");

	ПоляВыбора.Добавить("Свод.Количество КАК Количество");
	ПоляВыбора.Добавить("Свод.Стоимость КАК Стоимость");
	ПоляВыбора.Добавить("Свод.Резерв КАК Резерв");

	// Свод кладём во ВТОРУЮ временную таблицу, а не оставляем подзапросом: соединение
	// справочников с подзапросом платформа выполняет без индексов - на больших складах
	// это самое дорогое место отчёта.
	Свод = ";" + Символы.ПС + Символы.ПС + "ВЫБРАТЬ" + Символы.ПС + Символы.Таб
		+ Соединить(ПоляСвода, "," + Символы.ПС + Символы.Таб) + Символы.ПС
		+ "ПОМЕСТИТЬ СводОстатков" + Символы.ПС
		+ "ИЗ" + Символы.ПС + Символы.Таб + "ВсеОстатки КАК ВсеОстатки";

	Если НуженСправочникТоваров Тогда
		// Родителя берём из справочника, а не разыменованием: поле участвует
		// в группировке, и соединение здесь явное и единственное.
		Свод = Свод + Символы.ПС + Символы.Таб
			+ "ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК КарточкаТовара" + Символы.ПС + Символы.Таб
			+ "ПО КарточкаТовара.Ссылка = ВсеОстатки.Номенклатура";
	КонецЕсли;

	Если ПоляГруппировки.Количество() > 0 Тогда

		Свод = Свод + Символы.ПС + "СГРУППИРОВАТЬ ПО" + Символы.ПС
			+ Символы.Таб + Соединить(ПоляГруппировки, "," + Символы.ПС + Символы.Таб);

		// Нулевые строки отбрасываем: остаток, свернувшийся в ноль (приход и расход внутри
		// одной группировки), для вопроса "что лежит на складе" - шум, а не ответ.
		Свод = Свод + Символы.ПС + "ИМЕЮЩИЕ" + Символы.ПС + Символы.Таб
			+ "СУММА(ВсеОстатки.Количество) <> 0 ИЛИ СУММА(ВсеОстатки.Стоимость) <> 0"
			+ " ИЛИ СУММА(ВсеОстатки.Резерв) <> 0";

	КонецЕсли;

	// Индекс по ссылкам-измерениям: именно по ним свод соединяется со справочниками.
	Если ПоляИндекса.Количество() > 0 Тогда
		Свод = Свод + Символы.ПС + "ИНДЕКСИРОВАТЬ ПО" + Символы.ПС
			+ Символы.Таб + Соединить(ПоляИндекса, "," + Символы.ПС + Символы.Таб);
	КонецЕсли;

	Детали = ";" + Символы.ПС + Символы.ПС + "ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит, "ЧГ=0") + Символы.ПС
		+ Символы.Таб + Соединить(ПоляВыбора, "," + Символы.ПС + Символы.Таб) + Символы.ПС
		+ "ИЗ" + Символы.ПС + Символы.Таб + "СводОстатков КАК Свод";

	Если Соединения.Количество() > 0 Тогда
		Детали = Детали + Символы.ПС + Символы.Таб + Соединить(Соединения, Символы.ПС + Символы.Таб);
	КонецЕсли;

	Детали = Детали + Символы.ПС + "УПОРЯДОЧИТЬ ПО" + Символы.ПС
		+ Символы.Таб + ПорядокОстатков(Измерения, Меры, Сортировка);

	// Итоги считаются по ВСЕЙ выборке, а не по вернувшимся строкам: с top = 10 итог
	// по десяти строкам выглядел бы как остаток всего склада и врал бы тем сильнее,
	// чем меньше строк запрошено.
	Итоги = ";" + Символы.ПС + Символы.ПС +
	"ВЫБРАТЬ
	|	СУММА(ВсеОстатки.Количество) КАК Количество,
	|	СУММА(ВсеОстатки.Стоимость) КАК Стоимость,
	|	СУММА(ВсеОстатки.Резерв) КАК Резерв
	|ИЗ
	|	ВсеОстатки КАК ВсеОстатки";

	Возврат Текст + Свод + Детали + Итоги;

КонецФункции // ТекстЗапросаОстатков()

// Сборка ответа контракта из результатов пакета.
//
Функция РезультатОстатков(РезультатДеталей, РезультатИтогов, Измерения, Меры)

	Колонки = Новый Массив;

	Для Каждого Измерение Из Измерения Цикл
		Колонка = Новый Структура;
		Колонка.Вставить("name", Измерение);
		Колонка.Вставить("type", "ref");
		Колонки.Добавить(Колонка);
	КонецЦикла;

	Для Каждого Мера Из Меры Цикл
		Колонка = Новый Структура;
		Колонка.Вставить("name", Мера);
		Колонка.Вставить("type", "number");
		Колонки.Добавить(Колонка);
	КонецЦикла;

	Строки = Новый Массив;

	Выборка = РезультатДеталей.Выбрать();

	Пока Выборка.Следующий() Цикл

		Строка = Новый Массив;

		Для Каждого Измерение Из Измерения Цикл
			Описание = ОписаниеИзмерения(Измерение);
			Строка.Добавить(ЯчейкаСсылки(Выборка[Описание.Ссылка], Выборка[Описание.Имя]));
		КонецЦикла;

		Для Каждого Мера Из Меры Цикл
			Строка.Добавить(ЗначениеМерыОстатка(Выборка, Мера));
		КонецЦикла;

		Строки.Добавить(Строка);

	КонецЦикла;

	Итоги = Новый Структура;

	ВыборкаИтогов = РезультатИтогов.Выбрать();

	Если ВыборкаИтогов.Следующий() Тогда
		Для Каждого Мера Из Меры Цикл
			Итоги.Вставить(Мера, ЗначениеМерыОстатка(ВыборкаИтогов, Мера));
		КонецЦикла;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("columns", Колонки);
	Результат.Вставить("rows", Строки);
	Результат.Вставить("totals", Итоги);

	Возврат Результат;

КонецФункции // РезультатОстатков()

// Отклоняем filters.firm_ids: остатки считаются по регистру без измерения Организация,
// применить такой фильтр нечем. Молча его проигнорировать нельзя - модель решила бы,
// что цифры уже сужены до нужной фирмы.
//
// Ограничение по организациям на учётной записи здесь СОЗНАТЕЛЬНО не применяется
// (решение заказчика от 2026-08-28): ТЧ "Организации" остаётся заделом на будущие
// отборы, а не правом доступа. Механизм жив и готов - MCP.РазрешенныеФирмы() и
// MCP.ОтборПоФирмам(); понадобится - отчёты начнут их звать, править нечего.
//
Процедура ПроверитьДоступностьФирм(Параметры, Фильтры)

	Если MCP_Утилиты.ВМассивСтрок(MCP_Утилиты.Значение(Фильтры, "firm_ids")).Количество() > 0 Тогда
		ВызватьИсключение ОшибкаЗапроса(
			"firm_ids is not supported for stock: the stock register has no organization dimension in this database");
	КонецЕсли;

КонецПроцедуры // ПроверитьДоступностьФирм()

// Выражение сортировки по мере. Доступный остаток сортируется вычислением: отдельной
// колонки под него в своде нет, а порядок по нему - обычный запрос ("что кончается").
//
Функция ВыражениеСортировкиОстатка(Мера)

	Если Мера = "amount" Тогда
		Возврат "Стоимость";

	ИначеЕсли Мера = "reserved" Тогда
		Возврат "Резерв";

	ИначеЕсли Мера = "available" Тогда
		Возврат "Количество - Резерв";

	КонецЕсли;

	Возврат "Количество";

КонецФункции // ВыражениеСортировкиОстатка()

// Значение меры из строки выборки.
//
Функция ЗначениеМерыОстатка(Выборка, Мера)

	Если Мера = "amount" Тогда
		Возврат MCP_Утилиты.ВЧисло(Выборка.Стоимость);

	ИначеЕсли Мера = "reserved" Тогда
		Возврат MCP_Утилиты.ВЧисло(Выборка.Резерв);

	ИначеЕсли Мера = "available" Тогда
		// Доступный остаток может быть отрицательным - это значит, что зарезервировано
		// больше, чем лежит на складе. Такую строку не прячем: именно она и есть проблема.
		Возврат MCP_Утилиты.ВЧисло(Выборка.Количество) - MCP_Утилиты.ВЧисло(Выборка.Резерв);

	КонецЕсли;

	Возврат MCP_Утилиты.ВЧисло(Выборка.Количество);

КонецФункции // ЗначениеМерыОстатка()

// Соответствие внешнего имени измерения полям запроса.
//
//  Ключ       - выражение группировки внутри свода;
//  Ссылка     - псевдоним колонки-ссылки;
//  Имя        - псевдоним колонки наименования;
//  Справочник - таблица, из которой берётся наименование;
//  Таблица    - псевдоним этой таблицы в соединении.
//
Функция ОписаниеИзмерения(Измерение)

	Ключи = "Ключ, Ссылка, Имя, Справочник, Таблица";

	Если Измерение = "warehouse" Тогда
		Возврат Новый Структура(Ключи, "ВсеОстатки.Склад", "Склад", "СкладИмя",
			"Справочник.Склады", "Т_Склад");

	ИначеЕсли Измерение = "product" Тогда
		Возврат Новый Структура(Ключи, "ВсеОстатки.Номенклатура", "Номенклатура", "НоменклатураИмя",
			"Справочник.Номенклатура", "Т_Номенклатура");

	КонецЕсли;

	// product_group: товарная группа = папка иерархического справочника, то есть
	// непосредственный родитель. Товар, лежащий в корне, даёт пустую ссылку и попадает
	// в строку "(не указано)" - это честнее, чем спрятать его из отчёта.
	Возврат Новый Структура(Ключи, "КарточкаТовара.Родитель", "Группа", "ГруппаИмя",
		"Справочник.Номенклатура", "Т_Группа");

КонецФункции // ОписаниеИзмерения()

// Порядок сортировки. Поля вне выбранных измерений и мер игнорируются - так же,
// как это описано в контракте инструмента.
//
Функция ПорядокОстатков(Измерения, Меры, Сортировка)

	Части = Новый Массив;

	Для Каждого Спецификация Из Сортировка Цикл

		Поле = НРег(СокрЛП(Строка(MCP_Утилиты.Значение(Спецификация, "field", ""))));
		Направление = НРег(СокрЛП(Строка(MCP_Утилиты.Значение(Спецификация, "dir", "asc"))));

		Если Измерения.Найти(Поле) <> Неопределено Тогда
			// Измерение сортируем по наименованию, а не по ссылке: порядок ссылок
			// внутренний и для читателя отчёта выглядит случайным.
			Части.Добавить(ОписаниеИзмерения(Поле).Имя + ?(Направление = "desc", " УБЫВ", " ВОЗР"));

		ИначеЕсли Меры.Найти(Поле) <> Неопределено Тогда
			Части.Добавить(ВыражениеСортировкиОстатка(Поле) + ?(Направление = "desc", " УБЫВ", " ВОЗР"));

		КонецЕсли;

	КонецЦикла;

	Если Части.Количество() > 0 Тогда
		Возврат Соединить(Части, ", ");
	КонецЕсли;

	// По умолчанию сверху самое крупное: запрашивая top = 20, спрашивают двадцать
	// главных позиций, а не двадцать первых по алфавиту.
	Если Меры.Найти("qty") <> Неопределено Тогда
		Возврат "Количество УБЫВ";
	КонецЕсли;

	Если Меры.Найти("amount") <> Неопределено Тогда
		Возврат "Стоимость УБЫВ";
	КонецЕсли;

	Возврат ОписаниеИзмерения(Измерения[0]).Имя;

КонецФункции // ПорядокОстатков()

// Измерения отчёта. Пустой group_by = склад + товар (умолчание контракта).
//
Функция ИзмеренияОстатков(Параметры)

	Допустимые = "warehouse,product,product_group";

	Результат = Новый Массив;

	Для Каждого Измерение Из MCP_Утилиты.ВМассивСтрок(MCP_Утилиты.Значение(Параметры, "group_by")) Цикл

		Имя = НРег(СокрЛП(Измерение));

		// firm есть в общей схеме инструмента, но не в этом регистре - объясняем причину
		// прямо в ошибке, иначе модель будет повторять запрос с тем же измерением.
		Если Имя = "firm" Тогда
			ВызватьИсключение ОшибкаЗапроса(
				"group_by firm is not available for stock: the stock register has no organization dimension in this database");
		КонецЕсли;

		Если Найти("," + Допустимые + ",", "," + Имя + ",") = 0 Тогда
			ВызватьИсключение ОшибкаЗапроса("group_by: unsupported dimension " + Измерение);
		КонецЕсли;

		Если Результат.Найти(Имя) = Неопределено Тогда
			Результат.Добавить(Имя);
		КонецЕсли;

	КонецЦикла;

	Если Результат.Количество() = 0 Тогда
		Результат.Добавить("warehouse");
		Результат.Добавить("product");
		Возврат Результат;
	КонецЕсли;

	// product вместе с product_group избыточны: группа однозначно определяется товаром.
	// Контракт разрешает молча убрать лишнюю колонку, что и делаем.
	Если Результат.Найти("product") <> Неопределено Тогда

		Индекс = Результат.Найти("product_group");

		Если Индекс <> Неопределено Тогда
			Результат.Удалить(Индекс);
		КонецЕсли;

	КонецЕсли;

	Возврат Результат;

КонецФункции // ИзмеренияОстатков()

// Меры отчёта. Пустой measures = только qty (умолчание контракта).
//
Функция МерыОстатков(Параметры, РазрешенаСтоимость)

	Результат = Новый Массив;

	Допустимые = "qty,amount,reserved,available";

	Для Каждого Мера Из MCP_Утилиты.ВМассивСтрок(MCP_Утилиты.Значение(Параметры, "measures")) Цикл

		Имя = НРег(СокрЛП(Мера));

		Если Найти("," + Допустимые + ",", "," + Имя + ",") = 0 Тогда
			ВызватьИсключение ОшибкаЗапроса("measures: unsupported measure " + Мера);
		КонецЕсли;

		// amount в этой базе - себестоимость остатка из партионного регистра, поэтому
		// она закрыта тем же скоупом, что и себестоимость в продажах. 403, а не тихий
		// ноль: ноль LLM истолкует как "товара нет", а не как "цифру не показали".
		Если Имя = "amount" И НЕ РазрешенаСтоимость Тогда
			ВызватьИсключение ОшибкаДоступа("measure amount requires scope mcp:report:cost");
		КонецЕсли;

		Если Результат.Найти(Имя) = Неопределено Тогда
			Результат.Добавить(Имя);
		КонецЕсли;

	КонецЦикла;

	Если Результат.Количество() = 0 Тогда
		Результат.Добавить("qty");
	КонецЕсли;

	// Резерв и доступный остаток отдаём вместе с количеством всегда, даже когда их
	// не просили: в схеме инструмента у гейта их пока нет, то есть модель не знает,
	// что их можно запросить, а на вопрос "сколько есть" правильный ответ - "столько-то,
	// из них столько-то обещано". Ответ самоописателен через columns, лишним не будет.
	Если Результат.Найти("qty") <> Неопределено Тогда

		Если Результат.Найти("reserved") = Неопределено Тогда
			Результат.Вставить(Результат.Найти("qty") + 1, "reserved");
		КонецЕсли;

		Если Результат.Найти("available") = Неопределено Тогда
			Результат.Вставить(Результат.Найти("reserved") + 1, "available");
		КонецЕсли;

	КонецЕсли;

	Возврат Результат;

КонецФункции // МерыОстатков()

// Условие виртуальной таблицы резервов. Накопленная строка отборов начинается с " И ",
// которое перед первым условием не нужно; отбор по качеству в неё не входит - его
// в регистре резервов нет.
//
Функция УсловиеРезервов(Условия)

	Возврат ?(ПустаяСтрока(Условия), "", ", " + Сред(Условия, 4));

КонецФункции // УсловиеРезервов()

// Граница расчёта остатков.
//
// Возвращаемое значение:
//  Дата         - конец указанного дня.
//  Неопределено - дата не задана, берём текущие остатки.
//
Функция ГраницаОстатков(Параметры)

	Значение = MCP_Утилиты.Значение(Параметры, "date");

	Если Значение = Неопределено ИЛИ ПустаяСтрока(СокрЛП(Строка(Значение))) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Дата = MCP_JSON.ДатаИзСтроки(Значение);

	Если НЕ ЗначениеЗаполнено(Дата) Тогда
		ВызватьИсключение ОшибкаЗапроса("date: expected YYYY-MM-DD");
	КонецЕсли;

	// Остаток "на дату" - это остаток на КОНЕЦ дня: с границей на 00:00 движения самого
	// дня в ответ не попадут, и на вопрос про сегодня придёт вчерашняя картина.
	Возврат КонецДня(Дата);

КонецФункции // ГраницаОстатков()

// Ссылки из массива идентификаторов фильтра.
//
// Несуществующие id отсеиваем запросом: без проверки отчёт по опечатке в UUID вернул бы
// честный ноль, а LLM прочитала бы его как "товара нет на складе".
//
Функция СсылкиФильтра(Фильтры, Ключ, Менеджер, ИмяТаблицы)

	Результат = Новый Массив;

	СырыеИД = MCP_Утилиты.ВМассивСтрок(MCP_Утилиты.Значение(Фильтры, Ключ));

	Если СырыеИД.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Кандидаты = Новый Массив;

	Для Каждого Элемент Из СырыеИД Цикл

		УИД = MCP_Утилиты.УникальныйИдентификаторИзСтроки(Элемент);

		Если УИД <> Неопределено Тогда
			Кандидаты.Добавить(Менеджер.ПолучитьСсылку(УИД));
		КонецЕсли;

	КонецЦикла;

	Если Кандидаты.Количество() > 0 Тогда

		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Таблица.Ссылка КАК Ссылка
		|ИЗ
		|	" + ИмяТаблицы + " КАК Таблица
		|ГДЕ
		|	Таблица.Ссылка В (&Ссылки)";

		Запрос.УстановитьПараметр("Ссылки", Кандидаты);

		Выборка = Запрос.Выполнить().Выбрать();

		Пока Выборка.Следующий() Цикл
			Результат.Добавить(Выборка.Ссылка);
		КонецЦикла;

	КонецЕсли;

	Если Результат.Количество() = 0 Тогда
		ВызватьИсключение ОшибкаЗапроса(Ключ + ": no existing object resolved");
	КонецЕсли;

	Возврат Результат;

КонецФункции // СсылкиФильтра()

// Максимум строк детальной выборки. Гейт свой top уже ограничивает, но 1С не обязана
// доверять телу запроса: без потолка group_by по номенклатуре выгрузил бы весь склад.
//
Функция ЛимитСтрок(Параметры)

	Лимит = MCP_Утилиты.ВЧисло(MCP_Утилиты.Значение(Параметры, "top"));

	Если Лимит <= 0 Тогда
		Возврат 100;
	КонецЕсли;

	// ⚠ Анализатор помечает Формат() от этого результата как несоответствие типов:
	// MCP_Утилиты.ВЧисло() в одной из веток возвращает свой параметр как есть, и статически
	// её результат выглядит произвольным. Проверка ТипЗнч там гарантирует число, так что
	// это ложное срабатывание. Обёртка Число() его не лечит - у самой Число() в модели
	// анализатора сигнатура уже (Булево | Строка), и ошибка просто переезжает на неё.
	Возврат Мин(Лимит, 1000);

КонецФункции // ЛимитСтрок()

// Лимит строк для отчётов по составу продукции: их схема объявляет параметр
// "limit" (а не "top", как у остальных отчётов). "top" принимается как запасной
// вариант, чтобы старые вызовы не потеряли ограничение.
//
Функция ЛимитСостава(Параметры, Умолчание)

	Лимит = MCP_Утилиты.ВЧисло(MCP_Утилиты.Значение(Параметры, "limit"));

	Если Лимит <= 0 Тогда
		Лимит = MCP_Утилиты.ВЧисло(MCP_Утилиты.Значение(Параметры, "top"));
	КонецЕсли;

	Если Лимит <= 0 Тогда
		Возврат Умолчание;
	КонецЕсли;

	Возврат Мин(Лимит, 500);

КонецФункции // ЛимитСостава()

// Спецификации сортировки из тела запроса. Не массив - считаем, что сортировка не задана.
//
Функция СпецификацииСортировки(Параметры)

	Значение = MCP_Утилиты.Значение(Параметры, "sort");

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Возврат Значение;
	КонецЕсли;

	Возврат Новый Массив;

КонецФункции // СпецификацииСортировки()

// Ячейка-ссылка ответа: {id, label}. Гейт отдаёт строки как есть, поэтому имя
// подставляем здесь - иначе на каждую строку отчёта LLM звала бы резолвер.
//
Функция ЯчейкаСсылки(Ссылка, Представление)

	Ячейка = Новый Структура;

	// Пустая ссылка - это не объект, и её "нулевой" UUID нельзя отдавать как id:
	// подставленный в следующий запрос, он дал бы отбор по несуществующему объекту.
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Ячейка.Вставить("id", Строка(Ссылка.УникальныйИдентификатор()));
	Иначе
		Ячейка.Вставить("id", "");
	КонецЕсли;

	Имя = СокрЛП(Строка(Представление));

	Ячейка.Вставить("label", ?(ПустаяСтрока(Имя), "(не указано)", Имя));

	Возврат Ячейка;

КонецФункции // ЯчейкаСсылки()

// СтрСоединить в этой конфигурации недоступна (режим совместимости 8.2.13).
//
Функция Соединить(Части, Разделитель)

	Результат = "";

	Для Каждого Часть Из Части Цикл
		Результат = Результат + ?(ПустаяСтрока(Результат), "", Разделитель) + Часть;
	КонецЦикла;

	Возврат Результат;

КонецФункции // Соединить()

#EndRegion

#Region Продажи

// Отчёты sales / top_products / customer_summary.
//
// Источник - РегистрНакопления.Продажи (оборотный). В нём есть Контрагент, Организация,
// Номенклатура, ДокументПродажи; ресурсы Количество, Стоимость, СтоимостьБезСкидок, НДС.
//
// amount = Стоимость - НДС, то есть выручка БЕЗ НДС (решение заказчика 2026-08-28).
// Так же считает типовой код конфигурации (ПроцедурыРасчетаБазыРаспределенияЗатрат:1753),
// и только в таком виде сумма сопоставима с себестоимостью - иначе маржа завышена
// на ставку налога.
//
// Склада и продавца в регистре НЕТ - оба берутся из документа продажи через ВЫРАЗИТЬ
// (см. ВыражениеСклада, ВыражениеПродавца). Склад есть только у трёх "товарных"
// документов, поэтому у комиссионных отчётов и услуг он пустой - это данные, а не ошибка.
//
// Себестоимость - РегистрНакопления.ПродажиСебестоимость. Контрагента в нём нет, но
// регистратор - тот же документ продажи (см. УправлениеЗапасамиПартионныйУчет:10212),
// поэтому связывается по паре "документ + номенклатура" и работает в любом разрезе.
//
Функция Продажи(Параметры)

	Измерения = ИзмеренияПродаж(Параметры);
	Меры = МерыПродаж(Параметры, MCP_Утилиты.Значение(Параметры, "_allow_cost", Ложь) = Истина);

	Возврат ВыборкаПродаж(Параметры, Измерения, Меры, ЛимитСтрок(Параметры),
		СпецификацииСортировки(Параметры));

КонецФункции // Продажи()

// Отчёт top_products - тонкая обёртка над продажами: группировка по товару,
// сортировка по выбранной метрике.
//
Функция ТопТоваров(Параметры)

	Метрика = НРег(СокрЛП(Строка(MCP_Утилиты.Значение(Параметры, "by", "amount"))));

	Если Метрика <> "amount" И Метрика <> "qty" Тогда
		ВызватьИсключение ОшибкаЗапроса("by: expected amount or qty");
	КонецЕсли;

	Измерения = Новый Массив;
	Измерения.Добавить("product");

	Меры = Новый Массив;
	Меры.Добавить("qty");
	Меры.Добавить("amount");

	Сортировка = Новый Массив;
	Спецификация = Новый Структура("field, dir", Метрика, "desc");
	Сортировка.Добавить(Спецификация);

	Лимит = MCP_Утилиты.ВЧисло(MCP_Утилиты.Значение(Параметры, "top"));

	Возврат ВыборкаПродаж(Параметры, Измерения, Меры, ?(Лимит <= 0, 10, Мин(Лимит, 1000)), Сортировка);

КонецФункции // ТопТоваров()

// Отчёт customer_summary - карточка одного контрагента за период.
//
// Возвращает не {columns,rows,totals}, а объект: гейт отдаёт тело отчёта как есть,
// а описание инструмента обещает модели именно карточку - итоги, дату последней
// покупки и топ товаров.
//
Функция СводкаПоКлиенту(Параметры)

	Идентификатор = MCP_Утилиты.УникальныйИдентификаторИзСтроки(
		MCP_Утилиты.Значение(Параметры, "customer_id", ""));

	Если Идентификатор = Неопределено Тогда
		ВызватьИсключение ОшибкаЗапроса("customer_id is required");
	КонецЕсли;

	Контрагент = Справочники.Контрагенты.ПолучитьСсылку(Идентификатор);

	Если НЕ КонтрагентСуществует(Контрагент) Тогда
		ВызватьИсключение ОшибкаЗапроса("customer_id: no such customer");
	КонецЕсли;

	// Параметры карточки кладём в те же ключи, которыми пользуется общий сборщик:
	// сводка - это те же продажи с жёстким отбором по одному контрагенту.
	Фильтры = Новый Соответствие;
	СписокКонтрагентов = Новый Массив;
	СписокКонтрагентов.Добавить(Строка(Идентификатор));
	Фильтры.Вставить("customer_ids", СписокКонтрагентов);

	ПараметрыСводки = Новый Соответствие;
	ПараметрыСводки.Вставить("period", MCP_Утилиты.Значение(Параметры, "period"));
	ПараметрыСводки.Вставить("filters", Фильтры);
	ПараметрыСводки.Вставить("_sub", MCP_Утилиты.Значение(Параметры, "_sub", ""));
	ПараметрыСводки.Вставить("_allow_cost", MCP_Утилиты.Значение(Параметры, "_allow_cost", Ложь));

	РазрешенаСтоимость = (MCP_Утилиты.Значение(Параметры, "_allow_cost", Ложь) = Истина);

	Меры = Новый Массив;
	Меры.Добавить("amount");
	Меры.Добавить("qty");
	Меры.Добавить("receipts");
	Меры.Добавить("avg_check");

	Если РазрешенаСтоимость Тогда
		Меры.Добавить("cost");
		Меры.Добавить("profit");
		Меры.Добавить("margin");
	КонецЕсли;

	// Итоги считаем без группировок: пустой group_by даёт одну строку с итогами.
	Итоги = ВыборкаПродаж(ПараметрыСводки, Новый Массив, Меры, 1, Новый Массив);

	КоличествоТоваров = MCP_Утилиты.ВЧисло(MCP_Утилиты.Значение(Параметры, "top_products"));

	ИзмеренияТоваров = Новый Массив;
	ИзмеренияТоваров.Добавить("product");

	МерыТоваров = Новый Массив;
	МерыТоваров.Добавить("qty");
	МерыТоваров.Добавить("amount");

	СортировкаТоваров = Новый Массив;
	СортировкаТоваров.Добавить(Новый Структура("field, dir", "amount", "desc"));

	ТопТоваровКлиента = ВыборкаПродаж(ПараметрыСводки, ИзмеренияТоваров, МерыТоваров,
		?(КоличествоТоваров <= 0, 5, Мин(КоличествоТоваров, 100)), СортировкаТоваров);

	Результат = Новый Структура;
	Результат.Вставить("customer", ЯчейкаСсылки(Контрагент, Контрагент.Наименование));
	Результат.Вставить("period", Итоги.period);
	Результат.Вставить("totals", Итоги.totals);
	Результат.Вставить("last_purchase", ДатаПоследнейПокупки(Контрагент, ПериодПродаж(ПараметрыСводки)));
	Результат.Вставить("top_products", ТоварыКарточки(ТопТоваровКлиента.rows));

	Возврат Результат;

КонецФункции // СводкаПоКлиенту()

// Строки топа товаров в карточке отдаём объектами, а не позиционными массивами:
// в карточке нет columns, которыми описан обычный отчёт, и без имён полей читателю
// пришлось бы угадывать, где количество, а где сумма.
//
Функция ТоварыКарточки(Строки)

	Результат = Новый Массив;

	Для Каждого Строка Из Строки Цикл

		Товар = Новый Структура;
		Товар.Вставить("product", Строка[0]);
		Товар.Вставить("qty", Строка[1]);
		Товар.Вставить("amount", Строка[2]);

		Результат.Добавить(Товар);

	КонецЦикла;

	Возврат Результат;

КонецФункции // ТоварыКарточки()

Функция КонтрагентСуществует(Ссылка)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Контрагенты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.Ссылка = &Ссылка";

	Запрос.УстановитьПараметр("Ссылка", Ссылка);

	Возврат НЕ Запрос.Выполнить().Пустой();

КонецФункции // КонтрагентСуществует()

// Дата последней покупки контрагента - НЕ ограничена началом периода: карточка отвечает
// на вопрос "когда он покупал в последний раз", и ответ "в этом периоде не покупал"
// был бы бесполезен. Верхняя граница - конец периода, чтобы карточка за прошлый год
// не показывала будущих продаж.
//
Функция ДатаПоследнейПокупки(Контрагент, Период)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	МАКСИМУМ(Продажи.Период) КАК Дата
	|ИЗ
	|	РегистрНакопления.Продажи КАК Продажи
	|ГДЕ
	|	Продажи.Контрагент В ИЕРАРХИИ (&Контрагент)
	|	И Продажи.Период <= &Окончание
	|	И Продажи.Активность";

	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Окончание", Период.Окончание);

	Выборка = Запрос.Выполнить().Выбрать();

	Если НЕ Выборка.Следующий() ИЛИ НЕ ЗначениеЗаполнено(Выборка.Дата) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат MCP_JSON.ДатаВСтрокуКоротко(Выборка.Дата);

КонецФункции // ДатаПоследнейПокупки()


// Общий сборщик всех трёх отчётов по продажам.
//
Функция ВыборкаПродаж(Параметры, Измерения, Меры, Лимит, Сортировка)

	Фильтры = MCP_Утилиты.Значение(Параметры, "filters");

	ОтклонитьНеподдержанныеФильтры(Фильтры);

	Период = ПериодПродаж(Параметры);

	НужнаСебестоимость = (Меры.Найти("cost") <> Неопределено
		ИЛИ Меры.Найти("profit") <> Неопределено
		ИЛИ Меры.Найти("margin") <> Неопределено);

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;

	Запрос.УстановитьПараметр("НачалоПериода", Период.Начало);
	Запрос.УстановитьПараметр("ОкончаниеПериода", Период.Окончание);

	// Отборы по измерениям самого регистра уходят в параметры виртуальной таблицы;
	// отбор по складу так уйти не может - склад берётся из документа, поэтому
	// применяется уже к временной таблице.
	Условия = "";

	Контрагенты = СсылкиФильтра(Фильтры, "customer_ids", Справочники.Контрагенты, "Справочник.Контрагенты");

	Если Контрагенты.Количество() > 0 Тогда
		Условия = Условия + " И Контрагент В ИЕРАРХИИ (&Контрагенты)";
		Запрос.УстановитьПараметр("Контрагенты", Контрагенты);
	КонецЕсли;

	Фирмы = СсылкиФильтра(Фильтры, "firm_ids", Справочники.Организации, "Справочник.Организации");

	Если Фирмы.Количество() > 0 Тогда
		Условия = Условия + " И Организация В (&Фирмы)";
		Запрос.УстановитьПараметр("Фирмы", Фирмы);
	КонецЕсли;

	// В ИЕРАРХИИ - чтобы id товарной группы из resolve_product(include_groups = true)
	// работал как отбор по всей группе, так же как в остатках.
	Товары = СсылкиФильтра(Фильтры, "product_ids", Справочники.Номенклатура, "Справочник.Номенклатура");

	Если Товары.Количество() > 0 Тогда
		Условия = Условия + " И Номенклатура В ИЕРАРХИИ (&Товары)";
		Запрос.УстановитьПараметр("Товары", Товары);
	КонецЕсли;

	Склады = СсылкиФильтра(Фильтры, "warehouse_ids", Справочники.Склады, "Справочник.Склады");

	Если Склады.Количество() > 0 Тогда
		Запрос.УстановитьПараметр("Склады", Склады);
	КонецЕсли;

	Настройки = Новый Структура;
	Настройки.Вставить("Измерения", Измерения);
	Настройки.Вставить("Меры", Меры);
	Настройки.Вставить("Лимит", Лимит);
	Настройки.Вставить("Сортировка", Сортировка);
	Настройки.Вставить("Условия", Условия);
	Настройки.Вставить("Себестоимость", НужнаСебестоимость);
	Настройки.Вставить("ОтборПоСкладам", Склады.Количество() > 0);
	Настройки.Вставить("Фирмы", Фирмы.Количество() > 0);

	Запрос.Текст = ТекстЗапросаПродаж(Настройки);

	Пакет = Запрос.ВыполнитьПакет();

	Результат = РезультатПродаж(Пакет[Пакет.ВГраница() - 1], Пакет[Пакет.ВГраница()], Измерения, Меры);

	Результат.Вставить("period", Новый Структура("from, to",
		MCP_JSON.ДатаВСтрокуКоротко(Период.Начало), MCP_JSON.ДатаВСтрокуКоротко(Период.Окончание)));

	Результат.Вставить("applied_filters", ПримененныеОтборы(Контрагенты, Склады, Фирмы, Товары));

	Возврат Результат;

КонецФункции // ВыборкаПродаж()

// Текст пакета: детали продаж -> (себестоимость) -> свод -> выборка -> итоги.
//
Функция ТекстЗапросаПродаж(Настройки)

	Измерения = Настройки.Измерения;
	Меры = Настройки.Меры;

	НуженСклад = (Измерения.Найти("warehouse") <> Неопределено ИЛИ Настройки.ОтборПоСкладам);
	НуженПродавец = (Измерения.Найти("seller") <> Неопределено);

	ПоляДеталей = Новый Массив;
	ГруппировкаДеталей = Новый Массив;

	ДобавитьПоле(ПоляДеталей, ГруппировкаДеталей, "Обороты.ДокументПродажи", "ДокументПродажи");
	ДобавитьПоле(ПоляДеталей, ГруппировкаДеталей, "Обороты.Номенклатура", "Номенклатура");
	ДобавитьПоле(ПоляДеталей, ГруппировкаДеталей, "Обороты.Контрагент", "Контрагент");
	ДобавитьПоле(ПоляДеталей, ГруппировкаДеталей, "Обороты.Организация", "Организация");

	Периодичность = ПериодичностьПродаж(Измерения);

	Если НЕ ПустаяСтрока(Периодичность) Тогда
		ДобавитьПоле(ПоляДеталей, ГруппировкаДеталей, "Обороты.Период", "Период");
	КонецЕсли;

	Если НуженСклад Тогда
		ДобавитьПоле(ПоляДеталей, ГруппировкаДеталей, ВыражениеСклада(), "Склад");
	КонецЕсли;

	Если НуженПродавец Тогда
		ДобавитьПоле(ПоляДеталей, ГруппировкаДеталей, ВыражениеПродавца(), "Продавец");
	КонецЕсли;

	ПоляДеталей.Добавить("СУММА(Обороты.КоличествоОборот) КАК Количество");
	// Выручка без НДС: ресурс Стоимость хранится с налогом, НДС лежит отдельным ресурсом.
	ПоляДеталей.Добавить("СУММА(Обороты.СтоимостьОборот - Обороты.НДСОборот) КАК Сумма");

	Текст = "ВЫБРАТЬ" + Символы.ПС + Символы.Таб
		+ Соединить(ПоляДеталей, "," + Символы.ПС + Символы.Таб) + Символы.ПС
		+ "ПОМЕСТИТЬ ПродажиДетали" + Символы.ПС
		+ "ИЗ" + Символы.ПС + Символы.Таб
		+ "РегистрНакопления.Продажи.Обороты(&НачалоПериода, &ОкончаниеПериода, "
		+ Периодичность + УсловиеВиртуальнойТаблицы(Настройки.Условия) + ") КАК Обороты" + Символы.ПС
		+ "СГРУППИРОВАТЬ ПО" + Символы.ПС + Символы.Таб
		+ Соединить(ГруппировкаДеталей, "," + Символы.ПС + Символы.Таб) + Символы.ПС
		+ "ИНДЕКСИРОВАТЬ ПО" + Символы.ПС + Символы.Таб + "ДокументПродажи," + Символы.ПС
		+ Символы.Таб + "Номенклатура";

	Если Настройки.Себестоимость Тогда

		// Себестоимость связывается по РЕГИСТРАТОРУ: в ПродажиСебестоимость нет
		// ни контрагента, ни ссылки на документ продажи как измерения, но пишется
		// она тем же документом, что и выручка.
		Текст = Текст + ";" + Символы.ПС + Символы.ПС +
		"ВЫБРАТЬ
		|	Себестоимость.Регистратор КАК ДокументПродажи,
		|	Себестоимость.Номенклатура КАК Номенклатура,
		|	СУММА(Себестоимость.Стоимость) КАК Себестоимость
		|ПОМЕСТИТЬ СебестоимостьДетали
		|ИЗ
		|	РегистрНакопления.ПродажиСебестоимость КАК Себестоимость
		|ГДЕ
		|	Себестоимость.Период МЕЖДУ &НачалоПериода И &ОкончаниеПериода
		|	И Себестоимость.Активность" + ?(Настройки.Фирмы, "
		|	И Себестоимость.Организация В (&Фирмы)", "") + "
		|СГРУППИРОВАТЬ ПО
		|	Себестоимость.Регистратор,
		|	Себестоимость.Номенклатура
		|ИНДЕКСИРОВАТЬ ПО
		|	ДокументПродажи,
		|	Номенклатура";

	КонецЕсли;

	Возврат Текст + ТекстСводаПродаж(Настройки, НуженСклад) + ТекстВыборкиПродаж(Настройки)
		+ ТекстИтоговПродаж(Настройки);

КонецФункции // ТекстЗапросаПродаж()


// Свод: группировка деталей до запрошенных измерений плюс присоединение себестоимости.
//
Функция ТекстСводаПродаж(Настройки, НуженСклад)

	Измерения = Настройки.Измерения;

	ПоляСвода = Новый Массив;
	ГруппировкаСвода = Новый Массив;
	ПоляИндекса = Новый Массив;
	НуженСправочникТоваров = Ложь;
	НуженСправочникКлиентов = Ложь;

	Для Каждого Измерение Из Измерения Цикл

		Описание = ОписаниеИзмеренияПродаж(Измерение);

		ПоляСвода.Добавить(Описание.Ключ + " КАК " + Описание.Ссылка);
		ГруппировкаСвода.Добавить(Описание.Ключ);

		Если Описание.Тип = "ref" Тогда
			ПоляИндекса.Добавить(Описание.Ссылка);
		КонецЕсли;

		Если Измерение = "product_group" Тогда
			НуженСправочникТоваров = Истина;
		ИначеЕсли Измерение = "customer_group" Тогда
			НуженСправочникКлиентов = Истина;
		КонецЕсли;

	КонецЦикла;

	ПоляСвода.Добавить("СУММА(ПродажиДетали.Сумма) КАК Сумма");
	ПоляСвода.Добавить("СУММА(ПродажиДетали.Количество) КАК Количество");
	// Чеки и клиенты - именно РАЗЛИЧНЫЕ: один документ даёт много строк регистра,
	// и сумма строк вместо числа документов завысила бы средний чек в разы.
	ПоляСвода.Добавить("КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ПродажиДетали.ДокументПродажи) КАК Чеки");
	ПоляСвода.Добавить("КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ПродажиДетали.Контрагент) КАК Клиенты");

	Если Настройки.Себестоимость Тогда
		ПоляСвода.Добавить("СУММА(ЕСТЬNULL(СебестоимостьДетали.Себестоимость, 0)) КАК Себестоимость");
	Иначе
		ПоляСвода.Добавить("0 КАК Себестоимость");
	КонецЕсли;

	Текст = ";" + Символы.ПС + Символы.ПС + "ВЫБРАТЬ" + Символы.ПС + Символы.Таб
		+ Соединить(ПоляСвода, "," + Символы.ПС + Символы.Таб) + Символы.ПС
		+ "ПОМЕСТИТЬ СводПродаж" + Символы.ПС
		+ "ИЗ" + Символы.ПС + Символы.Таб + "ПродажиДетали КАК ПродажиДетали";

	Если Настройки.Себестоимость Тогда
		Текст = Текст + Символы.ПС + Символы.Таб
			+ "ЛЕВОЕ СОЕДИНЕНИЕ СебестоимостьДетали КАК СебестоимостьДетали" + Символы.ПС + Символы.Таб
			+ "ПО СебестоимостьДетали.ДокументПродажи = ПродажиДетали.ДокументПродажи" + Символы.ПС + Символы.Таб
			+ "	И СебестоимостьДетали.Номенклатура = ПродажиДетали.Номенклатура";
	КонецЕсли;

	Если НуженСправочникТоваров Тогда
		Текст = Текст + Символы.ПС + Символы.Таб
			+ "ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК КарточкаТовара" + Символы.ПС + Символы.Таб
			+ "ПО КарточкаТовара.Ссылка = ПродажиДетали.Номенклатура";
	КонецЕсли;

	Если НуженСправочникКлиентов Тогда
		Текст = Текст + Символы.ПС + Символы.Таб
			+ "ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК КарточкаКлиента" + Символы.ПС + Символы.Таб
			+ "ПО КарточкаКлиента.Ссылка = ПродажиДетали.Контрагент";
	КонецЕсли;

	Если НуженСклад И Настройки.ОтборПоСкладам Тогда
		Текст = Текст + Символы.ПС + "ГДЕ" + Символы.ПС + Символы.Таб
			+ "ПродажиДетали.Склад В ИЕРАРХИИ (&Склады)";
	КонецЕсли;

	Если ГруппировкаСвода.Количество() > 0 Тогда
		Текст = Текст + Символы.ПС + "СГРУППИРОВАТЬ ПО" + Символы.ПС + Символы.Таб
			+ Соединить(ГруппировкаСвода, "," + Символы.ПС + Символы.Таб);
	КонецЕсли;

	Если ПоляИндекса.Количество() > 0 Тогда
		Текст = Текст + Символы.ПС + "ИНДЕКСИРОВАТЬ ПО" + Символы.ПС + Символы.Таб
			+ Соединить(ПоляИндекса, "," + Символы.ПС + Символы.Таб);
	КонецЕсли;

	Возврат Текст;

КонецФункции // ТекстСводаПродаж()

// Детальная выборка: к своду присоединяются справочники за наименованиями.
//
Функция ТекстВыборкиПродаж(Настройки)

	ПоляВыбора = Новый Массив;
	Соединения = Новый Массив;

	Для Каждого Измерение Из Настройки.Измерения Цикл

		Описание = ОписаниеИзмеренияПродаж(Измерение);

		ПоляВыбора.Добавить("Свод." + Описание.Ссылка + " КАК " + Описание.Ссылка);

		Если Описание.Тип = "ref" Тогда

			ПоляВыбора.Добавить(Описание.ВыражениеИмени + " КАК " + Описание.Имя);

			Для Каждого Соединение Из Описание.Соединения Цикл
				Соединения.Добавить(Соединение);
			КонецЦикла;

		КонецЕсли;

	КонецЦикла;

	ПоляВыбора.Добавить("Свод.Сумма КАК Сумма");
	ПоляВыбора.Добавить("Свод.Количество КАК Количество");
	ПоляВыбора.Добавить("Свод.Чеки КАК Чеки");
	ПоляВыбора.Добавить("Свод.Клиенты КАК Клиенты");
	ПоляВыбора.Добавить("Свод.Себестоимость КАК Себестоимость");

	Текст = ";" + Символы.ПС + Символы.ПС + "ВЫБРАТЬ ПЕРВЫЕ " + Формат(Настройки.Лимит, "ЧГ=0") + Символы.ПС
		+ Символы.Таб + Соединить(ПоляВыбора, "," + Символы.ПС + Символы.Таб) + Символы.ПС
		+ "ИЗ" + Символы.ПС + Символы.Таб + "СводПродаж КАК Свод";

	Если Соединения.Количество() > 0 Тогда
		Текст = Текст + Символы.ПС + Символы.Таб + Соединить(Соединения, Символы.ПС + Символы.Таб);
	КонецЕсли;

	Возврат Текст + Символы.ПС + "УПОРЯДОЧИТЬ ПО" + Символы.ПС + Символы.Таб
		+ ПорядокПродаж(Настройки.Измерения, Настройки.Меры, Настройки.Сортировка);

КонецФункции // ТекстВыборкиПродаж()

// Итоги считаются по ДЕТАЛЯМ, а не по своду: чеки и клиенты - это РАЗЛИЧНЫЕ документы
// и контрагенты по всей выборке, а сумма таких счётчиков по строкам свода посчитала бы
// один и тот же чек столько раз, во сколько строк он попал.
//
Функция ТекстИтоговПродаж(Настройки)

	Текст = ";" + Символы.ПС + Символы.ПС +
	"ВЫБРАТЬ
	|	СУММА(ПродажиДетали.Сумма) КАК Сумма,
	|	СУММА(ПродажиДетали.Количество) КАК Количество,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ПродажиДетали.ДокументПродажи) КАК Чеки,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ПродажиДетали.Контрагент) КАК Клиенты," + ?(Настройки.Себестоимость, "
	|	СУММА(ЕСТЬNULL(СебестоимостьДетали.Себестоимость, 0)) КАК Себестоимость", "
	|	0 КАК Себестоимость") + "
	|ИЗ
	|	ПродажиДетали КАК ПродажиДетали";

	Если Настройки.Себестоимость Тогда
		Текст = Текст + "
		|	ЛЕВОЕ СОЕДИНЕНИЕ СебестоимостьДетали КАК СебестоимостьДетали
		|	ПО СебестоимостьДетали.ДокументПродажи = ПродажиДетали.ДокументПродажи
		|		И СебестоимостьДетали.Номенклатура = ПродажиДетали.Номенклатура";
	КонецЕсли;

	Если Настройки.ОтборПоСкладам Тогда
		Текст = Текст + "
		|ГДЕ
		|	ПродажиДетали.Склад В ИЕРАРХИИ (&Склады)";
	КонецЕсли;

	Возврат Текст;

КонецФункции // ТекстИтоговПродаж()


// Склад продажи живёт в документе, а не в регистре. Он есть только у "товарных"
// документов; у комиссионных отчётов и актов услуг склада нет вовсе, и там значение
// останется пустым - это данные, а не сбой.
//
Функция ВыражениеСклада()

	Выражения = Новый Массив;
	Выражения.Добавить("ВЫРАЗИТЬ(Обороты.ДокументПродажи КАК Документ.РеализацияТоваровУслуг).Склад");
	Выражения.Добавить("ВЫРАЗИТЬ(Обороты.ДокументПродажи КАК Документ.ОтчетОРозничныхПродажах).Склад");

	// У возврата от покупателя склада в шапке НЕТ - он построчный, в табличной части,
	// а регистр продаж строку табличной части не хранит. В шапке есть только СкладОрдер
	// составного типа (приходный ордер ИЛИ склад), и заполняется он лишь при ордерной
	// схеме. Берём его как последнюю попытку: если там ордер, ВЫРАЗИТЬ вернёт NULL,
	// и возврат просто попадёт в строку "(не указано)" - это честнее, чем приписать
	// его чужому складу.
	Выражения.Добавить("ВЫРАЗИТЬ(ВЫРАЗИТЬ(Обороты.ДокументПродажи КАК Документ.ВозвратТоваровОтПокупателя).СкладОрдер"
		+ " КАК Справочник.Склады)");

	Возврат ЦепочкаЕстьNULL(Выражения);

КонецФункции // ВыражениеСклада()

// Продавец: менеджер реализации, а где его нет - ответственный за документ.
// Типы разные (Справочник.Менеджеры и Справочник.Пользователи), поэтому колонка
// получается составной, и наименование в выборке берётся из двух соединений.
//
Функция ВыражениеПродавца()

	Выражения = Новый Массив;
	Выражения.Добавить("ВЫРАЗИТЬ(Обороты.ДокументПродажи КАК Документ.РеализацияТоваровУслуг).Менеджер");

	ИменаДокументов = "РеализацияТоваровУслуг,ОтчетОРозничныхПродажах,ВозвратТоваровОтПокупателя,"
		+ "ОтчетКомиссионераОПродажах,ОтчетКомитентуОПродажах,АктОбОказанииПроизводственныхУслуг,"
		+ "РеализацияУслугПоПереработке";

	Для Каждого ИмяДокумента Из РазделитьСтроку(ИменаДокументов) Цикл
		Выражения.Добавить("ВЫРАЗИТЬ(Обороты.ДокументПродажи КАК Документ." + ИмяДокумента + ").Ответственный");
	КонецЦикла;

	Возврат ЦепочкаЕстьNULL(Выражения);

КонецФункции // ВыражениеПродавца()

// Вложенные ЕСТЬNULL: ЕСТЬNULL(a, ЕСТЬNULL(b, c)).
//
Функция ЦепочкаЕстьNULL(Выражения)

	Индекс = Выражения.ВГраница();
	Результат = Выражения[Индекс];

	Пока Индекс > 0 Цикл
		Индекс = Индекс - 1;
		Результат = "ЕСТЬNULL(" + Выражения[Индекс] + ", " + Результат + ")";
	КонецЦикла;

	Возврат Результат;

КонецФункции // ЦепочкаЕстьNULL()

Функция РазделитьСтроку(Строка)

	Результат = Новый Массив;
	Остаток = Строка;

	Пока Истина Цикл

		Позиция = Найти(Остаток, ",");

		Если Позиция = 0 Тогда
			Прервать;
		КонецЕсли;

		Результат.Добавить(СокрЛП(Лев(Остаток, Позиция - 1)));
		Остаток = Сред(Остаток, Позиция + 1);

	КонецЦикла;

	Если НЕ ПустаяСтрока(Остаток) Тогда
		Результат.Добавить(СокрЛП(Остаток));
	КонецЕсли;

	Возврат Результат;

КонецФункции // РазделитьСтроку()

Процедура ДобавитьПоле(Поля, Группировка, Выражение, Псевдоним)

	Поля.Добавить(Выражение + " КАК " + Псевдоним);
	Группировка.Добавить(Выражение);

КонецПроцедуры // ДобавитьПоле()

// Условие виртуальной таблицы: накопленная строка начинается с " И ", которое
// перед первым условием не нужно.
//
Функция УсловиеВиртуальнойТаблицы(Условия)

	Возврат ?(ПустаяСтрока(Условия), "", ", " + Сред(Условия, 4));

КонецФункции // УсловиеВиртуальнойТаблицы()

// Соответствие внешнего имени измерения полям запроса.
//
Функция ОписаниеИзмеренияПродаж(Измерение)

	Ключи = "Ключ, Ссылка, Имя, Тип, ВыражениеИмени, Соединения";

	Если Измерение = "customer" Тогда
		Возврат ОписаниеСправочника(Ключи, "ПродажиДетали.Контрагент", "Контрагент",
			"Справочник.Контрагенты", "Т_Контрагент");

	ИначеЕсли Измерение = "customer_group" Тогда
		Возврат ОписаниеСправочника(Ключи, "КарточкаКлиента.Родитель", "ГруппаКлиента",
			"Справочник.Контрагенты", "Т_ГруппаКлиента");

	ИначеЕсли Измерение = "product" Тогда
		Возврат ОписаниеСправочника(Ключи, "ПродажиДетали.Номенклатура", "Номенклатура",
			"Справочник.Номенклатура", "Т_Номенклатура");

	ИначеЕсли Измерение = "product_group" Тогда
		Возврат ОписаниеСправочника(Ключи, "КарточкаТовара.Родитель", "ГруппаТовара",
			"Справочник.Номенклатура", "Т_ГруппаТовара");

	ИначеЕсли Измерение = "firm" Тогда
		Возврат ОписаниеСправочника(Ключи, "ПродажиДетали.Организация", "Организация",
			"Справочник.Организации", "Т_Организация");

	ИначеЕсли Измерение = "warehouse" Тогда
		// Склад пустой по двум разным причинам: у части документов реквизит есть, но не
		// заполнен (пустая ссылка), у остальных его нет вовсе и выражение даёт NULL.
		// Для отчёта это одно и то же "склад не указан", поэтому пустую ссылку приводим
		// к NULL - иначе группировка вернула бы ДВЕ строки "(не указано)".
		Возврат ОписаниеСправочника(Ключи,
			БезПустойСсылки("ПродажиДетали.Склад", "Справочник.Склады"), "Склад",
			"Справочник.Склады", "Т_Склад");

	ИначеЕсли Измерение = "seller" Тогда

		Соединения = Новый Массив;
		Соединения.Добавить("ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Менеджеры КАК Т_Менеджер" + Символы.ПС + Символы.Таб
			+ "ПО Т_Менеджер.Ссылка = Свод.Продавец");
		Соединения.Добавить("ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК Т_Пользователь" + Символы.ПС + Символы.Таб
			+ "ПО Т_Пользователь.Ссылка = Свод.Продавец");

		// Продавец составной, и пустых значений у него три вида: пустой менеджер,
		// пустой пользователь и NULL (документ, у которого ни менеджера, ни ответственного
		// нет). Все три - "продавец не указан", и без приведения к NULL отчёт распадался
		// на несколько одинаково подписанных строк "(не указано)".
		Ключ = БезПустойСсылки("ПродажиДетали.Продавец", "Справочник.Менеджеры,Справочник.Пользователи");

		Возврат Новый Структура(Ключи, Ключ, "Продавец", "ПродавецИмя", "ref",
			"ЕСТЬNULL(Т_Менеджер.Наименование, Т_Пользователь.Наименование)", Соединения);

	КонецЕсли;

	// day / week / month - все три приходят из одного поля Период виртуальной таблицы,
	// различаются только периодичностью, с которой она развёрнута.
	Возврат Новый Структура(Ключи, "ПродажиДетали.Период", "Период", "Период", "date", "", Новый Массив);

КонецФункции // ОписаниеИзмеренияПродаж()

// Пустую ссылку превращает в NULL: ВЫБОР КОГДА <выражение> = ЗНАЧЕНИЕ(...ПустаяСсылка)
// ТОГДА NULL ИНАЧЕ <выражение> КОНЕЦ. Нужно там, где одно и то же "не указано"
// приходит и пустой ссылкой, и NULL: сгруппировались бы они в разные строки.
// ИменаСправочников - список через запятую (для составных полей).
//
Функция БезПустойСсылки(Выражение, ИменаСправочников)

	Условия = Новый Массив;

	Для Каждого ИмяСправочника Из РазделитьСтроку(ИменаСправочников) Цикл
		Условия.Добавить(Выражение + " = ЗНАЧЕНИЕ(" + ИмяСправочника + ".ПустаяСсылка)");
	КонецЦикла;

	Возврат "ВЫБОР КОГДА " + Соединить(Условия, Символы.ПС + Символы.Таб + Символы.Таб + "ИЛИ ")
		+ Символы.ПС + Символы.Таб + "ТОГДА NULL ИНАЧЕ " + Выражение + " КОНЕЦ";

КонецФункции // БезПустойСсылки()

Функция ОписаниеСправочника(Ключи, Ключ, Псевдоним, ИмяСправочника, ПсевдонимТаблицы)

	Соединения = Новый Массив;
	Соединения.Добавить("ЛЕВОЕ СОЕДИНЕНИЕ " + ИмяСправочника + " КАК " + ПсевдонимТаблицы + Символы.ПС + Символы.Таб
		+ "ПО " + ПсевдонимТаблицы + ".Ссылка = Свод." + Псевдоним);

	Возврат Новый Структура(Ключи, Ключ, Псевдоним, Псевдоним + "Имя", "ref",
		ПсевдонимТаблицы + ".Наименование", Соединения);

КонецФункции // ОписаниеСправочника()


// Измерения отчёта. Пустой group_by = склад + контрагент (умолчание контракта).
//
Функция ИзмеренияПродаж(Параметры)

	Допустимые = "customer,customer_group,product,product_group,firm,warehouse,seller,day,week,month";

	Результат = Новый Массив;
	ВременныхИзмерений = 0;

	Для Каждого Измерение Из MCP_Утилиты.ВМассивСтрок(MCP_Утилиты.Значение(Параметры, "group_by")) Цикл

		Имя = НРег(СокрЛП(Измерение));

		// В УПП нет справочника каналов продаж (решение §4 плана: resolve_channel -
		// заглушка). Группировка по несуществующему измерению - явная ошибка, а не пустая
		// колонка: иначе модель решит, что канал у всех продаж один.
		Если Имя = "sales_channel" Тогда
			ВызватьИсключение ОшибкаЗапроса(
				"group_by sales_channel is not available: this database has no sales channel catalog");
		КонецЕсли;

		// Когорта опирается на дату создания контрагента, а такого реквизита
		// у Справочник.Контрагенты в этой конфигурации нет.
		Если Имя = "cohort" Тогда
			ВызватьИсключение ОшибкаЗапроса(
				"group_by cohort is not available: Контрагенты has no creation date in this database");
		КонецЕсли;

		Если Найти("," + Допустимые + ",", "," + Имя + ",") = 0 Тогда
			ВызватьИсключение ОшибкаЗапроса("group_by: unsupported dimension " + Измерение);
		КонецЕсли;

		Если Имя = "day" ИЛИ Имя = "week" ИЛИ Имя = "month" Тогда
			ВременныхИзмерений = ВременныхИзмерений + 1;
		КонецЕсли;

		Если Результат.Найти(Имя) = Неопределено Тогда
			Результат.Добавить(Имя);
		КонецЕсли;

	КонецЦикла;

	// Две шкалы времени сразу регистр развернуть не может: периодичность у виртуальной
	// таблицы одна.
	Если ВременныхИзмерений > 1 Тогда
		ВызватьИсключение ОшибкаЗапроса("group_by: only one of day / week / month at a time");
	КонецЕсли;

	Если Результат.Количество() = 0 Тогда
		Результат.Добавить("warehouse");
		Результат.Добавить("customer");
		Возврат Результат;
	КонецЕсли;

	УбратьИзбыточнуюГруппу(Результат, "product", "product_group");
	УбратьИзбыточнуюГруппу(Результат, "customer", "customer_group");

	Возврат Результат;

КонецФункции // ИзмеренияПродаж()

// Лист и его группа вместе избыточны: группа однозначно определяется листом.
// Контракт разрешает молча убрать лишнюю колонку.
//
Процедура УбратьИзбыточнуюГруппу(Измерения, Лист, Группа)

	Если Измерения.Найти(Лист) = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Индекс = Измерения.Найти(Группа);

	Если Индекс <> Неопределено Тогда
		Измерения.Удалить(Индекс);
	КонецЕсли;

КонецПроцедуры // УбратьИзбыточнуюГруппу()

// Меры отчёта. Пустой measures = сумма и количество (умолчание контракта).
//
Функция МерыПродаж(Параметры, РазрешенаСтоимость)

	Допустимые = "amount,qty,receipts,avg_check,customers,cost,profit,margin";
	ТребуютСтоимость = "cost,profit,margin";

	Результат = Новый Массив;

	Для Каждого Мера Из MCP_Утилиты.ВМассивСтрок(MCP_Утилиты.Значение(Параметры, "measures")) Цикл

		Имя = НРег(СокрЛП(Мера));

		Если Найти("," + Допустимые + ",", "," + Имя + ",") = 0 Тогда
			ВызватьИсключение ОшибкаЗапроса("measures: unsupported measure " + Мера);
		КонецЕсли;

		Если Найти("," + ТребуютСтоимость + ",", "," + Имя + ",") > 0 И НЕ РазрешенаСтоимость Тогда
			ВызватьИсключение ОшибкаДоступа("measure " + Имя + " requires scope mcp:report:cost");
		КонецЕсли;

		Если Результат.Найти(Имя) = Неопределено Тогда
			Результат.Добавить(Имя);
		КонецЕсли;

	КонецЦикла;

	Если Результат.Количество() = 0 Тогда
		Результат.Добавить("amount");
		Результат.Добавить("qty");
	КонецЕсли;

	Возврат Результат;

КонецФункции // МерыПродаж()

// Период отчёта. Обе границы обязательны: отчёт по оборотам без периода - это либо
// вся история, либо ничего, и оба варианта модель истолкует неверно.
//
Функция ПериодПродаж(Параметры)

	Период = MCP_Утилиты.Значение(Параметры, "period");

	Начало = MCP_JSON.ДатаИзСтроки(MCP_Утилиты.Значение(Период, "from", ""));
	Окончание = MCP_JSON.ДатаИзСтроки(MCP_Утилиты.Значение(Период, "to", ""));

	Если НЕ ЗначениеЗаполнено(Начало) ИЛИ НЕ ЗначениеЗаполнено(Окончание) Тогда
		ВызватьИсключение ОшибкаЗапроса("period.from and period.to are required (YYYY-MM-DD)");
	КонецЕсли;

	Если НачалоДня(Начало) > КонецДня(Окончание) Тогда
		ВызватьИсключение ОшибкаЗапроса("period.from is later than period.to");
	КонецЕсли;

	Возврат Новый Структура("Начало, Окончание", НачалоДня(Начало), КонецДня(Окончание));

КонецФункции // ПериодПродаж()

Функция ПериодичностьПродаж(Измерения)

	Если Измерения.Найти("day") <> Неопределено Тогда
		Возврат "День";
	КонецЕсли;

	Если Измерения.Найти("week") <> Неопределено Тогда
		Возврат "Неделя";
	КонецЕсли;

	Если Измерения.Найти("month") <> Неопределено Тогда
		Возврат "Месяц";
	КонецЕсли;

	Возврат "";

КонецФункции // ПериодичностьПродаж()

// Фильтры общей схемы, которых эта база поддержать не может.
//
Процедура ОтклонитьНеподдержанныеФильтры(Фильтры)

	Если MCP_Утилиты.ВМассивСтрок(MCP_Утилиты.Значение(Фильтры, "sales_channel_ids")).Количество() > 0 Тогда
		ВызватьИсключение ОшибкаЗапроса(
			"sales_channel_ids is not supported: this database has no sales channel catalog");
	КонецЕсли;

	Если MCP_Утилиты.ВМассивСтрок(MCP_Утилиты.Значение(Фильтры, "product_status")).Количество() > 0 Тогда
		ВызватьИсключение ОшибкаЗапроса(
			"product_status is not supported: Номенклатура has no lifecycle status in this database");
	КонецЕсли;

	Если НЕ ПустаяСтрока(СокрЛП(Строка(MCP_Утилиты.Значение(Фильтры, "customer_cohort", "")))) Тогда
		ВызватьИсключение ОшибкаЗапроса(
			"customer_cohort is not supported: Контрагенты has no creation date in this database");
	КонецЕсли;

КонецПроцедуры // ОтклонитьНеподдержанныеФильтры()

// Эхо применённых отборов. Каждый поддержанный фильтр обязан быть здесь: именно по
// этому полю читатель отчёта видит, что выборка действительно сужена. Отсутствие ключа
// products в ответе и было первым признаком того, что product_ids не работает.
//
Функция ПримененныеОтборы(Контрагенты, Склады, Фирмы, Товары)

	Результат = Новый Структура;
	Результат.Вставить("customers", ИдентификаторыСсылок(Контрагенты));
	Результат.Вставить("warehouses", ИдентификаторыСсылок(Склады));
	Результат.Вставить("firms", ИдентификаторыСсылок(Фирмы));
	Результат.Вставить("products", ИдентификаторыСсылок(Товары));

	Возврат Результат;

КонецФункции // ПримененныеОтборы()

Функция ИдентификаторыСсылок(Ссылки)

	Результат = Новый Массив;

	Для Каждого Ссылка Из Ссылки Цикл
		Результат.Добавить(Строка(Ссылка.УникальныйИдентификатор()));
	КонецЦикла;

	Возврат Результат;

КонецФункции // ИдентификаторыСсылок()


// Порядок сортировки. Поля вне выбранных измерений и мер игнорируются - так же,
// как это описано в контракте инструмента.
//
Функция ПорядокПродаж(Измерения, Меры, Сортировка)

	Части = Новый Массив;

	Для Каждого Спецификация Из Сортировка Цикл

		Поле = НРег(СокрЛП(Строка(MCP_Утилиты.Значение(Спецификация, "field", ""))));
		Направление = ?(НРег(СокрЛП(Строка(MCP_Утилиты.Значение(Спецификация, "dir", "asc")))) = "desc",
			" УБЫВ", " ВОЗР");

		Если Измерения.Найти(Поле) <> Неопределено Тогда

			Описание = ОписаниеИзмеренияПродаж(Поле);
			// Дата сортируется по себе, ссылка - по наименованию: порядок ссылок
			// внутренний и для читателя выглядит случайным.
			Части.Добавить(?(Описание.Тип = "date", Описание.Ссылка, Описание.Имя) + Направление);

		ИначеЕсли Меры.Найти(Поле) <> Неопределено Тогда

			Выражение = ВыражениеСортировкиМеры(Поле);

			Если НЕ ПустаяСтрока(Выражение) Тогда
				Части.Добавить(Выражение + Направление);
			КонецЕсли;

		КонецЕсли;

	КонецЦикла;

	Если Части.Количество() > 0 Тогда
		Возврат Соединить(Части, ", ");
	КонецЕсли;

	// По умолчанию сверху самое крупное: спрашивая top, спрашивают лидеров,
	// а не первые строки по алфавиту.
	Если Меры.Найти("amount") <> Неопределено Тогда
		Возврат "Сумма УБЫВ";
	КонецЕсли;

	Если Меры.Найти("qty") <> Неопределено Тогда
		Возврат "Количество УБЫВ";
	КонецЕсли;

	Если Измерения.Количество() = 0 Тогда
		Возврат "Сумма УБЫВ";
	КонецЕсли;

	Описание = ОписаниеИзмеренияПродаж(Измерения[0]);

	Возврат ?(Описание.Тип = "date", Описание.Ссылка, Описание.Имя);

КонецФункции // ПорядокПродаж()

// Меры, которые считаются делением (avg_check, margin), в СУБД не сортируются:
// делитель бывает нулевым. Их спецификации сортировки игнорируются.
//
Функция ВыражениеСортировкиМеры(Мера)

	Если Мера = "amount" Тогда
		Возврат "Сумма";
	ИначеЕсли Мера = "qty" Тогда
		Возврат "Количество";
	ИначеЕсли Мера = "receipts" Тогда
		Возврат "Чеки";
	ИначеЕсли Мера = "customers" Тогда
		Возврат "Клиенты";
	ИначеЕсли Мера = "cost" Тогда
		Возврат "Себестоимость";
	ИначеЕсли Мера = "profit" Тогда
		Возврат "Сумма - Себестоимость";
	КонецЕсли;

	Возврат "";

КонецФункции // ВыражениеСортировкиМеры()

// Сборка ответа контракта.
//
Функция РезультатПродаж(РезультатДеталей, РезультатИтогов, Измерения, Меры)

	Колонки = Новый Массив;

	Для Каждого Измерение Из Измерения Цикл
		Описание = ОписаниеИзмеренияПродаж(Измерение);
		Колонка = Новый Структура;
		Колонка.Вставить("name", Измерение);
		Колонка.Вставить("type", Описание.Тип);
		Колонки.Добавить(Колонка);
	КонецЦикла;

	Для Каждого Мера Из Меры Цикл
		Колонка = Новый Структура;
		Колонка.Вставить("name", Мера);
		Колонка.Вставить("type", "number");
		Колонки.Добавить(Колонка);
	КонецЦикла;

	Строки = Новый Массив;

	Выборка = РезультатДеталей.Выбрать();

	Пока Выборка.Следующий() Цикл

		Строка = Новый Массив;

		Для Каждого Измерение Из Измерения Цикл

			Описание = ОписаниеИзмеренияПродаж(Измерение);

			Если Описание.Тип = "date" Тогда
				Строка.Добавить(MCP_JSON.ДатаВСтрокуКоротко(Выборка[Описание.Ссылка]));
			Иначе
				Строка.Добавить(ЯчейкаСсылки(Выборка[Описание.Ссылка], Выборка[Описание.Имя]));
			КонецЕсли;

		КонецЦикла;

		Для Каждого Мера Из Меры Цикл
			Строка.Добавить(ЗначениеМерыПродаж(Выборка, Мера));
		КонецЦикла;

		Строки.Добавить(Строка);

	КонецЦикла;

	Итоги = Новый Структура;

	ВыборкаИтогов = РезультатИтогов.Выбрать();

	Если ВыборкаИтогов.Следующий() Тогда
		Для Каждого Мера Из Меры Цикл
			Итоги.Вставить(Мера, ЗначениеМерыПродаж(ВыборкаИтогов, Мера));
		КонецЦикла;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("columns", Колонки);
	Результат.Вставить("rows", Строки);
	Результат.Вставить("totals", Итоги);

	Возврат Результат;

КонецФункции // РезультатПродаж()

// Значение меры из строки выборки. Производные меры считаются здесь, а не в запросе:
// делить на ноль в СУБД нельзя, а пустая выборка по клиенту - обычное дело.
//
Функция ЗначениеМерыПродаж(Выборка, Мера)

	Сумма = MCP_Утилиты.ВЧисло(Выборка.Сумма);
	Себестоимость = MCP_Утилиты.ВЧисло(Выборка.Себестоимость);
	Чеки = MCP_Утилиты.ВЧисло(Выборка.Чеки);

	Если Мера = "amount" Тогда
		Возврат Сумма;

	ИначеЕсли Мера = "qty" Тогда
		Возврат MCP_Утилиты.ВЧисло(Выборка.Количество);

	ИначеЕсли Мера = "receipts" Тогда
		Возврат Чеки;

	ИначеЕсли Мера = "customers" Тогда
		Возврат MCP_Утилиты.ВЧисло(Выборка.Клиенты);

	ИначеЕсли Мера = "avg_check" Тогда
		Возврат ?(Чеки = 0, 0, Окр(Сумма / Чеки, 2));

	ИначеЕсли Мера = "cost" Тогда
		Возврат Себестоимость;

	ИначеЕсли Мера = "profit" Тогда
		Возврат Сумма - Себестоимость;

	ИначеЕсли Мера = "margin" Тогда
		Возврат ?(Сумма = 0, 0, Окр((Сумма - Себестоимость) / Сумма * 100, 2));

	КонецЕсли;

	Возврат 0;

КонецФункции // ЗначениеМерыПродаж()

#EndRegion

#Region Деньги

// Отчёты cash_balance / cash_flow / receivables / payables.
//
// Контур - управленческий, тот же, что в остатках и продажах. Практическое следствие:
// суммы берутся из ресурсов СуммаУпр, а не Сумма/СуммаВзаиморасчетов. Причина не в
// предпочтениях, а в валюте: Сумма у денег - это сумма в валюте счёта, а
// СуммаВзаиморасчетов - в валюте договора. Складывать их между собой нельзя, итог по
// отчёту получился бы бессмысленным. СуммаУпр пересчитана в валюту управленческого
// учёта (см. УправлениеДенежнымиСредствами:3669) и суммируется корректно.
//
// Источники:
//  cash_balance - РегистрНакопления.ДенежныеСредства (остаточный). Измерение
//                 БанковскийСчетКасса СОСТАВНОЕ: касса ИЛИ банковский счёт, поэтому
//                 измерение cash покрывает и то и другое, а резолвер ищет по двум
//                 справочникам сразу.
//  cash_flow    - РегистрНакопления.ДвиженияДенежныхСредств (оборотный). Направление
//                 хранится измерением ПриходРасход, а не знаком суммы, поэтому inflow
//                 и outflow раскладываются по этому измерению и оба положительные.
//  receivables  - РегистрНакопления.ВзаиморасчетыСКонтрагентами (остаточный).
//  payables       Знак сальдо: ПЛЮС = контрагент должен нам, МИНУС = мы должны ему
//                 (проверено по проведению ПКО/РКО, УправлениеДенежнымиСредствами:4351
//                 и :5059 - оплата поставщику идёт приходом, оплата от покупателя
//                 расходом).
//
Функция ОстаткиДенег(Параметры)

	Фильтры = MCP_Утилиты.Значение(Параметры, "filters");

	Измерения = ИзмеренияДенег(Параметры);

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Граница", ГраницаОстатков(Параметры));

	// Отборы уходят в параметры виртуальной таблицы, а не в ГДЕ: иначе платформа сначала
	// свернёт остатки по всему регистру и отфильтрует уже посчитанный результат.
	Условия = "";

	Счета = ДенежныеСчетаФильтра(Фильтры);

	Если Счета.Количество() > 0 Тогда
		Условия = Условия + " И БанковскийСчетКасса В (&Счета)";
		Запрос.УстановитьПараметр("Счета", Счета);
	КонецЕсли;

	// В отличие от остатков товаров, здесь измерение Организация в регистре ЕСТЬ,
	// поэтому firm_ids поддержан по-настоящему. Ограничение доступа по организациям
	// с учётной записи по-прежнему не применяется - решение заказчика от 2026-08-28,
	// см. комментарий в ПроверитьДоступностьФирм.
	Фирмы = СсылкиФильтра(Фильтры, "firm_ids", Справочники.Организации, "Справочник.Организации");

	Если Фирмы.Количество() > 0 Тогда
		Условия = Условия + " И Организация В (&Фирмы)";
		Запрос.УстановитьПараметр("Фирмы", Фирмы);
	КонецЕсли;

	Запрос.Текст = ТекстЗапросаОстатковДенег(Измерения, Условия, ЛимитСтрок(Параметры),
		СпецификацииСортировки(Параметры));

	Пакет = Запрос.ВыполнитьПакет();

	Возврат РезультатОстатковДенег(Пакет[Пакет.ВГраница() - 1], Пакет[Пакет.ВГраница()], Измерения);

КонецФункции // ОстаткиДенег()

// Текст пакета: детали остатков -> свод -> выборка с наименованиями -> итог.
//
Функция ТекстЗапросаОстатковДенег(Измерения, Условия, Лимит, Сортировка)

	Текст =
	"ВЫБРАТЬ
	|	Остатки.БанковскийСчетКасса КАК Счет,
	|	Остатки.Организация КАК Организация,
	|	Остатки.СуммаУпрОстаток КАК Сумма,
	|	Остатки.СуммаОстаток КАК СуммаСчета
	|ПОМЕСТИТЬ ДеньгиДетали
	|ИЗ
	|	РегистрНакопления.ДенежныеСредства.Остатки(&Граница" + УсловиеВиртуальнойТаблицы(Условия) + ") КАК Остатки
	|ИНДЕКСИРОВАТЬ ПО
	|	Счет,
	|	Организация";

	ПоляСвода = Новый Массив;
	ГруппировкаСвода = Новый Массив;
	ПоляИндекса = Новый Массив;

	Для Каждого Измерение Из Измерения Цикл
		Описание = ОписаниеИзмеренияДенег(Измерение);
		ПоляСвода.Добавить(Описание.Ключ + " КАК " + Описание.Ссылка);
		ГруппировкаСвода.Добавить(Описание.Ключ);
		ПоляИндекса.Добавить(Описание.Ссылка);
	КонецЦикла;

	ПоляСвода.Добавить("СУММА(ДеньгиДетали.Сумма) КАК Сумма");
	ПоляСвода.Добавить("СУММА(ДеньгиДетали.СуммаСчета) КАК СуммаСчета");

	Текст = Текст + ";" + Символы.ПС + Символы.ПС + "ВЫБРАТЬ" + Символы.ПС + Символы.Таб
		+ Соединить(ПоляСвода, "," + Символы.ПС + Символы.Таб) + Символы.ПС
		+ "ПОМЕСТИТЬ СводДенег" + Символы.ПС
		+ "ИЗ" + Символы.ПС + Символы.Таб + "ДеньгиДетали КАК ДеньгиДетали" + Символы.ПС
		+ "СГРУППИРОВАТЬ ПО" + Символы.ПС + Символы.Таб
		+ Соединить(ГруппировкаСвода, "," + Символы.ПС + Символы.Таб) + Символы.ПС
		+ "ИНДЕКСИРОВАТЬ ПО" + Символы.ПС + Символы.Таб
		+ Соединить(ПоляИндекса, "," + Символы.ПС + Символы.Таб);

	ПоляВыбора = Новый Массив;
	Соединения = Новый Массив;
	НуженСчет = (Измерения.Найти("cash") <> Неопределено);

	Для Каждого Измерение Из Измерения Цикл

		Описание = ОписаниеИзмеренияДенег(Измерение);

		ПоляВыбора.Добавить("Свод." + Описание.Ссылка + " КАК " + Описание.Ссылка);
		ПоляВыбора.Добавить(Описание.ВыражениеИмени + " КАК " +Описание.Имя);

		Для Каждого Соединение Из Описание.Соединения Цикл
			Соединения.Добавить(Соединение);
		КонецЦикла;

	КонецЦикла;

	Если НуженСчет Тогда

		// Валюта счёта отдаётся отдельной колонкой не для красоты: balance приведён
		// к управленческой валюте, и без указания собственной валюты остаток валютного
		// счёта прочитался бы как гривневый.
		ПоляВыбора.Добавить("ЕСТЬNULL(Т_Касса.ВалютаДенежныхСредств, Т_Счет.ВалютаДенежныхСредств) КАК Валюта");
		ПоляВыбора.Добавить("ЕСТЬNULL(Т_ВалютаКассы.Наименование, Т_ВалютаСчета.Наименование) КАК ВалютаИмя");

		Соединения.Добавить("ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Валюты КАК Т_ВалютаКассы" + Символы.ПС + Символы.Таб
			+ "ПО Т_ВалютаКассы.Ссылка = Т_Касса.ВалютаДенежныхСредств");
		Соединения.Добавить("ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Валюты КАК Т_ВалютаСчета" + Символы.ПС + Символы.Таб
			+ "ПО Т_ВалютаСчета.Ссылка = Т_Счет.ВалютаДенежныхСредств");

	КонецЕсли;

	ПоляВыбора.Добавить("Свод.Сумма КАК Сумма");
	ПоляВыбора.Добавить("Свод.СуммаСчета КАК СуммаСчета");

	Текст = Текст + ";" + Символы.ПС + Символы.ПС
		+ "ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит, "ЧГ=0") + Символы.ПС + Символы.Таб
		+ Соединить(ПоляВыбора, "," + Символы.ПС + Символы.Таб) + Символы.ПС
		+ "ИЗ" + Символы.ПС + Символы.Таб + "СводДенег КАК Свод";

	Если Соединения.Количество() > 0 Тогда
		Текст = Текст + Символы.ПС + Символы.Таб + Соединить(Соединения, Символы.ПС + Символы.Таб);
	КонецЕсли;

	Текст = Текст + Символы.ПС + "УПОРЯДОЧИТЬ ПО" + Символы.ПС + Символы.Таб
		+ ПорядокОстатковДенег(Измерения, Сортировка);

	// Итог считаем по деталям: сумма строк свода дала бы то же число, но по деталям
	// он не зависит от того, сколько строк уместилось в ПЕРВЫЕ N.
	Возврат Текст + ";" + Символы.ПС + Символы.ПС +
	"ВЫБРАТЬ
	|	СУММА(ДеньгиДетали.Сумма) КАК Сумма
	|ИЗ
	|	ДеньгиДетали КАК ДеньгиДетали";

КонецФункции // ТекстЗапросаОстатковДенег()

Функция РезультатОстатковДенег(РезультатДеталей, РезультатИтогов, Измерения)

	НуженСчет = (Измерения.Найти("cash") <> Неопределено);

	Колонки = Новый Массив;

	Для Каждого Измерение Из Измерения Цикл
		Колонки.Добавить(ОписаниеКолонки(Измерение, "ref"));
	КонецЦикла;

	Если НуженСчет Тогда
		Колонки.Добавить(ОписаниеКолонки("currency", "ref"));
	КонецЕсли;

	Колонки.Добавить(ОписаниеКолонки("balance", "number"));

	Если НуженСчет Тогда
		Колонки.Добавить(ОписаниеКолонки("balance_own", "number"));
	КонецЕсли;

	Строки = Новый Массив;

	Выборка = РезультатДеталей.Выбрать();

	Пока Выборка.Следующий() Цикл

		Строка = Новый Массив;

		Для Каждого Измерение Из Измерения Цикл
			Описание = ОписаниеИзмеренияДенег(Измерение);
			Строка.Добавить(ЯчейкаСсылки(Выборка[Описание.Ссылка], Выборка[Описание.Имя]));
		КонецЦикла;

		Если НуженСчет Тогда
			Строка.Добавить(ЯчейкаСсылки(Выборка.Валюта, Выборка.ВалютаИмя));
		КонецЕсли;

		Строка.Добавить(MCP_Утилиты.ВЧисло(Выборка.Сумма));

		Если НуженСчет Тогда
			Строка.Добавить(MCP_Утилиты.ВЧисло(Выборка.СуммаСчета));
		КонецЕсли;

		Строки.Добавить(Строка);

	КонецЦикла;

	Итоги = Новый Структура;

	ВыборкаИтогов = РезультатИтогов.Выбрать();

	Если ВыборкаИтогов.Следующий() Тогда
		Итоги.Вставить("balance", MCP_Утилиты.ВЧисло(ВыборкаИтогов.Сумма));
	КонецЕсли;

	// balance_own в итоги СОЗНАТЕЛЬНО не попадает: это суммы в разных валютах,
	// их сложение дало бы число, не означающее ничего.
	Результат = Новый Структура;
	Результат.Вставить("columns", Колонки);
	Результат.Вставить("rows", Строки);
	Результат.Вставить("totals", Итоги);

	Возврат Результат;

КонецФункции // РезультатОстатковДенег()

Функция ИзмеренияДенег(Параметры)

	Результат = Новый Массив;

	Для Каждого Измерение Из MCP_Утилиты.ВМассивСтрок(MCP_Утилиты.Значение(Параметры, "group_by")) Цикл

		Имя = НРег(СокрЛП(Измерение));

		Если Имя <> "cash" И Имя <> "firm" Тогда
			ВызватьИсключение ОшибкаЗапроса("group_by: unsupported dimension " + Измерение);
		КонецЕсли;

		Если Результат.Найти(Имя) = Неопределено Тогда
			Результат.Добавить(Имя);
		КонецЕсли;

	КонецЦикла;

	Если Результат.Количество() = 0 Тогда
		Результат.Добавить("cash");
	КонецЕсли;

	Возврат Результат;

КонецФункции // ИзмеренияДенег()

Функция ОписаниеИзмеренияДенег(Измерение)

	Ключи = "Ключ, Ссылка, Имя, ВыражениеИмени, ВыражениеВида, Соединения";

	Если Измерение = "firm" Тогда
		Возврат ОписаниеСправочникаДенег(Ключи,
			БезПустойСсылки("ДеньгиДетали.Организация", "Справочник.Организации"),
			"Организация", "Справочник.Организации", "Т_Организация");
	КонецЕсли;

	// cash: измерение составное (касса ИЛИ банковский счёт), поэтому наименование
	// собирается из двух соединений, а пустая ссылка приводится к NULL по обоим
	// справочникам - иначе "(не указано)" разъехалось бы на две строки.
	Соединения = Новый Массив;
	Соединения.Добавить("ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Кассы КАК Т_Касса" + Символы.ПС + Символы.Таб
		+ "ПО Т_Касса.Ссылка = Свод.Счет");
	Соединения.Добавить("ЛЕВОЕ СОЕДИНЕНИЕ Справочник.БанковскиеСчета КАК Т_Счет" + Символы.ПС + Символы.Таб
		+ "ПО Т_Счет.Ссылка = Свод.Счет");

	Возврат Новый Структура(Ключи,
		БезПустойСсылки("ДеньгиДетали.Счет", "Справочник.Кассы,Справочник.БанковскиеСчета"),
		"Счет", "СчетИмя", "ЕСТЬNULL(Т_Касса.Наименование, Т_Счет.Наименование)", "", Соединения);

КонецФункции // ОписаниеИзмеренияДенег()

Функция ПорядокОстатковДенег(Измерения, Сортировка)

	Для Каждого Спецификация Из Сортировка Цикл

		Поле = НРег(СокрЛП(Строка(MCP_Утилиты.Значение(Спецификация, "field", ""))));
		Направление = ?(НРег(СокрЛП(Строка(MCP_Утилиты.Значение(Спецификация, "dir", "asc")))) = "desc",
			" УБЫВ", " ВОЗР");

		Если Поле = "balance" Тогда
			Возврат "Сумма" + Направление;
		КонецЕсли;

		Если Измерения.Найти(Поле) <> Неопределено Тогда
			Возврат ОписаниеИзмеренияДенег(Поле).Имя + Направление;
		КонецЕсли;

	КонецЦикла;

	// По умолчанию сверху самое крупное. Остаток бывает отрицательным (овердрафт,
	// ошибка ввода), и такие строки уходят вниз - но не пропадают.
	Возврат "Сумма УБЫВ";

КонецФункции // ПорядокОстатковДенег()

// Отчёт cash_flow - обороты денег за период.
//
Функция ДвижениеДенег(Параметры)

	Фильтры = MCP_Утилиты.Значение(Параметры, "filters");

	// Статей ЗАТРАТ в регистре движения денег нет вообще: денежные обороты в УПП
	// разрезаются статьями ДДС (справочник СтатьиДвиженияДенежныхСредств), а
	// СтатьиЗатрат живут в затратных регистрах. Молча проигнорировать фильтр нельзя -
	// модель решила бы, что цифры уже сужены до нужной статьи.
	Если MCP_Утилиты.ВМассивСтрок(MCP_Утилиты.Значение(Фильтры, "cost_article_ids")).Количество() > 0 Тогда
		ВызватьИсключение ОшибкаЗапроса(
			"cost_article_ids is not supported: cash movements in this database are analysed"
			+ " by статьи ДДС, not by статьи затрат - use operation_ids instead");
	КонецЕсли;

	Измерения = ИзмеренияДвижения(Параметры);
	Меры = МерыДвижения(Параметры);
	Период = ПериодПродаж(Параметры);

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("НачалоПериода", Период.Начало);
	Запрос.УстановитьПараметр("ОкончаниеПериода", Период.Окончание);
	Запрос.УстановитьПараметр("Приход", Перечисления.ВидыДвиженийПриходРасход.Приход);
	Запрос.УстановитьПараметр("Расход", Перечисления.ВидыДвиженийПриходРасход.Расход);

	Условия = "";

	Счета = ДенежныеСчетаФильтра(Фильтры);

	Если Счета.Количество() > 0 Тогда
		Условия = Условия + " И БанковскийСчетКасса В (&Счета)";
		Запрос.УстановитьПараметр("Счета", Счета);
	КонецЕсли;

	Статьи = СсылкиФильтра(Фильтры, "operation_ids", Справочники.СтатьиДвиженияДенежныхСредств,
		"Справочник.СтатьиДвиженияДенежныхСредств");

	Если Статьи.Количество() > 0 Тогда
		// В ИЕРАРХИИ - справочник статей ДДС иерархический, и id папки должен работать
		// как отбор по всей папке.
		Условия = Условия + " И СтатьяДвиженияДенежныхСредств В ИЕРАРХИИ (&Статьи)";
		Запрос.УстановитьПараметр("Статьи", Статьи);
	КонецЕсли;

	Контрагенты = СсылкиФильтра(Фильтры, "customer_ids", Справочники.Контрагенты, "Справочник.Контрагенты");

	Если Контрагенты.Количество() > 0 Тогда
		Условия = Условия + " И Контрагент В ИЕРАРХИИ (&Контрагенты)";
		Запрос.УстановитьПараметр("Контрагенты", Контрагенты);
	КонецЕсли;

	Фирмы = СсылкиФильтра(Фильтры, "firm_ids", Справочники.Организации, "Справочник.Организации");

	Если Фирмы.Количество() > 0 Тогда
		Условия = Условия + " И Организация В (&Фирмы)";
		Запрос.УстановитьПараметр("Фирмы", Фирмы);
	КонецЕсли;

	Настройки = Новый Структура("Измерения, Меры, Условия, Лимит, Сортировка");
	Настройки.Измерения = Измерения;
	Настройки.Меры = Меры;
	Настройки.Условия = Условия;
	Настройки.Лимит = ЛимитСтрок(Параметры);
	Настройки.Сортировка = СпецификацииСортировки(Параметры);

	Запрос.Текст = ТекстЗапросаДвижения(Настройки);

	Пакет = Запрос.ВыполнитьПакет();

	Результат = РезультатДвижения(Пакет[Пакет.ВГраница() - 1], Пакет[Пакет.ВГраница()], Измерения, Меры);

	Результат.Вставить("period", Новый Структура("from, to",
		MCP_JSON.ДатаВСтрокуКоротко(Период.Начало), MCP_JSON.ДатаВСтрокуКоротко(Период.Окончание)));

	Возврат Результат;

КонецФункции // ДвижениеДенег()

Функция ТекстЗапросаДвижения(Настройки)

	Измерения = Настройки.Измерения;

	ПоляДеталей = Новый Массив;
	ГруппировкаДеталей = Новый Массив;

	Если Измерения.Найти("account") <> Неопределено Тогда
		ДобавитьПоле(ПоляДеталей, ГруппировкаДеталей, "Обороты.БанковскийСчетКасса", "Счет");
	КонецЕсли;

	Если Измерения.Найти("operation") <> Неопределено Тогда
		ДобавитьПоле(ПоляДеталей, ГруппировкаДеталей, "Обороты.СтатьяДвиженияДенежныхСредств", "Статья");
	КонецЕсли;

	Если Измерения.Найти("analytics") <> Неопределено Тогда
		ДобавитьПоле(ПоляДеталей, ГруппировкаДеталей, "Обороты.Контрагент", "Аналитика");
	КонецЕсли;

	Если Измерения.Найти("firm") <> Неопределено Тогда
		ДобавитьПоле(ПоляДеталей, ГруппировкаДеталей, "Обороты.Организация", "Организация");
	КонецЕсли;

	Периодичность = ПериодичностьПродаж(Измерения);

	Если НЕ ПустаяСтрока(Периодичность) Тогда
		ДобавитьПоле(ПоляДеталей, ГруппировкаДеталей, "Обороты.Период", "Период");
	КонецЕсли;

	// Направление движения хранится ИЗМЕРЕНИЕМ, а не знаком суммы, поэтому оно обязано
	// попасть в детали: без него приход и расход сложились бы в одну сумму.
	ДобавитьПоле(ПоляДеталей, ГруппировкаДеталей, "Обороты.ПриходРасход", "ПриходРасход");

	ПоляДеталей.Добавить("СУММА(Обороты.СуммаУпрОборот) КАК Сумма");

	Текст = "ВЫБРАТЬ" + Символы.ПС + Символы.Таб
		+ Соединить(ПоляДеталей, "," + Символы.ПС + Символы.Таб) + Символы.ПС
		+ "ПОМЕСТИТЬ ДвиженияДетали" + Символы.ПС
		+ "ИЗ" + Символы.ПС + Символы.Таб
		+ "РегистрНакопления.ДвиженияДенежныхСредств.Обороты(&НачалоПериода, &ОкончаниеПериода, "
		+ Периодичность + УсловиеВиртуальнойТаблицы(Настройки.Условия) + ") КАК Обороты" + Символы.ПС
		+ "СГРУППИРОВАТЬ ПО" + Символы.ПС + Символы.Таб
		+ Соединить(ГруппировкаДеталей, "," + Символы.ПС + Символы.Таб);

	ПоляСвода = Новый Массив;
	ГруппировкаСвода = Новый Массив;
	ПоляИндекса = Новый Массив;

	Для Каждого Измерение Из Измерения Цикл

		Описание = ОписаниеИзмеренияДвижения(Измерение);

		ПоляСвода.Добавить(Описание.Ключ + " КАК " + Описание.Ссылка);
		ГруппировкаСвода.Добавить(Описание.Ключ);

		Если НЕ ПустаяСтрока(Описание.ВыражениеИмени) Тогда
			ПоляИндекса.Добавить(Описание.Ссылка);
		КонецЕсли;

	КонецЦикла;

	ПоляСвода.Добавить(СуммаПоНаправлению("Приход"));
	ПоляСвода.Добавить(СуммаПоНаправлению("Расход"));

	Текст = Текст + ";" + Символы.ПС + Символы.ПС + "ВЫБРАТЬ" + Символы.ПС + Символы.Таб
		+ Соединить(ПоляСвода, "," + Символы.ПС + Символы.Таб) + Символы.ПС
		+ "ПОМЕСТИТЬ СводДвижений" + Символы.ПС
		+ "ИЗ" + Символы.ПС + Символы.Таб + "ДвиженияДетали КАК ДвиженияДетали" + Символы.ПС
		+ "СГРУППИРОВАТЬ ПО" + Символы.ПС + Символы.Таб
		+ Соединить(ГруппировкаСвода, "," + Символы.ПС + Символы.Таб);

	Если ПоляИндекса.Количество() > 0 Тогда
		Текст = Текст + Символы.ПС + "ИНДЕКСИРОВАТЬ ПО" + Символы.ПС + Символы.Таб
			+ Соединить(ПоляИндекса, "," + Символы.ПС + Символы.Таб);
	КонецЕсли;

	ПоляВыбора = Новый Массив;
	Соединения = Новый Массив;

	Для Каждого Измерение Из Измерения Цикл

		Описание = ОписаниеИзмеренияДвижения(Измерение);

		ПоляВыбора.Добавить("Свод." + Описание.Ссылка + " КАК " + Описание.Ссылка);

		Если НЕ ПустаяСтрока(Описание.ВыражениеИмени) Тогда
			ПоляВыбора.Добавить(Описание.ВыражениеИмени + " КАК " + Описание.Имя);
		КонецЕсли;

		Если НЕ ПустаяСтрока(Описание.ВыражениеВида) Тогда
			ПоляВыбора.Добавить(Описание.ВыражениеВида + " КАК " + Описание.Ссылка + "Вид");
		КонецЕсли;

		Для Каждого Соединение Из Описание.Соединения Цикл
			Соединения.Добавить(Соединение);
		КонецЦикла;

	КонецЦикла;

	ПоляВыбора.Добавить("Свод.Приход КАК Приход");
	ПоляВыбора.Добавить("Свод.Расход КАК Расход");

	Текст = Текст + ";" + Символы.ПС + Символы.ПС
		+ "ВЫБРАТЬ ПЕРВЫЕ " + Формат(Настройки.Лимит, "ЧГ=0") + Символы.ПС + Символы.Таб
		+ Соединить(ПоляВыбора, "," + Символы.ПС + Символы.Таб) + Символы.ПС
		+ "ИЗ" + Символы.ПС + Символы.Таб + "СводДвижений КАК Свод";

	Если Соединения.Количество() > 0 Тогда
		Текст = Текст + Символы.ПС + Символы.Таб + Соединить(Соединения, Символы.ПС + Символы.Таб);
	КонецЕсли;

	Текст = Текст + Символы.ПС + "УПОРЯДОЧИТЬ ПО" + Символы.ПС + Символы.Таб
		+ ПорядокДвижения(Измерения, Настройки.Меры, Настройки.Сортировка);

	Возврат Текст + ";" + Символы.ПС + Символы.ПС + "ВЫБРАТЬ" + Символы.ПС + Символы.Таб
		+ СуммаПоНаправлению("Приход") + "," + Символы.ПС + Символы.Таб
		+ СуммаПоНаправлению("Расход") + Символы.ПС
		+ "ИЗ" + Символы.ПС + Символы.Таб + "ДвиженияДетали КАК ДвиженияДетали";

КонецФункции // ТекстЗапросаДвижения()

// Сумма одного направления: приход и расход раскладываются по измерению ПриходРасход
// и оба возвращаются положительными, как этого ждёт контракт (outflow gross positive).
//
Функция СуммаПоНаправлению(Направление)

	Возврат "СУММА(ВЫБОР КОГДА ДвиженияДетали.ПриходРасход = &" + Направление
		+ " ТОГДА ДвиженияДетали.Сумма ИНАЧЕ 0 КОНЕЦ) КАК " + Направление;

КонецФункции // СуммаПоНаправлению()

Функция РезультатДвижения(РезультатДеталей, РезультатИтогов, Измерения, Меры)

	Колонки = Новый Массив;

	Для Каждого Измерение Из Измерения Цикл
		Колонки.Добавить(ОписаниеКолонки(Измерение,
			?(Измерение = "day" ИЛИ Измерение = "week" ИЛИ Измерение = "month", "date", "ref")));
	КонецЦикла;

	Для Каждого Мера Из Меры Цикл
		Колонки.Добавить(ОписаниеКолонки(Мера, "number"));
	КонецЦикла;

	Строки = Новый Массив;

	Выборка = РезультатДеталей.Выбрать();

	Пока Выборка.Следующий() Цикл

		Строка = Новый Массив;

		Для Каждого Измерение Из Измерения Цикл

			Описание = ОписаниеИзмеренияДвижения(Измерение);

			Если ПустаяСтрока(Описание.ВыражениеИмени) Тогда
				Строка.Добавить(MCP_JSON.ДатаВСтрокуКоротко(Выборка[Описание.Ссылка]));

			ИначеЕсли ПустаяСтрока(Описание.ВыражениеВида) Тогда
				Строка.Добавить(ЯчейкаСсылки(Выборка[Описание.Ссылка], Выборка[Описание.Имя]));

			Иначе
				Строка.Добавить(ЯчейкаАналитики(Выборка[Описание.Ссылка], Выборка[Описание.Имя],
					Выборка[Описание.Ссылка + "Вид"]));

			КонецЕсли;

		КонецЦикла;

		Для Каждого Мера Из Меры Цикл
			Строка.Добавить(ЗначениеМерыДвижения(Выборка, Мера));
		КонецЦикла;

		Строки.Добавить(Строка);

	КонецЦикла;

	Итоги = Новый Структура;

	ВыборкаИтогов = РезультатИтогов.Выбрать();

	Если ВыборкаИтогов.Следующий() Тогда
		Для Каждого Мера Из Меры Цикл
			Итоги.Вставить(Мера, ЗначениеМерыДвижения(ВыборкаИтогов, Мера));
		КонецЦикла;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("columns", Колонки);
	Результат.Вставить("rows", Строки);
	Результат.Вставить("totals", Итоги);

	Возврат Результат;

КонецФункции // РезультатДвижения()

Функция ЗначениеМерыДвижения(Выборка, Мера)

	Если Мера = "inflow" Тогда
		Возврат MCP_Утилиты.ВЧисло(Выборка.Приход);
	КонецЕсли;

	Если Мера = "outflow" Тогда
		Возврат MCP_Утилиты.ВЧисло(Выборка.Расход);
	КонецЕсли;

	Возврат MCP_Утилиты.ВЧисло(Выборка.Приход) - MCP_Утилиты.ВЧисло(Выборка.Расход);

КонецФункции // ЗначениеМерыДвижения()

Функция ИзмеренияДвижения(Параметры)

	Допустимые = "account,operation,analytics,firm,day,week,month";

	Результат = Новый Массив;
	ВременныхИзмерений = 0;

	Для Каждого Измерение Из MCP_Утилиты.ВМассивСтрок(MCP_Утилиты.Значение(Параметры, "group_by")) Цикл

		Имя = НРег(СокрЛП(Измерение));

		Если Найти("," + Допустимые + ",", "," + Имя + ",") = 0 Тогда
			ВызватьИсключение ОшибкаЗапроса("group_by: unsupported dimension " + Измерение);
		КонецЕсли;

		Если Имя = "day" ИЛИ Имя = "week" ИЛИ Имя = "month" Тогда
			ВременныхИзмерений = ВременныхИзмерений + 1;
		КонецЕсли;

		Если Результат.Найти(Имя) = Неопределено Тогда
			Результат.Добавить(Имя);
		КонецЕсли;

	КонецЦикла;

	// У виртуальной таблицы периодичность одна: день и месяц сразу не развернуть.
	Если ВременныхИзмерений > 1 Тогда
		ВызватьИсключение ОшибкаЗапроса("group_by: only one of day / week / month can be used at a time");
	КонецЕсли;

	Если Результат.Количество() = 0 Тогда
		Результат.Добавить("operation");
	КонецЕсли;

	Возврат Результат;

КонецФункции // ИзмеренияДвижения()

Функция МерыДвижения(Параметры)

	Допустимые = "inflow,outflow,net";

	Результат = Новый Массив;

	Для Каждого Мера Из MCP_Утилиты.ВМассивСтрок(MCP_Утилиты.Значение(Параметры, "measures")) Цикл

		Имя = НРег(СокрЛП(Мера));

		Если Найти("," + Допустимые + ",", "," + Имя + ",") = 0 Тогда
			ВызватьИсключение ОшибкаЗапроса("measures: unsupported measure " + Мера);
		КонецЕсли;

		Если Результат.Найти(Имя) = Неопределено Тогда
			Результат.Добавить(Имя);
		КонецЕсли;

	КонецЦикла;

	Если Результат.Количество() = 0 Тогда
		Результат.Добавить("inflow");
		Результат.Добавить("outflow");
		Результат.Добавить("net");
	КонецЕсли;

	Возврат Результат;

КонецФункции // МерыДвижения()

Функция ОписаниеИзмеренияДвижения(Измерение)

	Ключи = "Ключ, Ссылка, Имя, ВыражениеИмени, ВыражениеВида, Соединения";

	Если Измерение = "account" Тогда

		Соединения = Новый Массив;
		Соединения.Добавить("ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Кассы КАК Т_Касса" + Символы.ПС + Символы.Таб
			+ "ПО Т_Касса.Ссылка = Свод.Счет");
		Соединения.Добавить("ЛЕВОЕ СОЕДИНЕНИЕ Справочник.БанковскиеСчета КАК Т_Счет" + Символы.ПС + Символы.Таб
			+ "ПО Т_Счет.Ссылка = Свод.Счет");

		Возврат Новый Структура(Ключи,
			БезПустойСсылки("ДвиженияДетали.Счет", "Справочник.Кассы,Справочник.БанковскиеСчета"),
			"Счет", "СчетИмя", "ЕСТЬNULL(Т_Касса.Наименование, Т_Счет.Наименование)", "", Соединения);

	ИначеЕсли Измерение = "operation" Тогда
		Возврат ОписаниеСправочникаДенег(Ключи,
			БезПустойСсылки("ДвиженияДетали.Статья", "Справочник.СтатьиДвиженияДенежныхСредств"),
			"Статья", "Справочник.СтатьиДвиженияДенежныхСредств", "Т_Статья");

	ИначеЕсли Измерение = "firm" Тогда
		Возврат ОписаниеСправочникаДенег(Ключи,
			БезПустойСсылки("ДвиженияДетали.Организация", "Справочник.Организации"),
			"Организация", "Справочник.Организации", "Т_Организация");

	ИначеЕсли Измерение = "analytics" Тогда

		// Аналитика движения денег - составное измерение Контрагент: контрагент,
		// физлицо, своя организация (внутреннее перемещение) или касса ККМ (инкассация).
		// Контракт ждёт от этой колонки {id, label, kind}, поэтому вид считается в
		// запросе - по нему видно, что это за строка, без похода в резолвер.
		Соединения = Новый Массив;
		Соединения.Добавить("ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Т_Контрагент" + Символы.ПС + Символы.Таб
			+ "ПО Т_Контрагент.Ссылка = Свод.Аналитика");
		Соединения.Добавить("ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ФизическиеЛица КАК Т_Физлицо" + Символы.ПС + Символы.Таб
			+ "ПО Т_Физлицо.Ссылка = Свод.Аналитика");
		Соединения.Добавить("ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации КАК Т_Фирма" + Символы.ПС + Символы.Таб
			+ "ПО Т_Фирма.Ссылка = Свод.Аналитика");
		Соединения.Добавить("ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КассыККМ КАК Т_КассаККМ" + Символы.ПС + Символы.Таб
			+ "ПО Т_КассаККМ.Ссылка = Свод.Аналитика");

		ВыражениеИмени = "ЕСТЬNULL(Т_Контрагент.Наименование, ЕСТЬNULL(Т_Физлицо.Наименование,"
			+ " ЕСТЬNULL(Т_Фирма.Наименование, Т_КассаККМ.Наименование)))";

		ВыражениеВида = "ВЫБОР
			|		КОГДА Свод.Аналитика ССЫЛКА Справочник.Контрагенты ТОГДА ""customer""
			|		КОГДА Свод.Аналитика ССЫЛКА Справочник.ФизическиеЛица ТОГДА ""individual""
			|		КОГДА Свод.Аналитика ССЫЛКА Справочник.Организации ТОГДА ""firm""
			|		КОГДА Свод.Аналитика ССЫЛКА Справочник.КассыККМ ТОГДА ""cash_register""
			|		ИНАЧЕ """"
			|	КОНЕЦ";

		Возврат Новый Структура(Ключи,
			БезПустойСсылки("ДвиженияДетали.Аналитика",
				"Справочник.Контрагенты,Справочник.ФизическиеЛица,Справочник.Организации,Справочник.КассыККМ"),
			"Аналитика", "АналитикаИмя", ВыражениеИмени, ВыражениеВида, Соединения);

	КонецЕсли;

	// day / week / month - одно поле Период виртуальной таблицы, разная периодичность.
	// Пустое ВыражениеИмени - признак того, что колонка не ссылочная, а датовая.
	Возврат Новый Структура(Ключи, "ДвиженияДетали.Период", "Период", "Период", "", "", Новый Массив);

КонецФункции // ОписаниеИзмеренияДвижения()

Функция ПорядокДвижения(Измерения, Меры, Сортировка)

	Для Каждого Спецификация Из Сортировка Цикл

		Поле = НРег(СокрЛП(Строка(MCP_Утилиты.Значение(Спецификация, "field", ""))));
		Направление = ?(НРег(СокрЛП(Строка(MCP_Утилиты.Значение(Спецификация, "dir", "asc")))) = "desc",
			" УБЫВ", " ВОЗР");

		Если Меры.Найти(Поле) <> Неопределено Тогда

			Если Поле = "inflow" Тогда
				Возврат "Приход" + Направление;
			ИначеЕсли Поле = "outflow" Тогда
				Возврат "Расход" + Направление;
			КонецЕсли;

			Возврат "Приход - Расход" + Направление;

		КонецЕсли;

		Если Измерения.Найти(Поле) <> Неопределено Тогда

			Описание = ОписаниеИзмеренияДвижения(Поле);

			Возврат ?(ПустаяСтрока(Описание.ВыражениеИмени), Описание.Ссылка, Описание.Имя) + Направление;

		КонецЕсли;

	КонецЦикла;

	// Хронологию по умолчанию не переворачиваем: отчёт по месяцам читается сверху вниз.
	Если ПериодичностьПродаж(Измерения) <> "" Тогда
		Возврат "Период";
	КонецЕсли;

	// Иначе сверху самые крупные движения - по сумме оборота в обе стороны, а не по
	// одному направлению: иначе разрез, где есть только расход, оказался бы отсортирован
	// по нулям.
	Возврат "Приход + Расход УБЫВ";

КонецФункции // ПорядокДвижения()

// Отчёты receivables / payables - развёрнутое сальдо взаиморасчётов на дату.
//
// Роль определяется ВИДОМ ДОГОВОРА (решение заказчика 2026-08-31): дебиторка - договоры
// "с покупателем" и "с комиссионером", кредиторка - "с поставщиком" и "с комитентом".
// Договоры "бартерный", "прочее" и незаполненный договор роли не имеют, поэтому
// попадают туда, куда указывает ЗНАК сальдо: должны нам - в дебиторку, должны мы -
// в кредиторку. Так ни одна сумма не теряется и ни одна не показывается дважды.
//
// Сальдо РАЗВЁРНУТОЕ по ключу регистра (договор + сделка): долг и аванс одного и того же
// контрагента по разным договорам не схлопываются, как и в типовой "Ведомости по
// взаиморасчётам". Свёрнутое сальдо занизило бы и дебиторку, и авансы.
//
Функция Дебиторка(Параметры)

	Возврат Взаиморасчеты(Параметры, "receivables");

КонецФункции // Дебиторка()

Функция Кредиторка(Параметры)

	Возврат Взаиморасчеты(Параметры, "payables");

КонецФункции // Кредиторка()

Функция Взаиморасчеты(Параметры, Роль)

	Фильтры = MCP_Утилиты.Значение(Параметры, "filters");

	Измерения = ИзмеренияВзаиморасчетов(Параметры, Роль);
	Меры = МерыВзаиморасчетов(Параметры, Роль);

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Граница", ГраницаОстатков(Параметры));
	Запрос.УстановитьПараметр("ВидыРоли", ВидыДоговоровРоли(Роль));
	Запрос.УстановитьПараметр("ВидыБезРоли", ВидыДоговоровБезРоли());

	Условия = "";

	// Ключ контрагента назван по роли отчёта - customer_ids у ДЗ, supplier_ids у КЗ,
	// хотя справочник один и тот же.
	КлючКонтрагента = ?(Роль = "receivables", "customer_ids", "supplier_ids");

	Контрагенты = СсылкиФильтра(Фильтры, КлючКонтрагента, Справочники.Контрагенты, "Справочник.Контрагенты");

	Если Контрагенты.Количество() > 0 Тогда
		Условия = Условия + " И Контрагент В ИЕРАРХИИ (&Контрагенты)";
		Запрос.УстановитьПараметр("Контрагенты", Контрагенты);
	КонецЕсли;

	Фирмы = СсылкиФильтра(Фильтры, "firm_ids", Справочники.Организации, "Справочник.Организации");

	Если Фирмы.Количество() > 0 Тогда
		Условия = Условия + " И Организация В (&Фирмы)";
		Запрос.УстановитьПараметр("Фирмы", Фирмы);
	КонецЕсли;

	Запрос.Текст = ТекстЗапросаВзаиморасчетов(Измерения, Роль, Условия, ЛимитСтрок(Параметры),
		СпецификацииСортировки(Параметры));

	Пакет = Запрос.ВыполнитьПакет();

	Возврат РезультатВзаиморасчетов(Пакет[Пакет.ВГраница() - 1], Пакет[Пакет.ВГраница()],
		Измерения, Меры, Роль);

КонецФункции // Взаиморасчеты()

Функция ТекстЗапросаВзаиморасчетов(Измерения, Роль, Условия, Лимит, Сортировка)

	// Знак, по которому в отчёт попадает договор без роли (бартерный, прочее, пустой).
	ЗнакБезРоли = ?(Роль = "receivables", "> 0", "< 0");

	// Виртуальную таблицу сперва материализуем, и только потом соединяем со справочником
	// договоров: соединение НАПРЯМУЮ с виртуальной таблицей заставило бы платформу
	// присоединять справочник к ещё не посчитанным остаткам.
	Текст =
	"ВЫБРАТЬ
	|	Остатки.Контрагент КАК Контрагент,
	|	Остатки.Организация КАК Организация,
	|	Остатки.ДоговорКонтрагента КАК Договор,
	|	Остатки.СуммаУпрОстаток КАК Сальдо
	|ПОМЕСТИТЬ СальдоРасчетов
	|ИЗ
	|	РегистрНакопления.ВзаиморасчетыСКонтрагентами.Остатки(&Граница"
		+ УсловиеВиртуальнойТаблицы(Условия) + ") КАК Остатки
	|ИНДЕКСИРОВАТЬ ПО
	|	Договор";

	// Роль строки - вид договора; договоры без роли (бартерный, прочее, незаполненный)
	// попадают в отчёт по знаку сальдо.
	Текст = Текст + ";" + Символы.ПС + Символы.ПС +
	"ВЫБРАТЬ
	|	Расчеты.Контрагент КАК Контрагент,
	|	Расчеты.Организация КАК Организация,
	|	Расчеты.Сальдо КАК Сальдо
	|ПОМЕСТИТЬ РасчетыДетали
	|ИЗ
	|	СальдоРасчетов КАК Расчеты
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов КАК Договоры
	|		ПО Договоры.Ссылка = Расчеты.Договор
	|ГДЕ
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(Договоры.ВидДоговора, ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.ПустаяСсылка))
	|				В (&ВидыРоли)
	|			ТОГДА ИСТИНА
	|		КОГДА ЕСТЬNULL(Договоры.ВидДоговора, ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.ПустаяСсылка))
	|				В (&ВидыБезРоли)
	|			ТОГДА Расчеты.Сальдо " + ЗнакБезРоли + "
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ
	|ИНДЕКСИРОВАТЬ ПО
	|	Контрагент,
	|	Организация";

	ПоляСвода = Новый Массив;
	ГруппировкаСвода = Новый Массив;
	ПоляИндекса = Новый Массив;

	Для Каждого Измерение Из Измерения Цикл
		Описание = ОписаниеИзмеренияВзаиморасчетов(Измерение);
		ПоляСвода.Добавить(Описание.Ключ + " КАК " + Описание.Ссылка);
		ГруппировкаСвода.Добавить(Описание.Ключ);
		ПоляИндекса.Добавить(Описание.Ссылка);
	КонецЦикла;

	ПоляСвода.Добавить(СуммаПоЗнаку("Дебет"));
	ПоляСвода.Добавить(СуммаПоЗнаку("Кредит"));

	Текст = Текст + ";" + Символы.ПС + Символы.ПС + "ВЫБРАТЬ" + Символы.ПС + Символы.Таб
		+ Соединить(ПоляСвода, "," + Символы.ПС + Символы.Таб) + Символы.ПС
		+ "ПОМЕСТИТЬ СводРасчетов" + Символы.ПС
		+ "ИЗ" + Символы.ПС + Символы.Таб + "РасчетыДетали КАК РасчетыДетали" + Символы.ПС
		+ "СГРУППИРОВАТЬ ПО" + Символы.ПС + Символы.Таб
		+ Соединить(ГруппировкаСвода, "," + Символы.ПС + Символы.Таб) + Символы.ПС
		+ "ИНДЕКСИРОВАТЬ ПО" + Символы.ПС + Символы.Таб
		+ Соединить(ПоляИндекса, "," + Символы.ПС + Символы.Таб);

	ПоляВыбора = Новый Массив;
	Соединения = Новый Массив;

	Для Каждого Измерение Из Измерения Цикл

		Описание = ОписаниеИзмеренияВзаиморасчетов(Измерение);

		ПоляВыбора.Добавить("Свод." + Описание.Ссылка + " КАК " + Описание.Ссылка);
		ПоляВыбора.Добавить(Описание.ВыражениеИмени + " КАК " + Описание.Имя);

		Для Каждого Соединение Из Описание.Соединения Цикл
			Соединения.Добавить(Соединение);
		КонецЦикла;

	КонецЦикла;

	ПоляВыбора.Добавить("Свод.Дебет КАК Дебет");
	ПоляВыбора.Добавить("Свод.Кредит КАК Кредит");

	Текст = Текст + ";" + Символы.ПС + Символы.ПС
		+ "ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит, "ЧГ=0") + Символы.ПС + Символы.Таб
		+ Соединить(ПоляВыбора, "," + Символы.ПС + Символы.Таб) + Символы.ПС
		+ "ИЗ" + Символы.ПС + Символы.Таб + "СводРасчетов КАК Свод" + Символы.ПС + Символы.Таб
		+ Соединить(Соединения, Символы.ПС + Символы.Таб) + Символы.ПС
		+ "УПОРЯДОЧИТЬ ПО" + Символы.ПС + Символы.Таб
		+ ПорядокВзаиморасчетов(Измерения, Роль, Сортировка);

	Возврат Текст + ";" + Символы.ПС + Символы.ПС + "ВЫБРАТЬ" + Символы.ПС + Символы.Таб
		+ СуммаПоЗнаку("Дебет") + "," + Символы.ПС + Символы.Таб
		+ СуммаПоЗнаку("Кредит") + Символы.ПС
		+ "ИЗ" + Символы.ПС + Символы.Таб + "РасчетыДетали КАК РасчетыДетали";

КонецФункции // ТекстЗапросаВзаиморасчетов()

// Развёрнутое сальдо: строки с плюсом дают дебет, строки с минусом - кредит, обе
// колонки положительные.
//
Функция СуммаПоЗнаку(Сторона)

	Если Сторона = "Дебет" Тогда
		Возврат "СУММА(ВЫБОР КОГДА РасчетыДетали.Сальдо > 0 ТОГДА РасчетыДетали.Сальдо ИНАЧЕ 0 КОНЕЦ) КАК Дебет";
	КонецЕсли;

	Возврат "СУММА(ВЫБОР КОГДА РасчетыДетали.Сальдо < 0 ТОГДА -РасчетыДетали.Сальдо ИНАЧЕ 0 КОНЕЦ) КАК Кредит";

КонецФункции // СуммаПоЗнаку()

Функция ВидыДоговоровРоли(Роль)

	Результат = Новый Массив;

	Если Роль = "receivables" Тогда
		Результат.Добавить(Перечисления.ВидыДоговоровКонтрагентов.СПокупателем);
		Результат.Добавить(Перечисления.ВидыДоговоровКонтрагентов.СКомиссионером);
	Иначе
		Результат.Добавить(Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком);
		Результат.Добавить(Перечисления.ВидыДоговоровКонтрагентов.СКомитентом);
	КонецЕсли;

	Возврат Результат;

КонецФункции // ВидыДоговоровРоли()

Функция ВидыДоговоровБезРоли()

	Результат = Новый Массив;
	Результат.Добавить(Перечисления.ВидыДоговоровКонтрагентов.Бартерный);
	Результат.Добавить(Перечисления.ВидыДоговоровКонтрагентов.Прочее);
	Результат.Добавить(Перечисления.ВидыДоговоровКонтрагентов.ПустаяСсылка());

	Возврат Результат;

КонецФункции // ВидыДоговоровБезРоли()

Функция РезультатВзаиморасчетов(РезультатДеталей, РезультатИтогов, Измерения, Меры, Роль)

	Колонки = Новый Массив;

	Для Каждого Измерение Из Измерения Цикл
		Колонки.Добавить(ОписаниеКолонки(Измерение, "ref"));
	КонецЦикла;

	Для Каждого Мера Из Меры Цикл
		Колонки.Добавить(ОписаниеКолонки(Мера, "number"));
	КонецЦикла;

	Строки = Новый Массив;

	Выборка = РезультатДеталей.Выбрать();

	Пока Выборка.Следующий() Цикл

		Строка = Новый Массив;

		Для Каждого Измерение Из Измерения Цикл
			Описание = ОписаниеИзмеренияВзаиморасчетов(Измерение);
			Строка.Добавить(ЯчейкаСсылки(Выборка[Описание.Ссылка], Выборка[Описание.Имя]));
		КонецЦикла;

		Для Каждого Мера Из Меры Цикл
			Строка.Добавить(ЗначениеМерыВзаиморасчетов(Выборка, Мера, Роль));
		КонецЦикла;

		Строки.Добавить(Строка);

	КонецЦикла;

	Итоги = Новый Структура;

	ВыборкаИтогов = РезультатИтогов.Выбрать();

	Если ВыборкаИтогов.Следующий() Тогда
		Для Каждого Мера Из Меры Цикл
			Итоги.Вставить(Мера, ЗначениеМерыВзаиморасчетов(ВыборкаИтогов, Мера, Роль));
		КонецЦикла;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("columns", Колонки);
	Результат.Вставить("rows", Строки);
	Результат.Вставить("totals", Итоги);

	Возврат Результат;

КонецФункции // РезультатВзаиморасчетов()

// Дебет и кредит меняются местами в зависимости от роли отчёта: для дебиторки долг -
// это плюс, для кредиторки - минус. Аванс в обоих случаях противоположная сторона.
//
Функция ЗначениеМерыВзаиморасчетов(Выборка, Мера, Роль)

	Долг = ?(Роль = "receivables", MCP_Утилиты.ВЧисло(Выборка.Дебет), MCP_Утилиты.ВЧисло(Выборка.Кредит));
	Аванс = ?(Роль = "receivables", MCP_Утилиты.ВЧисло(Выборка.Кредит), MCP_Утилиты.ВЧисло(Выборка.Дебет));

	Если Мера = "advance" Тогда
		Возврат Аванс;
	КонецЕсли;

	Если Мера = "net" Тогда
		Возврат Долг - Аванс;
	КонецЕсли;

	Возврат Долг;

КонецФункции // ЗначениеМерыВзаиморасчетов()

Функция ИзмеренияВзаиморасчетов(Параметры, Роль)

	КлючКонтрагента = ?(Роль = "receivables", "customer", "supplier");

	Результат = Новый Массив;

	Для Каждого Измерение Из MCP_Утилиты.ВМассивСтрок(MCP_Утилиты.Значение(Параметры, "group_by")) Цикл

		Имя = НРег(СокрЛП(Измерение));

		Если Имя <> КлючКонтрагента И Имя <> "firm" Тогда
			ВызватьИсключение ОшибкаЗапроса("group_by: unsupported dimension " + Измерение);
		КонецЕсли;

		Если Результат.Найти(Имя) = Неопределено Тогда
			Результат.Добавить(Имя);
		КонецЕсли;

	КонецЦикла;

	Если Результат.Количество() = 0 Тогда
		Результат.Добавить(КлючКонтрагента);
	КонецЕсли;

	Возврат Результат;

КонецФункции // ИзмеренияВзаиморасчетов()

Функция МерыВзаиморасчетов(Параметры, Роль)

	Допустимые = ?(Роль = "receivables", "receivable,advance,net", "payable,advance,net");

	Результат = Новый Массив;

	Для Каждого Мера Из MCP_Утилиты.ВМассивСтрок(MCP_Утилиты.Значение(Параметры, "measures")) Цикл

		Имя = НРег(СокрЛП(Мера));

		Если Найти("," + Допустимые + ",", "," + Имя + ",") = 0 Тогда
			ВызватьИсключение ОшибкаЗапроса("measures: unsupported measure " + Мера);
		КонецЕсли;

		Если Результат.Найти(Имя) = Неопределено Тогда
			Результат.Добавить(Имя);
		КонецЕсли;

	КонецЦикла;

	Если Результат.Количество() = 0 Тогда
		Результат.Добавить(?(Роль = "receivables", "receivable", "payable"));
		Результат.Добавить("advance");
		Результат.Добавить("net");
	КонецЕсли;

	Возврат Результат;

КонецФункции // МерыВзаиморасчетов()

Функция ОписаниеИзмеренияВзаиморасчетов(Измерение)

	Ключи = "Ключ, Ссылка, Имя, ВыражениеИмени, ВыражениеВида, Соединения";

	Если Измерение = "firm" Тогда
		Возврат ОписаниеСправочникаДенег(Ключи,
			БезПустойСсылки("РасчетыДетали.Организация", "Справочник.Организации"),
			"Организация", "Справочник.Организации", "Т_Организация");
	КонецЕсли;

	// customer и supplier - одно и то же измерение Контрагент, разные только имена
	// колонки в контракте.
	Возврат ОписаниеСправочникаДенег(Ключи,
		БезПустойСсылки("РасчетыДетали.Контрагент", "Справочник.Контрагенты"),
		"Контрагент", "Справочник.Контрагенты", "Т_Контрагент");

КонецФункции // ОписаниеИзмеренияВзаиморасчетов()

Функция ПорядокВзаиморасчетов(Измерения, Роль, Сортировка)

	ОсновнаяСторона = ?(Роль = "receivables", "Дебет", "Кредит");
	ОбратнаяСторона = ?(Роль = "receivables", "Кредит", "Дебет");

	Для Каждого Спецификация Из Сортировка Цикл

		Поле = НРег(СокрЛП(Строка(MCP_Утилиты.Значение(Спецификация, "field", ""))));
		Направление = ?(НРег(СокрЛП(Строка(MCP_Утилиты.Значение(Спецификация, "dir", "asc")))) = "desc",
			" УБЫВ", " ВОЗР");

		Если Поле = "receivable" ИЛИ Поле = "payable" Тогда
			Возврат ОсновнаяСторона + Направление;

		ИначеЕсли Поле = "advance" Тогда
			Возврат ОбратнаяСторона + Направление;

		ИначеЕсли Поле = "net" Тогда
			Возврат ОсновнаяСторона + " - " + ОбратнаяСторона + Направление;

		ИначеЕсли Измерения.Найти(Поле) <> Неопределено Тогда
			Возврат ОписаниеИзмеренияВзаиморасчетов(Поле).Имя + Направление;

		КонецЕсли;

	КонецЦикла;

	// По умолчанию сверху крупнейшие должники (или крупнейшие наши долги).
	Возврат ОсновнаяСторона + " УБЫВ";

КонецФункции // ПорядокВзаиморасчетов()

// Ссылки денежных счетов из фильтра cash_ids. Измерение составное, поэтому один и тот же
// UUID проверяется по обоим справочникам: гейт не знает, касса это или банковский счёт.
//
Функция ДенежныеСчетаФильтра(Фильтры)

	Результат = Новый Массив;

	СырыеИД = MCP_Утилиты.ВМассивСтрок(MCP_Утилиты.Значение(Фильтры, "cash_ids"));

	Если СырыеИД.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Кассы = Новый Массив;
	Счета = Новый Массив;

	Для Каждого Элемент Из СырыеИД Цикл

		УИД = MCP_Утилиты.УникальныйИдентификаторИзСтроки(Элемент);

		Если УИД <> Неопределено Тогда
			Кассы.Добавить(Справочники.Кассы.ПолучитьСсылку(УИД));
			Счета.Добавить(Справочники.БанковскиеСчета.ПолучитьСсылку(УИД));
		КонецЕсли;

	КонецЦикла;

	Если Кассы.Количество() > 0 Тогда

		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Кассы.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Кассы КАК Кассы
		|ГДЕ
		|	Кассы.Ссылка В (&Кассы)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Счета.Ссылка
		|ИЗ
		|	Справочник.БанковскиеСчета КАК Счета
		|ГДЕ
		|	Счета.Ссылка В (&Счета)";

		Запрос.УстановитьПараметр("Кассы", Кассы);
		Запрос.УстановитьПараметр("Счета", Счета);

		Выборка = Запрос.Выполнить().Выбрать();

		Пока Выборка.Следующий() Цикл
			Результат.Добавить(Выборка.Ссылка);
		КонецЦикла;

	КонецЕсли;

	// Несуществующий id отсекаем ошибкой, а не пустым отбором: иначе опечатка в UUID
	// вернула бы честный ноль, а модель прочитала бы его как "денег нет".
	Если Результат.Количество() = 0 Тогда
		ВызватьИсключение ОшибкаЗапроса("cash_ids: no existing cash desk or bank account resolved");
	КонецЕсли;

	Возврат Результат;

КонецФункции // ДенежныеСчетаФильтра()

Функция ОписаниеСправочникаДенег(Ключи, Ключ, Псевдоним, ИмяСправочника, ПсевдонимТаблицы)

	Соединения = Новый Массив;
	Соединения.Добавить("ЛЕВОЕ СОЕДИНЕНИЕ " + ИмяСправочника + " КАК " + ПсевдонимТаблицы + Символы.ПС + Символы.Таб
		+ "ПО " + ПсевдонимТаблицы + ".Ссылка = Свод." + Псевдоним);

	Возврат Новый Структура(Ключи, Ключ, Псевдоним, Псевдоним + "Имя",
		ПсевдонимТаблицы + ".Наименование", "", Соединения);

КонецФункции // ОписаниеСправочникаДенег()

Функция ОписаниеКолонки(Имя, Тип)

	Колонка = Новый Структура;
	Колонка.Вставить("name", Имя);
	Колонка.Вставить("type", Тип);

	Возврат Колонка;

КонецФункции // ОписаниеКолонки()

// Ячейка составной аналитики: к {id, label} добавляется kind - тип объекта, который
// в этой строке оказался. Без него читатель не отличит контрагента от своей же
// организации во внутреннем перемещении.
//
Функция ЯчейкаАналитики(Ссылка, Представление, Вид)

	Ячейка = ЯчейкаСсылки(Ссылка, Представление);
	Ячейка.Вставить("kind", СокрЛП(Строка(Вид)));

	Возврат Ячейка;

КонецФункции // ЯчейкаАналитики()

#EndRegion

#Region Состав

// Отчёты specification / specification_cost / specification_explode /
// specification_where_used / specification_list.
//
// Модель УПП принципиально отличается от той, под которую написан общий контракт.
// В контракте состав лежит в регистре сведений и версионируется документом
// «СпецификацияМатериалов», а вариант состава задаётся тройкой матрица + тип состава +
// группировка производства. В УПП ничего этого нет:
//
//  - состав живёт в Справочник.СпецификацииНоменклатуры, ТЧ ИсходныеКомплектующие;
//  - вариантов в смысле контракта нет вовсе - у товара просто может быть НЕСКОЛЬКО
//    спецификаций, из которых одна помечена как Активная;
//  - матрицы, типа состава и группировки производства нет ни в каком виде, поэтому
//    matrix_id / composition_type_id / production_group_id отвечают 400. Молча их
//    проигнорировать нельзя: модель решила бы, что получила один конкретный вариант.
//
// Взамен отдаются честные ключи УПП: сама спецификация, её вид (Сборочная / Полная /
// Узел), состояние и код версии.
//
// Ключевая тонкость нормы. Спецификация задаётся НА ВЫПУСК В N ЕДИНИЦ (реквизит
// Количество в шапке), а не на одну, поэтому норма на единицу - это
// Количество комплектующей / Количество выхода. Взять числитель как есть значило бы
// завысить расход во столько раз, каков выпуск по спецификации.
//
Функция СоставТовара(Параметры)

	Возврат ВыборкаСостава(Параметры, Ложь);

КонецФункции // СоставТовара()

Функция СтоимостьСостава(Параметры)

	Возврат ВыборкаСостава(Параметры, Истина);

КонецФункции // СтоимостьСостава()

Функция ВыборкаСостава(Параметры, НужнаЦена)

	ОтклонитьВариантыСостава(Параметры);

	Товары = ТоварыСостава(Параметры);
	Дата = ДатаСостава(Параметры);
	Количество = КоличествоВыпуска(Параметры);

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Товары", Товары);
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Количество", Количество);

	Спецификации = СсылкиФильтра(Параметры, "specification_id", Справочники.СпецификацииНоменклатуры,
		"Справочник.СпецификацииНоменклатуры");

	Запрос.УстановитьПараметр("Спецификации", Спецификации);
	Запрос.УстановитьПараметр("ОтборПоСпецификации", Спецификации.Количество() > 0);

	ТипЦен = Неопределено;

	Если НужнаЦена Тогда
		ТипЦен = ТипЦенСостава(Параметры);
		Запрос.УстановитьПараметр("ТипЦен", ТипЦен);
		// Год истории списаний: короче - и сезонные материалы остались бы без цены,
		// длиннее - средняя перестала бы отражать сегодняшние деньги.
		Запрос.УстановитьПараметр("НачалоСписаний", ДобавитьМесяц(НачалоДня(Дата), -12));
	КонецЕсли;

	Запрос.Текст = ТекстЗапросаСостава(НужнаЦена);

	Пакет = Запрос.ВыполнитьПакет();

	ПроверитьОднозначностьСпецификаций(Пакет[1]);

	Результат = РезультатСостава(Пакет[Пакет.ВГраница()], НужнаЦена);

	Результат.Вставить("date", MCP_JSON.ДатаВСтрокуКоротко(Дата));
	Результат.Вставить("qty", Количество);

	Если НужнаЦена Тогда
		Результат.Вставить("price_type", ЯчейкаСсылки(ТипЦен, ТипЦен));
	КонецЕсли;

	Возврат Результат;

КонецФункции // ВыборкаСостава()

// Текст пакета: активные спецификации -> контроль однозначности -> состав (+ цены).
//
Функция ТекстЗапросаСостава(НужнаЦена)

	Текст = ТекстАктивныхСпецификаций() + ";" + Символы.ПС + Символы.ПС + ТекстКонтроляСпецификаций();

	// Состав кладём во временную таблицу до присоединения цен: соединять напрямую со
	// срезом последних нельзя - платформа считала бы срез по всему регистру цен и
	// присоединяла его к ещё не собранному составу.
	Текст = Текст + ";" + Символы.ПС + Символы.ПС +
	"ВЫБРАТЬ
	|	Спец.Продукция КАК Продукция,
	|	Спец.Спецификация КАК Спецификация,
	|	Спец.ВидСпецификации КАК ВидСпецификации,
	|	Спец.Состояние КАК Состояние,
	|	Спец.КодВерсии КАК КодВерсии,
	|	Спец.ДатаУтверждения КАК ДатаУтверждения,
	|	Комплектующая.Номенклатура КАК Материал,
	|	Комплектующая.ОсновноеСырье КАК ОсновноеСырье,
	|	Комплектующая.Количество / Спец.КоличествоВыхода КАК НормаНаЕдиницу,
	|	Комплектующая.Количество / Спец.КоличествоВыхода * &Количество КАК НормаВсего
	|ПОМЕСТИТЬ СоставДетали
	|ИЗ
	|	АктивныеСпецификации КАК Спец
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СпецификацииНоменклатуры.ИсходныеКомплектующие КАК Комплектующая
	|		ПО Комплектующая.Ссылка = Спец.Спецификация
	|ИНДЕКСИРОВАТЬ ПО
	|	Продукция";

	Если НужнаЦена Тогда
		// Срез сужен до материалов состава: без отбора платформа развернула бы цены
		// по всей номенклатуре базы.
		Текст = Текст + ";" + Символы.ПС + Символы.ПС +
		"ВЫБРАТЬ
		|	Цены.Номенклатура КАК Материал,
		|	Цены.Цена КАК Цена
		|ПОМЕСТИТЬ ЦеныМатериалов
		|ИЗ
		|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&Дата,
		|		ТипЦен = &ТипЦен
		|			И Номенклатура В
		|				(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|					СоставДетали.Материал
		|				ИЗ
		|					СоставДетали КАК СоставДетали)) КАК Цены
		|ИНДЕКСИРОВАТЬ ПО
		|	Материал";

		// Второй источник: средняя себестоимость остатка партий на ту же дату.
		// Регистр цен в этой базе заполнен лишь для части номенклатуры, а партионный
		// учёт хранит фактические деньги по каждой позиции, лежащей на складе.
		Текст = Текст + ";" + Символы.ПС + Символы.ПС + ТекстСебестоимостиОстатка();

		// Третий источник: средняя цена фактического списания в производство.
		// Закрывает позиции с нулевым остатком - их в партиях уже нет, но история
		// списаний показывает, почём они уходили в выпуск.
		Текст = Текст + ";" + Символы.ПС + Символы.ПС + ТекстЦеныСписания();
	КонецЕсли;

	Текст = Текст + ";" + Символы.ПС + Символы.ПС +
	"ВЫБРАТЬ
	|	Состав.Продукция КАК Продукция,
	|	Т_Продукция.Наименование КАК ПродукцияИмя,
	|	Состав.Спецификация КАК Спецификация,
	|	Т_Спецификация.Наименование КАК СпецификацияИмя,
	|	Состав.ВидСпецификации КАК ВидСпецификации,
	|	Состав.Состояние КАК Состояние,
	|	Состав.КодВерсии КАК КодВерсии,
	|	Состав.ДатаУтверждения КАК ДатаУтверждения,
	|	Состав.Материал КАК Материал,
	|	Т_Материал.Наименование КАК МатериалИмя,
	|	Т_Материал.Артикул КАК Артикул,
	|	Т_Материал.БазоваяЕдиницаИзмерения КАК Единица,
	|	Состав.ОсновноеСырье КАК ОсновноеСырье,
	|	Состав.НормаНаЕдиницу КАК НормаНаЕдиницу,
	|	Состав.НормаВсего КАК НормаВсего";

	Если НужнаЦена Тогда
		Текст = Текст + "," + Символы.ПС +
		"	" + ВыражениеЦеныКаскадом("Цены.Цена", "Себестоимость.Цена", "Списание.Цена") + " КАК Цена,
		|	Состав.НормаВсего * " + ВыражениеЦеныКаскадом("Цены.Цена", "Себестоимость.Цена",
			"Списание.Цена") + " КАК Сумма,
		|	" + ВыражениеИсточникаЦены("Цены.Цена", "Себестоимость.Цена", "Списание.Цена")
			+ " КАК ИсточникЦены";
	КонецЕсли;

	Текст = Текст + Символы.ПС +
	"ИЗ
	|	СоставДетали КАК Состав
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Т_Материал
	|		ПО Т_Материал.Ссылка = Состав.Материал
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Т_Продукция
	|		ПО Т_Продукция.Ссылка = Состав.Продукция
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СпецификацииНоменклатуры КАК Т_Спецификация
	|		ПО Т_Спецификация.Ссылка = Состав.Спецификация";

	Если НужнаЦена Тогда
		Текст = Текст + Символы.ПС + Символы.Таб + Символы.Таб
			+ "ЛЕВОЕ СОЕДИНЕНИЕ ЦеныМатериалов КАК Цены" + Символы.ПС + Символы.Таб + Символы.Таб
			+ "ПО Цены.Материал = Состав.Материал" + Символы.ПС + Символы.Таб + Символы.Таб
			+ "ЛЕВОЕ СОЕДИНЕНИЕ СебестоимостьМатериалов КАК Себестоимость" + Символы.ПС
			+ Символы.Таб + Символы.Таб + "ПО Себестоимость.Материал = Состав.Материал" + Символы.ПС
			+ Символы.Таб + Символы.Таб + "ЛЕВОЕ СОЕДИНЕНИЕ ЦеныСписания КАК Списание" + Символы.ПС
			+ Символы.Таб + Символы.Таб + "ПО Списание.Материал = Состав.Материал";
	КонецЕсли;

	Возврат Текст + Символы.ПС +
	"УПОРЯДОЧИТЬ ПО
	|	ПродукцияИмя,
	|	ОсновноеСырье УБЫВ,
	|	МатериалИмя";

КонецФункции // ТекстЗапросаСостава()

// Второй источник цены материала - средняя себестоимость остатка партий на дату.
// Тот же регистр, из которого читает stock_balance, поэтому цифры сходятся с остатками.
//
Функция ТекстСебестоимостиОстатка()

	Возврат
	"ВЫБРАТЬ
	|	Остатки.Номенклатура КАК Материал,
	|	СУММА(Остатки.СтоимостьОстаток) / СУММА(Остатки.КоличествоОстаток) КАК Цена
	|ПОМЕСТИТЬ СебестоимостьМатериалов
	|ИЗ
	|	РегистрНакопления.ПартииТоваровНаСкладах.Остатки(&Дата,
	|		Номенклатура В
	|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|				СоставДетали.Материал
	|			ИЗ
	|				СоставДетали КАК СоставДетали)) КАК Остатки
	|СГРУППИРОВАТЬ ПО
	|	Остатки.Номенклатура
	|ИМЕЮЩИЕ
	|	СУММА(Остатки.КоличествоОстаток) > 0
	|	И СУММА(Остатки.СтоимостьОстаток) > 0
	|ИНДЕКСИРОВАТЬ ПО
	|	Материал";

КонецФункции // ТекстСебестоимостиОстатка()

// Третий источник цены материала - средняя цена фактического списания в производство
// за период с &НачалоСписаний по &Дата. Нужен для позиций с нулевым остатком: в партиях
// их уже нет, а история списаний показывает, почём они уходили в выпуск.
//
// Измерение Затрата составное - кроме номенклатуры туда попадают характер затрат и
// способы распределения, поэтому берётся только Затрата ССЫЛКА Справочник.Номенклатура.
//
Функция ТекстЦеныСписания()

	Возврат
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(Обороты.Затрата КАК Справочник.Номенклатура) КАК Материал,
	|	СУММА(Обороты.СуммаОборот) / СУММА(Обороты.КоличествоОборот) КАК Цена
	|ПОМЕСТИТЬ ЦеныСписания
	|ИЗ
	|	РегистрНакопления.ЗатратыНаВыпускПродукции.Обороты(&НачалоСписаний, &Дата, ,
	|		Затрата ССЫЛКА Справочник.Номенклатура
	|			И Затрата В
	|				(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|					СоставДетали.Материал
	|				ИЗ
	|					СоставДетали КАК СоставДетали)) КАК Обороты
	|СГРУППИРОВАТЬ ПО
	|	ВЫРАЗИТЬ(Обороты.Затрата КАК Справочник.Номенклатура)
	|ИМЕЮЩИЕ
	|	СУММА(Обороты.КоличествоОборот) > 0
	|	И СУММА(Обороты.СуммаОборот) > 0
	|ИНДЕКСИРОВАТЬ ПО
	|	Материал";

КонецФункции // ТекстЦеныСписания()

// Каскад источников цены: прайс -> себестоимость остатка -> цена списания.
// Порядок задан заказчиком 2026-09-02: прайс отвечает на вопрос "почём закупаем",
// а два следующих источника - "почём это лежит и почём уходило", и включаются только
// там, где прайса нет.
//
Функция ВыражениеЦеныКаскадом(Прайс, Остаток, Списание)

	Возврат "ВЫБОР
	|		КОГДА " + Прайс + " ЕСТЬ НЕ NULL
	|			ТОГДА " + Прайс + "
	|		КОГДА " + Остаток + " ЕСТЬ НЕ NULL
	|			ТОГДА " + Остаток + "
	|		КОГДА " + Списание + " ЕСТЬ НЕ NULL
	|			ТОГДА " + Списание + "
	|		ИНАЧЕ 0
	|	КОНЕЦ";

КонецФункции // ВыражениеЦеныКаскадом()

// Метка источника цены той же строки. Без неё сумма молча смешивала бы прайс,
// себестоимость и цену списания, а строки без всякой цены выглядели бы как нулевые.
//
Функция ВыражениеИсточникаЦены(Прайс, Остаток, Списание)

	Возврат "ВЫБОР
	|		КОГДА " + Прайс + " ЕСТЬ НЕ NULL
	|			ТОГДА ""price""
	|		КОГДА " + Остаток + " ЕСТЬ НЕ NULL
	|			ТОГДА ""stock_cost""
	|		КОГДА " + Списание + " ЕСТЬ НЕ NULL
	|			ТОГДА ""consumption""
	|		ИНАЧЕ ""none""
	|	КОНЕЦ";

КонецФункции // ВыражениеИсточникаЦены()

// Активные спецификации запрошенных товаров.
//
// Отбор идёт по флагу Активная, а НЕ по Состояние = Утвержден: состояние в базах
// заполняют не всегда, и жёсткое условие обнулило бы выдачу целиком. Состояние
// возвращается колонкой - пусть читатель видит, что состав, например, лишь подготовлен.
//
// ДатаУтверждения = пустая дата пропускается по той же причине: незаполненный реквизит
// не должен означать "спецификации на эту дату не существует".
//
Функция ТекстАктивныхСпецификаций()

	Возврат
	"ВЫБРАТЬ
	|	Выход.Ссылка КАК Спецификация,
	|	Выход.Номенклатура КАК Продукция,
	|	Спец.ВидСпецификации КАК ВидСпецификации,
	|	Спец.Состояние КАК Состояние,
	|	Спец.КодВерсии КАК КодВерсии,
	|	Спец.ДатаУтверждения КАК ДатаУтверждения,
	|	ВЫБОР
	|		КОГДА СУММА(Выход.Количество) > 0
	|			ТОГДА СУММА(Выход.Количество)
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК КоличествоВыхода
	|ПОМЕСТИТЬ АктивныеСпецификации
	|ИЗ
	|	Справочник.СпецификацииНоменклатуры.ВыходныеИзделия КАК Выход
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СпецификацииНоменклатуры КАК Спец
	|		ПО Спец.Ссылка = Выход.Ссылка
	|ГДЕ
	|	Спец.Активная
	|	И НЕ Спец.ПометкаУдаления
	|	И Выход.Номенклатура В (&Товары)
	|	И (Спец.ДатаУтверждения <= &Дата
	|		ИЛИ Спец.ДатаУтверждения = ДАТАВРЕМЯ(1, 1, 1))
	|	И (НЕ &ОтборПоСпецификации
	|		ИЛИ Спец.Ссылка В (&Спецификации))
	|СГРУППИРОВАТЬ ПО
	|	Выход.Ссылка,
	|	Выход.Номенклатура,
	|	Спец.ВидСпецификации,
	|	Спец.Состояние,
	|	Спец.КодВерсии,
	|	Спец.ДатаУтверждения
	|ИНДЕКСИРОВАТЬ ПО
	|	Продукция,
	|	Спецификация";

КонецФункции // ТекстАктивныхСпецификаций()

// Товары, у которых активных спецификаций больше одной. Отдать состав такого товара
// молча нельзя: строки двух разных спецификаций сложились бы в один список, и читатель
// принял бы смесь за единственный состав.
//
Функция ТекстКонтроляСпецификаций()

	Возврат
	"ВЫБРАТЬ
	|	Спец.Продукция КАК Продукция,
	|	Т_Продукция.Наименование КАК ПродукцияИмя,
	|	КОЛИЧЕСТВО(Спец.Спецификация) КАК Вариантов
	|ИЗ
	|	АктивныеСпецификации КАК Спец
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Т_Продукция
	|		ПО Т_Продукция.Ссылка = Спец.Продукция
	|СГРУППИРОВАТЬ ПО
	|	Спец.Продукция,
	|	Т_Продукция.Наименование
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(Спец.Спецификация) > 1";

КонецФункции // ТекстКонтроляСпецификаций()

Процедура ПроверитьОднозначностьСпецификаций(РезультатКонтроля)

	Выборка = РезультатКонтроля.Выбрать();
	Спорные = Новый Массив;

	Пока Выборка.Следующий() Цикл
		Спорные.Добавить(СокрЛП(Строка(Выборка.ПродукцияИмя))
			+ " (" + Формат(Выборка.Вариантов, "ЧГ=0") + ")");
	КонецЦикла;

	Если Спорные.Количество() > 0 Тогда
		ВызватьИсключение ОшибкаЗапроса(
			"more than one active specification for: " + Соединить(Спорные, "; ")
			+ " - pass specification_id to choose one");
	КонецЕсли;

КонецПроцедуры // ПроверитьОднозначностьСпецификаций()

Функция РезультатСостава(РезультатДеталей, НужнаЦена)

	Колонки = Новый Массив;
	Колонки.Добавить(ОписаниеКолонки("product", "ref"));
	Колонки.Добавить(ОписаниеКолонки("material", "ref"));
	Колонки.Добавить(ОписаниеКолонки("article", "string"));
	Колонки.Добавить(ОписаниеКолонки("unit", "string"));
	Колонки.Добавить(ОписаниеКолонки("qty_per_unit", "number"));
	Колонки.Добавить(ОписаниеКолонки("qty_total", "number"));

	Если НужнаЦена Тогда
		Колонки.Добавить(ОписаниеКолонки("price", "number"));
		Колонки.Добавить(ОписаниеКолонки("amount", "number"));
		Колонки.Добавить(ОписаниеКолонки("price_source", "string"));
	КонецЕсли;

	Колонки.Добавить(ОписаниеКолонки("is_main_raw", "string"));
	Колонки.Добавить(ОписаниеКолонки("specification", "ref"));
	Колонки.Добавить(ОписаниеКолонки("specification_kind", "string"));
	Колонки.Добавить(ОписаниеКолонки("state", "string"));
	Колонки.Добавить(ОписаниеКолонки("version", "string"));
	Колонки.Добавить(ОписаниеКолонки("spec_date", "date"));

	Строки = Новый Массив;
	Итого = 0;
	БезЦены = 0;

	Выборка = РезультатДеталей.Выбрать();

	Пока Выборка.Следующий() Цикл

		Ячейки = Новый Массив;
		Ячейки.Добавить(ЯчейкаСсылки(Выборка.Продукция, Выборка.ПродукцияИмя));
		Ячейки.Добавить(ЯчейкаСсылки(Выборка.Материал, Выборка.МатериалИмя));
		Ячейки.Добавить(СокрЛП(Строка(Выборка.Артикул)));
		Ячейки.Добавить(СокрЛП(Строка(Выборка.Единица)));
		Ячейки.Добавить(MCP_Утилиты.ВЧисло(Выборка.НормаНаЕдиницу));
		Ячейки.Добавить(MCP_Утилиты.ВЧисло(Выборка.НормаВсего));

		Если НужнаЦена Тогда

			Ячейки.Добавить(MCP_Утилиты.ВЧисло(Выборка.Цена));
			Ячейки.Добавить(MCP_Утилиты.ВЧисло(Выборка.Сумма));
			Ячейки.Добавить(СокрЛП(Строка(Выборка.ИсточникЦены)));

			Итого = Итого + MCP_Утилиты.ВЧисло(Выборка.Сумма);

			Если СокрЛП(Строка(Выборка.ИсточникЦены)) = "none" Тогда
				БезЦены = БезЦены + 1;
			КонецЕсли;

		КонецЕсли;

		Ячейки.Добавить(?(Выборка.ОсновноеСырье, "yes", "no"));
		Ячейки.Добавить(ЯчейкаСсылки(Выборка.Спецификация, Выборка.СпецификацияИмя));
		Ячейки.Добавить(СокрЛП(Строка(Выборка.ВидСпецификации)));
		Ячейки.Добавить(СокрЛП(Строка(Выборка.Состояние)));
		Ячейки.Добавить(СокрЛП(Строка(Выборка.КодВерсии)));
		Ячейки.Добавить(MCP_JSON.ДатаВСтрокуКоротко(Выборка.ДатаУтверждения));

		Строки.Добавить(Ячейки);

	КонецЦикла;

	Итоги = Новый Структура;

	Если НужнаЦена Тогда
		Итоги.Вставить("amount", Окр(Итого, 2));
		// Сумма неполная, если часть материалов осталась без цены. Без этого счётчика
		// модель приняла бы её за полную себестоимость состава.
		Итоги.Вставить("rows_without_price", БезЦены);
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("columns", Колонки);
	Результат.Вставить("rows", Строки);
	Результат.Вставить("totals", Итоги);

	Возврат Результат;

КонецФункции // РезультатСостава()

// Отчёт specification_where_used - обратное разузлование: в какие товары входит материал.
//
Функция ГдеИспользуется(Параметры)

	ОтклонитьВариантыСостава(Параметры);

	Материалы = МатериалыОтбора(Параметры);
	Дата = ДатаСостава(Параметры);

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Материалы", Материалы);
	Запрос.УстановитьПараметр("Дата", Дата);

	Лимит = ЛимитСостава(Параметры, 100);

	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит, "ЧГ=0") + "
	|	Комплектующая.Номенклатура КАК Материал,
	|	Т_Материал.Наименование КАК МатериалИмя,
	|	Выход.Номенклатура КАК Продукция,
	|	Т_Продукция.Наименование КАК ПродукцияИмя,
	|	Спец.Ссылка КАК Спецификация,
	|	Т_Спецификация.Наименование КАК СпецификацияИмя,
	|	Спец.ВидСпецификации КАК ВидСпецификации,
	|	Спец.Состояние КАК Состояние,
	|	Спец.КодВерсии КАК КодВерсии,
	|	Спец.ДатаУтверждения КАК ДатаУтверждения,
	|	Комплектующая.ОсновноеСырье КАК ОсновноеСырье,
	|	Комплектующая.Количество / ВЫБОР
	|			КОГДА Выход.Количество > 0
	|				ТОГДА Выход.Количество
	|			ИНАЧЕ 1
	|		КОНЕЦ КАК НормаНаЕдиницу
	|ИЗ
	|	Справочник.СпецификацииНоменклатуры.ИсходныеКомплектующие КАК Комплектующая
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СпецификацииНоменклатуры КАК Спец
	|		ПО Спец.Ссылка = Комплектующая.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СпецификацииНоменклатуры.ВыходныеИзделия КАК Выход
	|		ПО Выход.Ссылка = Спец.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Т_Материал
	|		ПО Т_Материал.Ссылка = Комплектующая.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Т_Продукция
	|		ПО Т_Продукция.Ссылка = Выход.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СпецификацииНоменклатуры КАК Т_Спецификация
	|		ПО Т_Спецификация.Ссылка = Спец.Ссылка
	|ГДЕ
	|	Комплектующая.Номенклатура В ИЕРАРХИИ (&Материалы)
	|	И Спец.Активная
	|	И НЕ Спец.ПометкаУдаления
	|	И (Спец.ДатаУтверждения <= &Дата
	|		ИЛИ Спец.ДатаУтверждения = ДАТАВРЕМЯ(1, 1, 1))
	|УПОРЯДОЧИТЬ ПО
	|	МатериалИмя,
	|	ПродукцияИмя";

	Колонки = Новый Массив;
	Колонки.Добавить(ОписаниеКолонки("material", "ref"));
	Колонки.Добавить(ОписаниеКолонки("product", "ref"));
	Колонки.Добавить(ОписаниеКолонки("qty_per_unit", "number"));
	Колонки.Добавить(ОписаниеКолонки("is_main_raw", "string"));
	Колонки.Добавить(ОписаниеКолонки("specification", "ref"));
	Колонки.Добавить(ОписаниеКолонки("specification_kind", "string"));
	Колонки.Добавить(ОписаниеКолонки("state", "string"));
	Колонки.Добавить(ОписаниеКолонки("version", "string"));
	Колонки.Добавить(ОписаниеКолонки("spec_date", "date"));

	Строки = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		Ячейки = Новый Массив;
		Ячейки.Добавить(ЯчейкаСсылки(Выборка.Материал, Выборка.МатериалИмя));
		Ячейки.Добавить(ЯчейкаСсылки(Выборка.Продукция, Выборка.ПродукцияИмя));
		Ячейки.Добавить(MCP_Утилиты.ВЧисло(Выборка.НормаНаЕдиницу));
		Ячейки.Добавить(?(Выборка.ОсновноеСырье, "yes", "no"));
		Ячейки.Добавить(ЯчейкаСсылки(Выборка.Спецификация, Выборка.СпецификацияИмя));
		Ячейки.Добавить(СокрЛП(Строка(Выборка.ВидСпецификации)));
		Ячейки.Добавить(СокрЛП(Строка(Выборка.Состояние)));
		Ячейки.Добавить(СокрЛП(Строка(Выборка.КодВерсии)));
		Ячейки.Добавить(MCP_JSON.ДатаВСтрокуКоротко(Выборка.ДатаУтверждения));

		Строки.Добавить(Ячейки);

	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("columns", Колонки);
	Результат.Вставить("rows", Строки);
	Результат.Вставить("totals", Новый Структура);
	Результат.Вставить("date", MCP_JSON.ДатаВСтрокуКоротко(Дата));

	Возврат Результат;

КонецФункции // ГдеИспользуется()

// Отчёт specification_list. Обычный режим - инвентарь активных спецификаций;
// missing_only - товары, которые выпускались в периоде, но состава не имеют.
//
Функция СписокСпецификаций(Параметры)

	ОтклонитьВариантыСостава(Параметры);

	Если MCP_Утилиты.ВБулево(MCP_Утилиты.Значение(Параметры, "missing_only")) Тогда
		Возврат ВыпускБезСостава(Параметры);
	КонецЕсли;

	Дата = ДатаСостава(Параметры);

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", Дата);

	Товары = СсылкиФильтра(MCP_Утилиты.Значение(Параметры, "filters"), "product_ids",
		Справочники.Номенклатура, "Справочник.Номенклатура");

	// filters здесь может не быть вовсе - у инструмента product_ids лежит в корне тела.
	Если Товары.Количество() = 0 Тогда
		Товары = СсылкиФильтра(Параметры, "product_ids", Справочники.Номенклатура,
			"Справочник.Номенклатура");
	КонецЕсли;

	Запрос.УстановитьПараметр("Товары", Товары);
	Запрос.УстановитьПараметр("ОтборПоТоварам", Товары.Количество() > 0);

	Лимит = ЛимитСостава(Параметры, 200);

	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит, "ЧГ=0") + "
	|	Выход.Номенклатура КАК Продукция,
	|	Т_Продукция.Наименование КАК ПродукцияИмя,
	|	Спец.Ссылка КАК Спецификация,
	|	Т_Спецификация.Наименование КАК СпецификацияИмя,
	|	Спец.ВидСпецификации КАК ВидСпецификации,
	|	Спец.Состояние КАК Состояние,
	|	Спец.КодВерсии КАК КодВерсии,
	|	Спец.ДатаУтверждения КАК ДатаУтверждения,
	|	КОЛИЧЕСТВО(Комплектующая.НомерСтроки) КАК Материалов
	|ИЗ
	|	Справочник.СпецификацииНоменклатуры КАК Спец
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СпецификацииНоменклатуры.ВыходныеИзделия КАК Выход
	|		ПО Выход.Ссылка = Спец.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СпецификацииНоменклатуры.ИсходныеКомплектующие КАК Комплектующая
	|		ПО Комплектующая.Ссылка = Спец.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Т_Продукция
	|		ПО Т_Продукция.Ссылка = Выход.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СпецификацииНоменклатуры КАК Т_Спецификация
	|		ПО Т_Спецификация.Ссылка = Спец.Ссылка
	|ГДЕ
	|	Спец.Активная
	|	И НЕ Спец.ПометкаУдаления
	|	И (Спец.ДатаУтверждения <= &Дата
	|		ИЛИ Спец.ДатаУтверждения = ДАТАВРЕМЯ(1, 1, 1))
	|	И (НЕ &ОтборПоТоварам
	|		ИЛИ Выход.Номенклатура В ИЕРАРХИИ (&Товары))
	|СГРУППИРОВАТЬ ПО
	|	Выход.Номенклатура,
	|	Т_Продукция.Наименование,
	|	Спец.Ссылка,
	|	Т_Спецификация.Наименование,
	|	Спец.ВидСпецификации,
	|	Спец.Состояние,
	|	Спец.КодВерсии,
	|	Спец.ДатаУтверждения
	|УПОРЯДОЧИТЬ ПО
	|	ПродукцияИмя";

	Колонки = Новый Массив;
	Колонки.Добавить(ОписаниеКолонки("product", "ref"));
	Колонки.Добавить(ОписаниеКолонки("specification", "ref"));
	Колонки.Добавить(ОписаниеКолонки("specification_kind", "string"));
	Колонки.Добавить(ОписаниеКолонки("state", "string"));
	Колонки.Добавить(ОписаниеКолонки("version", "string"));
	Колонки.Добавить(ОписаниеКолонки("materials_count", "number"));
	Колонки.Добавить(ОписаниеКолонки("spec_date", "date"));

	Строки = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		Ячейки = Новый Массив;
		Ячейки.Добавить(ЯчейкаСсылки(Выборка.Продукция, Выборка.ПродукцияИмя));
		Ячейки.Добавить(ЯчейкаСсылки(Выборка.Спецификация, Выборка.СпецификацияИмя));
		Ячейки.Добавить(СокрЛП(Строка(Выборка.ВидСпецификации)));
		Ячейки.Добавить(СокрЛП(Строка(Выборка.Состояние)));
		Ячейки.Добавить(СокрЛП(Строка(Выборка.КодВерсии)));
		Ячейки.Добавить(MCP_Утилиты.ВЧисло(Выборка.Материалов));
		Ячейки.Добавить(MCP_JSON.ДатаВСтрокуКоротко(Выборка.ДатаУтверждения));

		Строки.Добавить(Ячейки);

	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("columns", Колонки);
	Результат.Вставить("rows", Строки);
	Результат.Вставить("totals", Новый Структура);
	Результат.Вставить("date", MCP_JSON.ДатаВСтрокуКоротко(Дата));

	Возврат Результат;

КонецФункции // СписокСпецификаций()

// Режим missing_only: что выпускали, но состава не завели. Именно эта пара и даёт
// ошибку "не задан состав продукции" при заполнении материалов в производственном
// документе.
//
Функция ВыпускБезСостава(Параметры)

	Период = ПериодПродаж(Параметры);
	Дата = ДатаСостава(Параметры);

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачалоПериода", Период.Начало);
	Запрос.УстановитьПараметр("ОкончаниеПериода", Период.Окончание);
	Запрос.УстановитьПараметр("Дата", Дата);

	Лимит = ЛимитСостава(Параметры, 100);

	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит, "ЧГ=0") + "
	|	Обороты.Продукция КАК Продукция,
	|	Т_Продукция.Наименование КАК ПродукцияИмя,
	|	СУММА(Обороты.КоличествоОборот) КАК Количество,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Обороты.ДокументВыпуска) КАК Документов,
	|	МАКСИМУМ(Обороты.Период) КАК ПоследнийВыпуск
	|ИЗ
	|	РегистрНакопления.ВыпускПродукции.Обороты(&НачалоПериода, &ОкончаниеПериода, Регистратор) КАК Обороты
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Т_Продукция
	|		ПО Т_Продукция.Ссылка = Обороты.Продукция
	|ГДЕ
	|	НЕ Обороты.Продукция В
	|			(ВЫБРАТЬ
	|				Выход.Номенклатура
	|			ИЗ
	|				Справочник.СпецификацииНоменклатуры.ВыходныеИзделия КАК Выход
	|					ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СпецификацииНоменклатуры КАК Спец
	|					ПО Спец.Ссылка = Выход.Ссылка
	|			ГДЕ
	|				Спец.Активная
	|				И НЕ Спец.ПометкаУдаления
	|				И (Спец.ДатаУтверждения <= &Дата
	|					ИЛИ Спец.ДатаУтверждения = ДАТАВРЕМЯ(1, 1, 1)))
	|СГРУППИРОВАТЬ ПО
	|	Обороты.Продукция,
	|	Т_Продукция.Наименование
	|УПОРЯДОЧИТЬ ПО
	|	Количество УБЫВ";

	Колонки = Новый Массив;
	Колонки.Добавить(ОписаниеКолонки("product", "ref"));
	Колонки.Добавить(ОписаниеКолонки("produced_qty", "number"));
	Колонки.Добавить(ОписаниеКолонки("documents", "number"));
	Колонки.Добавить(ОписаниеКолонки("last_production_date", "date"));

	Строки = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		Строка = Новый Массив;
		Строка.Добавить(ЯчейкаСсылки(Выборка.Продукция, Выборка.ПродукцияИмя));
		Строка.Добавить(MCP_Утилиты.ВЧисло(Выборка.Количество));
		Строка.Добавить(MCP_Утилиты.ВЧисло(Выборка.Документов));
		Строка.Добавить(MCP_JSON.ДатаВСтрокуКоротко(Выборка.ПоследнийВыпуск));

		Строки.Добавить(Строка);

	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("columns", Колонки);
	Результат.Вставить("rows", Строки);
	Результат.Вставить("totals", Новый Структура);
	Результат.Вставить("period", Новый Структура("from, to",
		MCP_JSON.ДатаВСтрокуКоротко(Период.Начало), MCP_JSON.ДатаВСтрокуКоротко(Период.Окончание)));

	Возврат Результат;

КонецФункции // ВыпускБезСостава()

// Общие помощники состава.

// Матрица, тип состава и группировка производства - понятия чужой модели. В УПП вариант
// состава - это отдельная спецификация, поэтому вместо трёх модификаторов работает
// specification_id, а сами они отклоняются с подсказкой.
//
Процедура ОтклонитьВариантыСостава(Параметры)

	Чужие = "matrix_id,composition_type_id,production_group_id";

	Для Каждого Имя Из РазделитьСтроку(Чужие) Цикл

		Если MCP_Утилиты.Значение(Параметры, Имя) <> Неопределено Тогда
			ВызватьИсключение ОшибкаЗапроса(Имя
				+ " is not supported: this database has no matrix / composition type /"
				+ " production group - a composition variant here is a separate"
				+ " Справочник.СпецификацииНоменклатуры, use specification_id instead");
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры // ОтклонитьВариантыСостава()

Функция ТоварыСостава(Параметры)

	Результат = Новый Массив;

	Одиночный = MCP_Утилиты.Значение(Параметры, "product_id");

	Если Одиночный <> Неопределено И НЕ ПустаяСтрока(СокрЛП(Строка(Одиночный))) Тогда
		Обёртка = Новый Структура("product_ids", MCP_Утилиты.ВМассивСтрок(Одиночный));
		Результат = СсылкиФильтра(Обёртка, "product_ids", Справочники.Номенклатура,
			"Справочник.Номенклатура");
	Иначе
		Результат = СсылкиФильтра(Параметры, "product_ids", Справочники.Номенклатура,
			"Справочник.Номенклатура");
	КонецЕсли;

	Если Результат.Количество() = 0 Тогда
		ВызватьИсключение ОшибкаЗапроса("product_id or product_ids is required");
	КонецЕсли;

	Возврат Результат;

КонецФункции // ТоварыСостава()

Функция МатериалыОтбора(Параметры)

	Одиночный = MCP_Утилиты.Значение(Параметры, "material_id");

	Если Одиночный <> Неопределено И НЕ ПустаяСтрока(СокрЛП(Строка(Одиночный))) Тогда
		Обёртка = Новый Структура("material_ids", MCP_Утилиты.ВМассивСтрок(Одиночный));
		Результат = СсылкиФильтра(Обёртка, "material_ids", Справочники.Номенклатура,
			"Справочник.Номенклатура");
	Иначе
		Результат = СсылкиФильтра(Параметры, "material_ids", Справочники.Номенклатура,
			"Справочник.Номенклатура");
	КонецЕсли;

	Если Результат.Количество() = 0 Тогда
		ВызватьИсключение ОшибкаЗапроса("material_id or material_ids is required");
	КонецЕсли;

	Возврат Результат;

КонецФункции // МатериалыОтбора()

Функция ДатаСостава(Параметры)

	Граница = ГраницаОстатков(Параметры);

	Возврат ?(Граница = Неопределено, КонецДня(ТекущаяДатаСеанса()), Граница);

КонецФункции // ДатаСостава()

Функция КоличествоВыпуска(Параметры)

	Значение = MCP_Утилиты.ВЧисло(MCP_Утилиты.Значение(Параметры, "qty"));

	Возврат ?(Значение <= 0, 1, Значение);

КонецФункции // КоличествоВыпуска()

// Тип цен для оценки материалов. Контракт по умолчанию берёт «ЦенаЗакупки»; в этой базе
// имя типа заранее не известно, поэтому ищем по вхождению "закуп", а не угадываем.
//
Функция ТипЦенСостава(Параметры)

	Заданный = СсылкиФильтра(Параметры, "price_type_ids", Справочники.ТипыЦенНоменклатуры,
		"Справочник.ТипыЦенНоменклатуры");

	Если Заданный.Количество() > 0 Тогда
		Возврат Заданный[0];
	КонецЕсли;

	Одиночный = MCP_Утилиты.Значение(Параметры, "price_type_id");

	Если Одиночный <> Неопределено И НЕ ПустаяСтрока(СокрЛП(Строка(Одиночный))) Тогда
		Обёртка = Новый Структура("price_type_ids", MCP_Утилиты.ВМассивСтрок(Одиночный));
		Возврат СсылкиФильтра(Обёртка, "price_type_ids", Справочники.ТипыЦенНоменклатуры,
			"Справочник.ТипыЦенНоменклатуры")[0];
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 2
	|	ТипыЦен.Ссылка КАК Ссылка,
	|	ТипыЦен.Наименование КАК Наименование
	|ИЗ
	|	Справочник.ТипыЦенНоменклатуры КАК ТипыЦен
	|ГДЕ
	|	ТипыЦен.Наименование ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""~""
	|	И НЕ ТипыЦен.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО
	|	Наименование";

	Запрос.УстановитьПараметр("Шаблон", "%закуп%");

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	ВызватьИсключение ОшибкаЗапроса(
		"price_type_id is required: no price type matching ""закуп"" found in this database");

КонецФункции // ТипЦенСостава()

#EndRegion

#Region Производство

// Отчёты production_output / production_consumption / production_document.
//
// Контракт читает табличные части документа «Производство». В УПП такого документа нет,
// а обороты лежат в полноценных регистрах - источник лучше, чем ТЧ: он уже свёрнут,
// учитывает все документы выпуска разом и не зависит от того, какой именно документ
// оформил операцию.
//
//  production_output      - РегистрНакопления.ВыпускПродукции (обороты)
//  production_consumption - РегистрНакопления.ЗатратыНаВыпускПродукции (обороты)
//
// Измерение Затрата в затратах СОСТАВНОЕ: кроме номенклатуры туда попадают характер
// затрат и способы распределения. Материалом считается только ссылка на номенклатуру,
// остальное отсекается - иначе в списке материалов оказались бы строки вроде
// "Постоянные" и "По объёму выпуска".
//
// Чего в этих регистрах НЕТ и что поэтому отвечает 400: склад (есть подразделение),
// организация, сборка/разборка, сотрудник, а также матрица и тип состава - понятия
// чужой модели. production_group замаплен на Справочник.НоменклатурныеГруппы: в УПП
// это и есть производственная группировка, по которой ведётся учёт выпуска и затрат.
//
Функция ВыпускПродукцииОтчет(Параметры)

	Возврат ОборотыПроизводства(Параметры, "output");

КонецФункции // ВыпускПродукцииОтчет()

Функция РасходМатериаловОтчет(Параметры)

	Возврат ОборотыПроизводства(Параметры, "consumption");

КонецФункции // РасходМатериаловОтчет()

Функция ОборотыПроизводства(Параметры, Вид)

	Фильтры = MCP_Утилиты.Значение(Параметры, "filters");

	ОтклонитьНеподдержанноеПроизводство(Параметры, Фильтры);

	Измерения = ИзмеренияПроизводства(Параметры, Вид);
	Меры = МерыПроизводства(Параметры);
	Период = ПериодПродаж(Параметры);

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("НачалоПериода", Период.Начало);
	Запрос.УстановитьПараметр("ОкончаниеПериода", Период.Окончание);

	Условия = "";

	Товары = СсылкиФильтра(Фильтры, "product_ids", Справочники.Номенклатура, "Справочник.Номенклатура");

	Если Товары.Количество() > 0 Тогда
		Условия = Условия + " И Продукция В ИЕРАРХИИ (&Товары)";
		Запрос.УстановитьПараметр("Товары", Товары);
	КонецЕсли;

	Если Вид = "consumption" Тогда

		Материалы = СсылкиФильтра(Фильтры, "material_ids", Справочники.Номенклатура,
			"Справочник.Номенклатура");

		Если Материалы.Количество() > 0 Тогда
			Условия = Условия + " И Затрата В ИЕРАРХИИ (&Материалы)";
			Запрос.УстановитьПараметр("Материалы", Материалы);
		КонецЕсли;

	КонецЕсли;

	Группы = СсылкиФильтра(Фильтры, "production_group_ids", Справочники.НоменклатурныеГруппы,
		"Справочник.НоменклатурныеГруппы");

	Если Группы.Количество() > 0 Тогда
		Условия = Условия + " И НоменклатурнаяГруппа В ИЕРАРХИИ (&Группы)";
		Запрос.УстановитьПараметр("Группы", Группы);
	КонецЕсли;

	Настройки = Новый Структура("Вид, Измерения, Меры, Условия, Лимит, Сортировка");
	Настройки.Вид = Вид;
	Настройки.Измерения = Измерения;
	Настройки.Меры = Меры;
	Настройки.Условия = Условия;
	Настройки.Лимит = ЛимитСтрок(Параметры);
	Настройки.Сортировка = СпецификацииСортировки(Параметры);

	Запрос.Текст = ТекстЗапросаПроизводства(Настройки);

	Пакет = Запрос.ВыполнитьПакет();

	Результат = РезультатПроизводства(Пакет[Пакет.ВГраница() - 1], Пакет[Пакет.ВГраница()],
		Измерения, Меры);

	Результат.Вставить("period", Новый Структура("from, to",
		MCP_JSON.ДатаВСтрокуКоротко(Период.Начало), MCP_JSON.ДатаВСтрокуКоротко(Период.Окончание)));

	Возврат Результат;

КонецФункции // ОборотыПроизводства()

Функция ТекстЗапросаПроизводства(Настройки)

	Вид = Настройки.Вид;
	Измерения = Настройки.Измерения;

	Регистр = ?(Вид = "output", "ВыпускПродукции", "ЗатратыНаВыпускПродукции");
	РесурсСуммы = ?(Вид = "output", "СтоимостьОборот", "СуммаОборот");

	ПоляДеталей = Новый Массив;
	ГруппировкаДеталей = Новый Массив;

	Для Каждого Измерение Из Измерения Цикл
		Описание = ОписаниеИзмеренияПроизводства(Измерение);
		ДобавитьПоле(ПоляДеталей, ГруппировкаДеталей, "Обороты." + Описание.Поле, Описание.Ссылка);
	КонецЦикла;

	// Документ нужен всегда: мера documents считается как число РАЗЛИЧНЫХ документов
	// выпуска, а не как число строк регистра.
	Если Измерения.Найти("document") = Неопределено Тогда
		ДобавитьПоле(ПоляДеталей, ГруппировкаДеталей, "Обороты.ДокументВыпуска", "Документ");
	КонецЕсли;

	ПоляДеталей.Добавить("СУММА(Обороты.КоличествоОборот) КАК Количество");
	ПоляДеталей.Добавить("СУММА(Обороты." + РесурсСуммы + ") КАК Сумма");

	Периодичность = ПериодичностьПродаж(Измерения);

	Условия = Настройки.Условия;

	// Затрата составная: материалом считаем только номенклатуру.
	Если Вид = "consumption" Тогда
		Условия = Условия + " И Затрата ССЫЛКА Справочник.Номенклатура";
	КонецЕсли;

	Текст = "ВЫБРАТЬ" + Символы.ПС + Символы.Таб
		+ Соединить(ПоляДеталей, "," + Символы.ПС + Символы.Таб) + Символы.ПС
		+ "ПОМЕСТИТЬ ПроизводствоДетали" + Символы.ПС
		+ "ИЗ" + Символы.ПС + Символы.Таб
		+ "РегистрНакопления." + Регистр + ".Обороты(&НачалоПериода, &ОкончаниеПериода, "
		+ Периодичность + УсловиеВиртуальнойТаблицы(Условия) + ") КАК Обороты" + Символы.ПС
		+ "СГРУППИРОВАТЬ ПО" + Символы.ПС + Символы.Таб
		+ Соединить(ГруппировкаДеталей, "," + Символы.ПС + Символы.Таб);

	ПоляСвода = Новый Массив;
	ГруппировкаСвода = Новый Массив;
	ПоляИндекса = Новый Массив;

	Для Каждого Измерение Из Измерения Цикл

		Описание = ОписаниеИзмеренияПроизводства(Измерение);

		ПоляСвода.Добавить(Описание.Ключ + " КАК " + Описание.Ссылка);
		ГруппировкаСвода.Добавить(Описание.Ключ);

		Если Описание.Тип = "ref" Тогда
			ПоляИндекса.Добавить(Описание.Ссылка);
		КонецЕсли;

	КонецЦикла;

	ПоляСвода.Добавить("СУММА(ПроизводствоДетали.Количество) КАК Количество");
	ПоляСвода.Добавить("СУММА(ПроизводствоДетали.Сумма) КАК Сумма");
	ПоляСвода.Добавить(СчетчикДокументов(Измерения));

	Текст = Текст + ";" + Символы.ПС + Символы.ПС + "ВЫБРАТЬ" + Символы.ПС + Символы.Таб
		+ Соединить(ПоляСвода, "," + Символы.ПС + Символы.Таб) + Символы.ПС
		+ "ПОМЕСТИТЬ СводПроизводства" + Символы.ПС
		+ "ИЗ" + Символы.ПС + Символы.Таб + "ПроизводствоДетали КАК ПроизводствоДетали" + Символы.ПС
		+ "СГРУППИРОВАТЬ ПО" + Символы.ПС + Символы.Таб
		+ Соединить(ГруппировкаСвода, "," + Символы.ПС + Символы.Таб);

	Если ПоляИндекса.Количество() > 0 Тогда
		Текст = Текст + Символы.ПС + "ИНДЕКСИРОВАТЬ ПО" + Символы.ПС + Символы.Таб
			+ Соединить(ПоляИндекса, "," + Символы.ПС + Символы.Таб);
	КонецЕсли;

	ПоляВыбора = Новый Массив;
	Соединения = Новый Массив;

	Для Каждого Измерение Из Измерения Цикл

		Описание = ОписаниеИзмеренияПроизводства(Измерение);

		ПоляВыбора.Добавить("Свод." + Описание.Ссылка + " КАК " + Описание.Ссылка);

		Если Описание.Тип = "ref" Тогда

			ПоляВыбора.Добавить(Описание.ВыражениеИмени + " КАК " + Описание.Имя);

			Для Каждого Соединение Из Описание.Соединения Цикл
				Соединения.Добавить(Соединение);
			КонецЦикла;

		КонецЕсли;

	КонецЦикла;

	ПоляВыбора.Добавить("Свод.Количество КАК Количество");
	ПоляВыбора.Добавить("Свод.Сумма КАК Сумма");
	ПоляВыбора.Добавить("Свод.Документов КАК Документов");

	Текст = Текст + ";" + Символы.ПС + Символы.ПС
		+ "ВЫБРАТЬ ПЕРВЫЕ " + Формат(Настройки.Лимит, "ЧГ=0") + Символы.ПС + Символы.Таб
		+ Соединить(ПоляВыбора, "," + Символы.ПС + Символы.Таб) + Символы.ПС
		+ "ИЗ" + Символы.ПС + Символы.Таб + "СводПроизводства КАК Свод";

	Если Соединения.Количество() > 0 Тогда
		Текст = Текст + Символы.ПС + Символы.Таб + Соединить(Соединения, Символы.ПС + Символы.Таб);
	КонецЕсли;

	Текст = Текст + Символы.ПС + "УПОРЯДОЧИТЬ ПО" + Символы.ПС + Символы.Таб
		+ ПорядокПроизводства(Измерения, Настройки.Меры, Настройки.Сортировка);

	// Итоги по деталям: число различных документов по всей выборке, а не сумма
	// счётчиков по строкам свода - один документ попадает во многие строки.
	Возврат Текст + ";" + Символы.ПС + Символы.ПС +
	"ВЫБРАТЬ
	|	СУММА(ПроизводствоДетали.Количество) КАК Количество,
	|	СУММА(ПроизводствоДетали.Сумма) КАК Сумма,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ПроизводствоДетали." + ПолеДокумента(Измерения) + ") КАК Документов
	|ИЗ
	|	ПроизводствоДетали КАК ПроизводствоДетали";

КонецФункции // ТекстЗапросаПроизводства()

Функция ПолеДокумента(Измерения)

	Возврат ?(Измерения.Найти("document") = Неопределено, "Документ", "ДокументВыпуска");

КонецФункции // ПолеДокумента()

Функция СчетчикДокументов(Измерения)

	Возврат "КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ПроизводствоДетали." + ПолеДокумента(Измерения) + ") КАК Документов";

КонецФункции // СчетчикДокументов()

Функция РезультатПроизводства(РезультатДеталей, РезультатИтогов, Измерения, Меры)

	Колонки = Новый Массив;

	Для Каждого Измерение Из Измерения Цикл
		Колонки.Добавить(ОписаниеКолонки(Измерение,
			?(ОписаниеИзмеренияПроизводства(Измерение).Тип = "date", "date", "ref")));
	КонецЦикла;

	Для Каждого Мера Из Меры Цикл
		Колонки.Добавить(ОписаниеКолонки(Мера, "number"));
	КонецЦикла;

	Строки = Новый Массив;

	Выборка = РезультатДеталей.Выбрать();

	Пока Выборка.Следующий() Цикл

		Строка = Новый Массив;

		Для Каждого Измерение Из Измерения Цикл

			Описание = ОписаниеИзмеренияПроизводства(Измерение);

			Если Описание.Тип = "date" Тогда
				Строка.Добавить(MCP_JSON.ДатаВСтрокуКоротко(Выборка[Описание.Ссылка]));

			ИначеЕсли Описание.Тип = "docref" Тогда
				// Подпись документа - его собственное представление.
				Строка.Добавить(ЯчейкаСсылки(Выборка[Описание.Ссылка], Выборка[Описание.Ссылка]));

			Иначе
				Строка.Добавить(ЯчейкаСсылки(Выборка[Описание.Ссылка], Выборка[Описание.Имя]));
			КонецЕсли;

		КонецЦикла;

		Для Каждого Мера Из Меры Цикл
			Строка.Добавить(ЗначениеМерыПроизводства(Выборка, Мера));
		КонецЦикла;

		Строки.Добавить(Строка);

	КонецЦикла;

	Итоги = Новый Структура;

	ВыборкаИтогов = РезультатИтогов.Выбрать();

	Если ВыборкаИтогов.Следующий() Тогда
		Для Каждого Мера Из Меры Цикл
			Итоги.Вставить(Мера, ЗначениеМерыПроизводства(ВыборкаИтогов, Мера));
		КонецЦикла;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("columns", Колонки);
	Результат.Вставить("rows", Строки);
	Результат.Вставить("totals", Итоги);

	Возврат Результат;

КонецФункции // РезультатПроизводства()

Функция ЗначениеМерыПроизводства(Выборка, Мера)

	Если Мера = "amount" Тогда
		Возврат MCP_Утилиты.ВЧисло(Выборка.Сумма);
	КонецЕсли;

	Если Мера = "documents" Тогда
		Возврат MCP_Утилиты.ВЧисло(Выборка.Документов);
	КонецЕсли;

	Возврат MCP_Утилиты.ВЧисло(Выборка.Количество);

КонецФункции // ЗначениеМерыПроизводства()

Функция ИзмеренияПроизводства(Параметры, Вид)

	Допустимые = "product,production_group,department,specification,order,document,day,week,month";

	Если Вид = "consumption" Тогда
		Допустимые = Допустимые + ",material,cost_article";
	КонецЕсли;

	Результат = Новый Массив;
	ВременныхИзмерений = 0;

	Для Каждого Измерение Из MCP_Утилиты.ВМассивСтрок(MCP_Утилиты.Значение(Параметры, "group_by")) Цикл

		Имя = НРег(СокрЛП(Измерение));

		Если Найти("," + Допустимые + ",", "," + Имя + ",") = 0 Тогда
			ВызватьИсключение ОшибкаЗапроса("group_by: unsupported dimension " + Измерение
				+ " (available here: " + Допустимые + ")");
		КонецЕсли;

		Если Имя = "day" ИЛИ Имя = "week" ИЛИ Имя = "month" Тогда
			ВременныхИзмерений = ВременныхИзмерений + 1;
		КонецЕсли;

		Если Результат.Найти(Имя) = Неопределено Тогда
			Результат.Добавить(Имя);
		КонецЕсли;

	КонецЦикла;

	Если ВременныхИзмерений > 1 Тогда
		ВызватьИсключение ОшибкаЗапроса("group_by: only one of day / week / month can be used at a time");
	КонецЕсли;

	Если Результат.Количество() = 0 Тогда
		Результат.Добавить(?(Вид = "output", "product", "material"));
		Результат.Добавить("month");
	КонецЕсли;

	Возврат Результат;

КонецФункции // ИзмеренияПроизводства()

Функция МерыПроизводства(Параметры)

	Допустимые = "qty,amount,documents";

	Результат = Новый Массив;

	Для Каждого Мера Из MCP_Утилиты.ВМассивСтрок(MCP_Утилиты.Значение(Параметры, "measures")) Цикл

		Имя = НРег(СокрЛП(Мера));

		Если Найти("," + Допустимые + ",", "," + Имя + ",") = 0 Тогда
			ВызватьИсключение ОшибкаЗапроса("measures: unsupported measure " + Мера
				+ " (available here: " + Допустимые + ")");
		КонецЕсли;

		Если Результат.Найти(Имя) = Неопределено Тогда
			Результат.Добавить(Имя);
		КонецЕсли;

	КонецЦикла;

	Если Результат.Количество() = 0 Тогда
		Результат.Добавить("qty");
		Результат.Добавить("amount");
	КонецЕсли;

	Возврат Результат;

КонецФункции // МерыПроизводства()

Функция ОписаниеИзмеренияПроизводства(Измерение)

	Ключи = "Поле, Ключ, Ссылка, Имя, Тип, ВыражениеИмени, Соединения";

	Если Измерение = "product" Тогда
		Возврат ОписаниеИзмеренияОборота(Ключи, "Продукция", "Справочник.Номенклатура", "Т_Продукция");

	ИначеЕсли Измерение = "material" Тогда
		Возврат ОписаниеИзмеренияОборота(Ключи, "Затрата", "Справочник.Номенклатура", "Т_Материал");

	ИначеЕсли Измерение = "production_group" Тогда
		Возврат ОписаниеИзмеренияОборота(Ключи, "НоменклатурнаяГруппа",
			"Справочник.НоменклатурныеГруппы", "Т_Группа");

	ИначеЕсли Измерение = "department" Тогда
		Возврат ОписаниеИзмеренияОборота(Ключи, "Подразделение", "Справочник.Подразделения", "Т_Подразделение");

	ИначеЕсли Измерение = "specification" Тогда
		Возврат ОписаниеИзмеренияОборота(Ключи, "Спецификация",
			"Справочник.СпецификацииНоменклатуры", "Т_Спецификация");

	ИначеЕсли Измерение = "cost_article" Тогда
		Возврат ОписаниеИзмеренияОборота(Ключи, "СтатьяЗатрат", "Справочник.СтатьиЗатрат", "Т_Статья");

	ИначеЕсли Измерение = "order" ИЛИ Измерение = "document" Тогда

		// Заказ и документ выпуска - СОСТАВНЫЕ ссылки на документы. Наименования у них
		// нет, соединять не с чем: представление платформа собирает сама, поэтому
		// подпись берётся из той же ссылки уже в BSL.
		Поле = ?(Измерение = "order", "Заказ", "ДокументВыпуска");

		Возврат Новый Структура(Ключи, Поле, "ПроизводствоДетали." + Поле, Поле, Поле,
			"docref", "", Новый Массив);

	КонецЕсли;

	Возврат Новый Структура(Ключи, "Период", "ПроизводствоДетали.Период", "Период", "Период",
		"date", "", Новый Массив);

КонецФункции // ОписаниеИзмеренияПроизводства()

Функция ОписаниеИзмеренияОборота(Ключи, Поле, ИмяСправочника, ПсевдонимТаблицы)

	Соединения = Новый Массив;
	Соединения.Добавить("ЛЕВОЕ СОЕДИНЕНИЕ " + ИмяСправочника + " КАК " + ПсевдонимТаблицы
		+ Символы.ПС + Символы.Таб + "ПО " + ПсевдонимТаблицы + ".Ссылка = Свод." + Поле);

	Возврат Новый Структура(Ключи, Поле,
		БезПустойСсылки("ПроизводствоДетали." + Поле, ИмяСправочника),
		Поле, Поле + "Имя", "ref", ПсевдонимТаблицы + ".Наименование", Соединения);

КонецФункции // ОписаниеИзмеренияОборота()

Функция ПорядокПроизводства(Измерения, Меры, Сортировка)

	Для Каждого Спецификация Из Сортировка Цикл

		Поле = НРег(СокрЛП(Строка(MCP_Утилиты.Значение(Спецификация, "field", ""))));
		Направление = ?(НРег(СокрЛП(Строка(MCP_Утилиты.Значение(Спецификация, "dir", "asc")))) = "desc",
			" УБЫВ", " ВОЗР");

		Если Меры.Найти(Поле) <> Неопределено Тогда

			Если Поле = "amount" Тогда
				Возврат "Сумма" + Направление;
			ИначеЕсли Поле = "documents" Тогда
				Возврат "Документов" + Направление;
			КонецЕсли;

			Возврат "Количество" + Направление;

		КонецЕсли;

		Если Измерения.Найти(Поле) <> Неопределено Тогда

			Описание = ОписаниеИзмеренияПроизводства(Поле);

			Возврат ?(Описание.Тип = "ref", Описание.Имя, Описание.Ссылка) + Направление;

		КонецЕсли;

	КонецЦикла;

	Если ПериодичностьПродаж(Измерения) <> "" Тогда
		Возврат "Период";
	КонецЕсли;

	Возврат "Количество УБЫВ";

КонецФункции // ПорядокПроизводства()

// Фильтры и разрезы чужой модели. Каждый отклоняется с объяснением, чего именно нет
// в этой базе - молчаливое игнорирование дало бы выборку шире запрошенной.
//
Процедура ОтклонитьНеподдержанноеПроизводство(Параметры, Фильтры)

	Если MCP_Утилиты.ВМассивСтрок(MCP_Утилиты.Значение(Фильтры, "warehouse_ids")).Количество() > 0 Тогда
		ВызватьИсключение ОшибкаЗапроса(
			"warehouse_ids is not supported: production registers here are kept by подразделение,"
			+ " not by warehouse - use group_by [""department""]");
	КонецЕсли;

	Если MCP_Утилиты.ВМассивСтрок(MCP_Утилиты.Значение(Фильтры, "firm_ids")).Количество() > 0 Тогда
		ВызватьИсключение ОшибкаЗапроса(
			"firm_ids is not supported: the production registers have no organization dimension");
	КонецЕсли;

	Если MCP_Утилиты.ВМассивСтрок(MCP_Утилиты.Значение(Фильтры, "matrix_ids")).Количество() > 0
		ИЛИ MCP_Утилиты.ВМассивСтрок(MCP_Утилиты.Значение(Фильтры, "composition_type_ids")).Количество() > 0 Тогда
		ВызватьИсключение ОшибкаЗапроса(
			"matrix_ids / composition_type_ids are not supported: this database has no matrix"
			+ " or composition type - use specification as the composition variant");
	КонецЕсли;

	Если MCP_Утилиты.ВМассивСтрок(MCP_Утилиты.Значение(Фильтры, "employee_ids")).Количество() > 0 Тогда
		ВызватьИсключение ОшибкаЗапроса(
			"employee_ids is not supported: the production registers have no employee dimension");
	КонецЕсли;

	ТипОперации = НРег(СокрЛП(Строка(MCP_Утилиты.Значение(Параметры, "operation_type", "assembly"))));

	Если НЕ ПустаяСтрока(ТипОперации) И ТипОперации <> "assembly" Тогда
		ВызватьИсключение ОшибкаЗапроса(
			"operation_type " + ТипОперации + " is not supported: production and disassembly are"
			+ " separate documents in this database, the output register holds output only");
	КонецЕсли;

КонецПроцедуры // ОтклонитьНеподдержанноеПроизводство()

#EndRegion

#Region Разузлование

// Отчёт specification_explode - многоуровневое разузлование состава.
//
// Разворачивается итеративно по уровням, а не рекурсией: на каждом шаге состав всех
// полуфабрикатов уровня берётся ОДНИМ запросом. Рекурсия по одной позиции дала бы
// столько запросов, сколько узлов в дереве.
//
// Три ограничителя, и все три обязательны: max_depth, защита от цикла (позиция,
// уже встреченная в своей же ветке, дальше не раскрывается) и потолок строк.
// Спецификации заводят люди, и «А состоит из Б, Б состоит из А» - не гипотетический
// случай, а обычная опечатка, которая без защиты повесила бы запрос.
//
Функция Разузлование(Параметры)

	ОтклонитьВариантыСостава(Параметры);

	Товары = ТоварыСостава(Параметры);

	Если Товары.Количество() > 1 Тогда
		ВызватьИсключение ОшибкаЗапроса("specification_explode takes a single product_id");
	КонецЕсли;

	Дата = ДатаСостава(Параметры);
	СЦеной = MCP_Утилиты.ВБулево(MCP_Утилиты.Значение(Параметры, "with_cost"));
	Глубина = ГлубинаРазузлования(Параметры);
	ПотолокСтрок = 2000;

	ТипЦен = ?(СЦеной, ТипЦенСостава(Параметры), Неопределено);

	Строки = Новый Массив;
	Обрезано = Ложь;

	// Текущий уровень: что раскрываем дальше. Путь нужен и для колонки path,
	// и для проверки цикла - позиция не должна встретиться в своей же ветке дважды.
	Уровень = Новый Массив;
	Начальный = Новый Структура("Номенклатура, Норма, Путь, Ветка");
	Начальный.Номенклатура = Товары[0];
	Начальный.Норма = КоличествоВыпуска(Параметры);
	Начальный.Путь = "";
	Ветка = Новый Массив;
	Ветка.Добавить(Товары[0]);
	Начальный.Ветка = Ветка;
	Уровень.Добавить(Начальный);

	Для НомерУровня = 1 По Глубина Цикл

		Если Уровень.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;

		Родители = Новый Массив;

		Для Каждого Узел Из Уровень Цикл
			Если Родители.Найти(Узел.Номенклатура) = Неопределено Тогда
				Родители.Добавить(Узел.Номенклатура);
			КонецЕсли;
		КонецЦикла;

		Состав = СоставУровня(Родители, Дата);
		Раскрываемые = ПозицииСоСпецификацией(Состав.ВыгрузитьКолонку("Материал"), Дата);

		Следующий = Новый Массив;

		Для Каждого Узел Из Уровень Цикл

			Найденные = Состав.НайтиСтроки(Новый Структура("Продукция", Узел.Номенклатура));

			Для Каждого СтрокаСостава Из Найденные Цикл

				Если Строки.Количество() >= ПотолокСтрок Тогда
					Обрезано = Истина;
					Прервать;
				КонецЕсли;

				ЕстьСостав = (Раскрываемые.Найти(СтрокаСостава.Материал) <> Неопределено);
				Цикличность = (Узел.Ветка.Найти(СтрокаСостава.Материал) <> Неопределено);

				ЭлементДерева = Новый Структура;
				ЭлементДерева.Вставить("Уровень", НомерУровня);
				ЭлементДерева.Вставить("Путь", Узел.Путь);
				ЭлементДерева.Вставить("Материал", СтрокаСостава.Материал);
				ЭлементДерева.Вставить("МатериалИмя", СтрокаСостава.МатериалИмя);
				ЭлементДерева.Вставить("Артикул", СтрокаСостава.Артикул);
				ЭлементДерева.Вставить("Единица", СтрокаСостава.Единица);
				ЭлементДерева.Вставить("НормаНаЕдиницу", СтрокаСостава.НормаНаЕдиницу);
				ЭлементДерева.Вставить("НормаВсего", Узел.Норма * СтрокаСостава.НормаНаЕдиницу);
				ЭлементДерева.Вставить("ОсновноеСырье", СтрокаСостава.ОсновноеСырье);
				ЭлементДерева.Вставить("ЕстьСостав", ЕстьСостав);
				ЭлементДерева.Вставить("Цикл", Цикличность);
				Строки.Добавить(ЭлементДерева);

				Если ЕстьСостав И НЕ Цикличность И НомерУровня < Глубина Тогда

					Потомок = Новый Структура("Номенклатура, Норма, Путь, Ветка");
					Потомок.Номенклатура = СтрокаСостава.Материал;
					Потомок.Норма = ЭлементДерева.НормаВсего;
					Потомок.Путь = ?(ПустаяСтрока(Узел.Путь), "", Узел.Путь + " / ")
						+ СокрЛП(Строка(СтрокаСостава.МатериалИмя));

					НоваяВетка = Новый Массив;

					Для Каждого Элемент Из Узел.Ветка Цикл
						НоваяВетка.Добавить(Элемент);
					КонецЦикла;

					НоваяВетка.Добавить(СтрокаСостава.Материал);
					Потомок.Ветка = НоваяВетка;

					Следующий.Добавить(Потомок);

				КонецЕсли;

			КонецЦикла;

			Если Обрезано Тогда
				Прервать;
			КонецЕсли;

		КонецЦикла;

		Если Обрезано Тогда
			Прервать;
		КонецЕсли;

		Уровень = Следующий;

	КонецЦикла;

	Возврат РезультатРазузлования(Строки, Товары[0], Дата, ТипЦен, Обрезано);

КонецФункции // Разузлование()

// Состав активных спецификаций для набора позиций - один запрос на уровень.
//
Функция СоставУровня(Товары, Дата)

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Товары", Товары);
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Спецификации", Новый Массив);
	Запрос.УстановитьПараметр("ОтборПоСпецификации", Ложь);

	Запрос.Текст = ТекстАктивныхСпецификаций() + ";" + Символы.ПС + Символы.ПС
		+ ТекстПоследнейСпецификации() + ";" + Символы.ПС + Символы.ПС +
	"ВЫБРАТЬ
	|	Спец.Продукция КАК Продукция,
	|	Комплектующая.Номенклатура КАК Материал,
	|	Т_Материал.Наименование КАК МатериалИмя,
	|	Т_Материал.Артикул КАК Артикул,
	|	Т_Материал.БазоваяЕдиницаИзмерения КАК Единица,
	|	Комплектующая.ОсновноеСырье КАК ОсновноеСырье,
	|	Комплектующая.Количество / Спец.КоличествоВыхода КАК НормаНаЕдиницу
	|ИЗ
	|	АктивныеСпецификации КАК Спец
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВыбраннаяСпецификация КАК Выбранная
	|		ПО Выбранная.Спецификация = Спец.Спецификация
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СпецификацииНоменклатуры.ИсходныеКомплектующие КАК Комплектующая
	|		ПО Комплектующая.Ссылка = Спец.Спецификация
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Т_Материал
	|		ПО Т_Материал.Ссылка = Комплектующая.Номенклатура";

	Пакет = Запрос.ВыполнитьПакет();

	Возврат Пакет[Пакет.ВГраница()].Выгрузить();

КонецФункции // СоставУровня()

// Одна спецификация на товар для разузлования: с максимальной ДатойУтверждения.
//
// Инструменты состава при нескольких активных вариантах отвечают 400 и требуют
// `specification_id`, но разузлование раскрывает дерево - каждый его узел пришлось бы
// уточнять отдельно, и запрос стал бы неотвечаемым. Поэтому здесь берётся самый свежий
// вариант (решение заказчика 2026-09-02). До этого варианты просто складывались, и
// сумма завышалась ровно во столько раз, сколько их у товара.
//
// Отбор в два шага: сначала максимальная дата по товару, затем максимальная ссылка среди
// спецификаций этой даты. Второй шаг - не смысловой, а способ выбрать одну строку
// детерминированно: незаполненные ДатыУтверждения дают ничью, и без него в выдачу
// вернулись бы все участники ничьей.
//
Функция ТекстПоследнейСпецификации()

	Возврат
	"ВЫБРАТЬ
	|	Спец.Продукция КАК Продукция,
	|	МАКСИМУМ(Спец.ДатаУтверждения) КАК ДатаУтверждения
	|ПОМЕСТИТЬ ПоследняяДатаСостава
	|ИЗ
	|	АктивныеСпецификации КАК Спец
	|СГРУППИРОВАТЬ ПО
	|	Спец.Продукция
	|ИНДЕКСИРОВАТЬ ПО
	|	Продукция;
	|
	|ВЫБРАТЬ
	|	Спец.Продукция КАК Продукция,
	|	МАКСИМУМ(Спец.Спецификация) КАК Спецификация
	|ПОМЕСТИТЬ ВыбраннаяСпецификация
	|ИЗ
	|	АктивныеСпецификации КАК Спец
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПоследняяДатаСостава КАК Последняя
	|		ПО Последняя.Продукция = Спец.Продукция
	|			И Последняя.ДатаУтверждения = Спец.ДатаУтверждения
	|СГРУППИРОВАТЬ ПО
	|	Спец.Продукция
	|ИНДЕКСИРОВАТЬ ПО
	|	Продукция";

КонецФункции // ТекстПоследнейСпецификации()

// Из набора позиций - те, у которых есть активная спецификация. По этому признаку
// заполняется has_spec и решается, раскрывать ли позицию дальше.
//
Функция ПозицииСоСпецификацией(Позиции, Дата)

	Результат = Новый Массив;

	Если Позиции.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Товары", Позиции);
	Запрос.УстановитьПараметр("Дата", Дата);

	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Выход.Номенклатура КАК Номенклатура
	|ИЗ
	|	Справочник.СпецификацииНоменклатуры.ВыходныеИзделия КАК Выход
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СпецификацииНоменклатуры КАК Спец
	|		ПО Спец.Ссылка = Выход.Ссылка
	|ГДЕ
	|	Спец.Активная
	|	И НЕ Спец.ПометкаУдаления
	|	И Выход.Номенклатура В (&Товары)
	|	И (Спец.ДатаУтверждения <= &Дата
	|		ИЛИ Спец.ДатаУтверждения = ДАТАВРЕМЯ(1, 1, 1))";

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Выборка.Номенклатура);
	КонецЦикла;

	Возврат Результат;

КонецФункции // ПозицииСоСпецификацией()

Функция РезультатРазузлования(Строки, Товар, Дата, ТипЦен, Обрезано)

	Цены = ?(ТипЦен = Неопределено, Неопределено, ЦеныПозиций(Строки, Дата, ТипЦен));

	Колонки = Новый Массив;
	Колонки.Добавить(ОписаниеКолонки("level", "number"));
	Колонки.Добавить(ОписаниеКолонки("path", "string"));
	Колонки.Добавить(ОписаниеКолонки("material", "ref"));
	Колонки.Добавить(ОписаниеКолонки("article", "string"));
	Колонки.Добавить(ОписаниеКолонки("unit", "string"));
	Колонки.Добавить(ОписаниеКолонки("qty_per_unit", "number"));
	Колонки.Добавить(ОписаниеКолонки("qty_total", "number"));

	Если Цены <> Неопределено Тогда
		Колонки.Добавить(ОписаниеКолонки("price", "number"));
		Колонки.Добавить(ОписаниеКолонки("amount", "number"));
		Колонки.Добавить(ОписаниеКолонки("price_source", "string"));
	КонецЕсли;

	Колонки.Добавить(ОписаниеКолонки("is_main_raw", "string"));
	Колонки.Добавить(ОписаниеКолонки("has_spec", "string"));
	Колонки.Добавить(ОписаниеКолонки("cycle", "string"));

	Результирующие = Новый Массив;
	Итого = 0;
	БезЦены = 0;

	Для Каждого СтрокаДанных Из Строки Цикл

		Ячейки = Новый Массив;
		Ячейки.Добавить(СтрокаДанных.Уровень);
		Ячейки.Добавить(СтрокаДанных.Путь);
		Ячейки.Добавить(ЯчейкаСсылки(СтрокаДанных.Материал, СтрокаДанных.МатериалИмя));
		Ячейки.Добавить(СокрЛП(Строка(СтрокаДанных.Артикул)));
		Ячейки.Добавить(СокрЛП(Строка(СтрокаДанных.Единица)));
		Ячейки.Добавить(MCP_Утилиты.ВЧисло(СтрокаДанных.НормаНаЕдиницу));
		Ячейки.Добавить(MCP_Утилиты.ВЧисло(СтрокаДанных.НормаВсего));

		Если Цены <> Неопределено Тогда

			Цена = 0;
			ИсточникЦены = "none";

			Оценка = Цены.Получить(СтрокаДанных.Материал);

			Если Оценка <> Неопределено Тогда
				Цена = Оценка.Цена;
				ИсточникЦены = Оценка.Источник;
			ИначеЕсли НЕ СтрокаДанных.ЕстьСостав Тогда
				// Считаем только листья: полуфабрикат в итог и не входит - его
				// стоимость набирается из собственных комплектующих уровнем ниже.
				БезЦены = БезЦены + 1;
			КонецЕсли;

			Сумма = MCP_Утилиты.ВЧисло(СтрокаДанных.НормаВсего) * Цена;

			Ячейки.Добавить(Цена);
			Ячейки.Добавить(Окр(Сумма, 2));
			Ячейки.Добавить(ИсточникЦены);

			// В итог попадают только листья: сумма по полуфабрикату уже включает
			// стоимость его собственных комплектующих, и сложение всех уровней
			// посчитало бы одно и то же сырьё дважды.
			Если НЕ СтрокаДанных.ЕстьСостав Тогда
				Итого = Итого + Сумма;
			КонецЕсли;

		КонецЕсли;

		Ячейки.Добавить(?(СтрокаДанных.ОсновноеСырье, "yes", "no"));
		Ячейки.Добавить(?(СтрокаДанных.ЕстьСостав, "yes", "no"));
		Ячейки.Добавить(?(СтрокаДанных.Цикл, "yes", "no"));

		Результирующие.Добавить(Ячейки);

	КонецЦикла;

	Итоги = Новый Структура;

	Если Цены <> Неопределено Тогда
		Итоги.Вставить("amount", Окр(Итого, 2));
		Итоги.Вставить("rows_without_price", БезЦены);
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("columns", Колонки);
	Результат.Вставить("rows", Результирующие);
	Результат.Вставить("totals", Итоги);
	Результат.Вставить("product", ЯчейкаСсылки(Товар, Товар));
	Результат.Вставить("date", MCP_JSON.ДатаВСтрокуКоротко(Дата));
	Результат.Вставить("truncated", Обрезано);

	Возврат Результат;

КонецФункции // РезультатРазузлования()

Функция ЦеныПозиций(Строки, Дата, ТипЦен)

	Позиции = Новый Массив;

	Для Каждого Строка Из Строки Цикл
		Если Позиции.Найти(Строка.Материал) = Неопределено Тогда
			Позиции.Добавить(Строка.Материал);
		КонецЕсли;
	КонецЦикла;

	Результат = Новый Соответствие;

	Если Позиции.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("ТипЦен", ТипЦен);
	Запрос.УстановитьПараметр("Позиции", Позиции);
	Запрос.УстановитьПараметр("НачалоСписаний", ДобавитьМесяц(НачалоДня(Дата), -12));

	// Тот же каскад, что и в specification_cost: прайс -> себестоимость остатка ->
	// цена списания. Три отдельных запроса, а не пакет с временными таблицами: список
	// позиций здесь уже собран в памяти разузлованием.
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Цены.Номенклатура КАК Номенклатура,
	|	Цены.Цена КАК Цена
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&Дата,
	|		ТипЦен = &ТипЦен
	|			И Номенклатура В (&Позиции)) КАК Цены;
	|
	|ВЫБРАТЬ
	|	Остатки.Номенклатура КАК Номенклатура,
	|	СУММА(Остатки.СтоимостьОстаток) / СУММА(Остатки.КоличествоОстаток) КАК Цена
	|ИЗ
	|	РегистрНакопления.ПартииТоваровНаСкладах.Остатки(&Дата,
	|		Номенклатура В (&Позиции)) КАК Остатки
	|СГРУППИРОВАТЬ ПО
	|	Остатки.Номенклатура
	|ИМЕЮЩИЕ
	|	СУММА(Остатки.КоличествоОстаток) > 0
	|	И СУММА(Остатки.СтоимостьОстаток) > 0;
	|
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(Обороты.Затрата КАК Справочник.Номенклатура) КАК Номенклатура,
	|	СУММА(Обороты.СуммаОборот) / СУММА(Обороты.КоличествоОборот) КАК Цена
	|ИЗ
	|	РегистрНакопления.ЗатратыНаВыпускПродукции.Обороты(&НачалоСписаний, &Дата, ,
	|		Затрата ССЫЛКА Справочник.Номенклатура
	|			И Затрата В (&Позиции)) КАК Обороты
	|СГРУППИРОВАТЬ ПО
	|	ВЫРАЗИТЬ(Обороты.Затрата КАК Справочник.Номенклатура)
	|ИМЕЮЩИЕ
	|	СУММА(Обороты.КоличествоОборот) > 0
	|	И СУММА(Обороты.СуммаОборот) > 0";

	Пакет = Запрос.ВыполнитьПакет();

	// Порядок обхода обратный приоритету: каждый следующий источник перекрывает
	// предыдущий, поэтому прайс кладётся последним и остаётся сверху.
	ЗаполнитьЦеныИсточника(Результат, Пакет[2], "consumption");
	ЗаполнитьЦеныИсточника(Результат, Пакет[1], "stock_cost");
	ЗаполнитьЦеныИсточника(Результат, Пакет[0], "price");

	Возврат Результат;

КонецФункции // ЦеныПозиций()

Функция ЗаполнитьЦеныИсточника(Результат, РезультатЗапроса, Источник)

	Выборка = РезультатЗапроса.Выбрать();

	Пока Выборка.Следующий() Цикл

		Цена = MCP_Утилиты.ВЧисло(Выборка.Цена);

		// Отрицательная средняя - это красный остаток или сторно, а не цена материала.
		// Такую оценку пропускаем: пусть строку закроет следующий источник каскада.
		Если Цена <= 0 Тогда
			Продолжить;
		КонецЕсли;

		Результат.Вставить(Выборка.Номенклатура, Новый Структура("Цена, Источник", Цена, Источник));

	КонецЦикла;

	Возврат Результат;

КонецФункции // ЗаполнитьЦеныИсточника()

Функция ГлубинаРазузлования(Параметры)

	Значение = MCP_Утилиты.ВЧисло(MCP_Утилиты.Значение(Параметры, "max_depth"));

	Если Значение <= 0 Тогда
		Возврат 3;
	КонецЕсли;

	Возврат Мин(Значение, 10);

КонецФункции // ГлубинаРазузлования()

// Отчёт specification_versions - история состава товара.
//
// Документа, версионирующего состав, в этой базе нет, поэтому версией считается
// ОТДЕЛЬНАЯ СПЕЦИФИКАЦИЯ товара, а порядок задаётся ДатойУтверждения. Из этого следует
// ограничение, о котором честно сказано в ответе: правки ВНУТРИ одной спецификации
// историей не фиксируются и в диффы не попадают.
//
Функция ВерсииСостава(Параметры)

	ОтклонитьВариантыСостава(Параметры);

	Товары = ТоварыСостава(Параметры);

	Если Товары.Количество() > 1 Тогда
		ВызватьИсключение ОшибкаЗапроса("specification_versions takes a single product_id");
	КонецЕсли;

	Товар = Товары[0];
	Лимит = Мин(?(MCP_Утилиты.ВЧисло(MCP_Утилиты.Значение(Параметры, "limit")) <= 0, 10,
		MCP_Утилиты.ВЧисло(MCP_Утилиты.Значение(Параметры, "limit"))), 50);

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Товар", Товар);

	Запрос.Текст =
	"ВЫБРАТЬ
	|	Спец.Ссылка КАК Спецификация,
	|	Спец.Наименование КАК СпецификацияИмя,
	|	Спец.ВидСпецификации КАК ВидСпецификации,
	|	Спец.Состояние КАК Состояние,
	|	Спец.КодВерсии КАК КодВерсии,
	|	Спец.Активная КАК Активная,
	|	Спец.ДатаУтверждения КАК ДатаУтверждения,
	|	ВЫБОР
	|		КОГДА СУММА(Выход.Количество) > 0
	|			ТОГДА СУММА(Выход.Количество)
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК КоличествоВыхода
	|ИЗ
	|	Справочник.СпецификацииНоменклатуры.ВыходныеИзделия КАК Выход
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СпецификацииНоменклатуры КАК Спец
	|		ПО Спец.Ссылка = Выход.Ссылка
	|ГДЕ
	|	Выход.Номенклатура = &Товар
	|	И НЕ Спец.ПометкаУдаления
	|СГРУППИРОВАТЬ ПО
	|	Спец.Ссылка,
	|	Спец.Наименование,
	|	Спец.ВидСпецификации,
	|	Спец.Состояние,
	|	Спец.КодВерсии,
	|	Спец.Активная,
	|	Спец.ДатаУтверждения
	|УПОРЯДОЧИТЬ ПО
	|	ДатаУтверждения УБЫВ,
	|	СпецификацияИмя";

	Выборка = Запрос.Выполнить().Выбрать();

	Версии = Новый Массив;

	Пока Выборка.Следующий() Цикл

		Версия = Новый Структура;
		Версия.Вставить("Спецификация", Выборка.Спецификация);
		Версия.Вставить("Имя", Выборка.СпецификацияИмя);
		Версия.Вставить("Вид", Выборка.ВидСпецификации);
		Версия.Вставить("Состояние", Выборка.Состояние);
		Версия.Вставить("КодВерсии", Выборка.КодВерсии);
		Версия.Вставить("Активная", Выборка.Активная);
		Версия.Вставить("Дата", Выборка.ДатаУтверждения);
		Версия.Вставить("КоличествоВыхода", Выборка.КоличествоВыхода);
		Версии.Добавить(Версия);

	КонецЦикла;

	Возврат РезультатВерсий(Товар, Версии, Лимит);

КонецФункции // ВерсииСостава()

Функция РезультатВерсий(Товар, Версии, Лимит)

	Составы = Новый Соответствие;

	Для Каждого Версия Из Версии Цикл
		Составы.Вставить(Версия.Спецификация, МатериалыСпецификации(Версия));
	КонецЦикла;

	Отдаваемые = Новый Массив;

	Для Индекс = 0 По Версии.ВГраница() Цикл

		Если Отдаваемые.Количество() >= Лимит Тогда
			Прервать;
		КонецЕсли;

		Версия = Версии[Индекс];
		Материалы = Составы.Получить(Версия.Спецификация);
		// Предыдущая версия - следующая по списку: список отсортирован по убыванию даты.
		Предыдущая = ?(Индекс < Версии.ВГраница(), Составы.Получить(Версии[Индекс + 1].Спецификация),
			Неопределено);

		Запись = Новый Структура;
		Запись.Вставить("date", MCP_JSON.ДатаВСтрокуКоротко(Версия.Дата));
		Запись.Вставить("specification", ЯчейкаСсылки(Версия.Спецификация, Версия.Имя));
		Запись.Вставить("specification_kind", СокрЛП(Строка(Версия.Вид)));
		Запись.Вставить("state", СокрЛП(Строка(Версия.Состояние)));
		Запись.Вставить("version", СокрЛП(Строка(Версия.КодВерсии)));
		Запись.Вставить("is_active", Версия.Активная);
		Запись.Вставить("is_first", Индекс = Версии.ВГраница());
		Запись.Вставить("materials", СписокМатериалов(Материалы));
		Запись.Вставить("changes", РазницаСоставов(Материалы, Предыдущая));

		Отдаваемые.Добавить(Запись);

	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("product", ЯчейкаСсылки(Товар, Товар));
	Результат.Вставить("total_versions", Версии.Количество());
	Результат.Вставить("versions", Отдаваемые);
	// Честная оговорка: версия здесь - отдельная спецификация, а не правка внутри неё.
	Результат.Вставить("note",
		"a version here is a separate Справочник.СпецификацииНоменклатуры ordered by"
		+ " ДатаУтверждения: this database does not journal edits made inside one specification");

	Возврат Результат;

КонецФункции // РезультатВерсий()

Функция МатериалыСпецификации(Версия)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Спецификация", Версия.Спецификация);

	Запрос.Текст =
	"ВЫБРАТЬ
	|	Комплектующая.Номенклатура КАК Материал,
	|	Т_Материал.Наименование КАК МатериалИмя,
	|	СУММА(Комплектующая.Количество) КАК Количество
	|ИЗ
	|	Справочник.СпецификацииНоменклатуры.ИсходныеКомплектующие КАК Комплектующая
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Т_Материал
	|		ПО Т_Материал.Ссылка = Комплектующая.Номенклатура
	|ГДЕ
	|	Комплектующая.Ссылка = &Спецификация
	|СГРУППИРОВАТЬ ПО
	|	Комплектующая.Номенклатура,
	|	Т_Материал.Наименование";

	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		Запись = Новый Структура("Материал, Имя, Норма");
		Запись.Материал = Выборка.Материал;
		Запись.Имя = Выборка.МатериалИмя;
		Запись.Норма = MCP_Утилиты.ВЧисло(Выборка.Количество) / Версия.КоличествоВыхода;
		Результат.Вставить(Выборка.Материал, Запись);

	КонецЦикла;

	Возврат Результат;

КонецФункции // МатериалыСпецификации()

Функция СписокМатериалов(Материалы)

	Результат = Новый Массив;

	Для Каждого Элемент Из Материалы Цикл

		Запись = Новый Структура;
		Запись.Вставить("material", ЯчейкаСсылки(Элемент.Значение.Материал, Элемент.Значение.Имя));
		Запись.Вставить("qty_per_unit", Элемент.Значение.Норма);
		Результат.Добавить(Запись);

	КонецЦикла;

	Возврат Результат;

КонецФункции // СписокМатериалов()

Функция РазницаСоставов(Текущие, Предыдущие)

	Добавленные = Новый Массив;
	Убранные = Новый Массив;
	Измененные = Новый Массив;

	Если Предыдущие <> Неопределено Тогда

		Для Каждого Элемент Из Текущие Цикл

			Было = Предыдущие.Получить(Элемент.Ключ);

			Если Было = Неопределено Тогда
				Добавленные.Добавить(ЯчейкаСсылки(Элемент.Значение.Материал, Элемент.Значение.Имя));

			ИначеЕсли Было.Норма <> Элемент.Значение.Норма Тогда

				Запись = Новый Структура;
				Запись.Вставить("material", ЯчейкаСсылки(Элемент.Значение.Материал, Элемент.Значение.Имя));
				Запись.Вставить("qty_before", Было.Норма);
				Запись.Вставить("qty_after", Элемент.Значение.Норма);
				Измененные.Добавить(Запись);

			КонецЕсли;

		КонецЦикла;

		Для Каждого Элемент Из Предыдущие Цикл
			Если Текущие.Получить(Элемент.Ключ) = Неопределено Тогда
				Убранные.Добавить(ЯчейкаСсылки(Элемент.Значение.Материал, Элемент.Значение.Имя));
			КонецЕсли;
		КонецЦикла;

	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("added", Добавленные);
	Результат.Вставить("removed", Убранные);
	Результат.Вставить("changed", Измененные);

	Возврат Результат;

КонецФункции // РазницаСоставов()

#EndRegion

#Region ПроизводственныйДокумент

// Отчёт production_document - разбор одного производственного документа.
//
// Контракт разбирает документ «Производство»; здесь его роль играет
// ОтчетПроизводстваЗаСмену - основной документ выпуска в УПП. Документ другого типа
// отклоняется явно, а не отдаётся пустой карточкой: пустой ответ читался бы как
// "документ есть, но в нём ничего нет".
//
// Плановая стоимость (specification_cost) и фактическая (здесь) - разные вещи:
// в карточке лежат суммы, которые распределила себестоимость по регистрам, а не
// нормативные цены из состава. Их сопоставление и есть смысл инструмента.
//
Функция ПроизводственныйДокумент(Параметры)

	Ссылка = ДокументВыпускаПоИдентификатору(Параметры);

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);

	Запрос.Текст =
	"ВЫБРАТЬ
	|	Документ.Ссылка КАК Ссылка,
	|	Документ.Номер КАК Номер,
	|	Документ.Дата КАК Дата,
	|	Документ.Проведен КАК Проведен,
	|	Документ.ПометкаУдаления КАК ПометкаУдаления,
	|	Документ.Организация КАК Организация,
	|	Т_Организация.Наименование КАК ОрганизацияИмя,
	|	Документ.Склад КАК Склад,
	|	Т_Склад.Наименование КАК СкладИмя,
	|	Документ.Подразделение КАК Подразделение,
	|	Т_Подразделение.Наименование КАК ПодразделениеИмя,
	|	Документ.Ответственный КАК Ответственный,
	|	Т_Ответственный.Наименование КАК ОтветственныйИмя,
	|	Документ.Комментарий КАК Комментарий
	|ИЗ
	|	Документ.ОтчетПроизводстваЗаСмену КАК Документ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации КАК Т_Организация
	|		ПО Т_Организация.Ссылка = Документ.Организация
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Склады КАК Т_Склад
	|		ПО Т_Склад.Ссылка = Документ.Склад
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Подразделения КАК Т_Подразделение
	|		ПО Т_Подразделение.Ссылка = Документ.Подразделение
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК Т_Ответственный
	|		ПО Т_Ответственный.Ссылка = Документ.Ответственный
	|ГДЕ
	|	Документ.Ссылка = &Ссылка
	|;
	|
	|ВЫБРАТЬ
	|	СтрокаПродукции.Номенклатура КАК Номенклатура,
	|	Т_Номенклатура.Наименование КАК НоменклатураИмя,
	|	СтрокаПродукции.Количество КАК Количество,
	|	СтрокаПродукции.ЕдиницаИзмерения КАК Единица,
	|	СтрокаПродукции.НоменклатурнаяГруппа КАК Группа,
	|	Т_Группа.Наименование КАК ГруппаИмя,
	|	СтрокаПродукции.Спецификация КАК Спецификация,
	|	Т_Спецификация.Наименование КАК СпецификацияИмя,
	|	СтрокаПродукции.Качество КАК Качество
	|ИЗ
	|	Документ.ОтчетПроизводстваЗаСмену.Продукция КАК СтрокаПродукции
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Т_Номенклатура
	|		ПО Т_Номенклатура.Ссылка = СтрокаПродукции.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.НоменклатурныеГруппы КАК Т_Группа
	|		ПО Т_Группа.Ссылка = СтрокаПродукции.НоменклатурнаяГруппа
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СпецификацииНоменклатуры КАК Т_Спецификация
	|		ПО Т_Спецификация.Ссылка = СтрокаПродукции.Спецификация
	|ГДЕ
	|	СтрокаПродукции.Ссылка = &Ссылка
	|УПОРЯДОЧИТЬ ПО
	|	СтрокаПродукции.НомерСтроки
	|;
	|
	|ВЫБРАТЬ
	|	Материалы.Номенклатура КАК Номенклатура,
	|	Т_Номенклатура.Наименование КАК НоменклатураИмя,
	|	Материалы.Количество КАК Количество,
	|	Материалы.ЕдиницаИзмерения КАК Единица,
	|	Материалы.СтатьяЗатрат КАК СтатьяЗатрат,
	|	Т_Статья.Наименование КАК СтатьяЗатратИмя,
	|	Материалы.Спецификация КАК Спецификация
	|ИЗ
	|	Документ.ОтчетПроизводстваЗаСмену.Материалы КАК Материалы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Т_Номенклатура
	|		ПО Т_Номенклатура.Ссылка = Материалы.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СтатьиЗатрат КАК Т_Статья
	|		ПО Т_Статья.Ссылка = Материалы.СтатьяЗатрат
	|ГДЕ
	|	Материалы.Ссылка = &Ссылка
	|УПОРЯДОЧИТЬ ПО
	|	Материалы.НомерСтроки
	|;
	|
	|ВЫБРАТЬ
	|	Выпуск.Продукция КАК Номенклатура,
	|	Т_Номенклатура.Наименование КАК НоменклатураИмя,
	|	СУММА(Выпуск.Количество) КАК Количество,
	|	СУММА(Выпуск.Стоимость) КАК Сумма
	|ИЗ
	|	РегистрНакопления.ВыпускПродукции КАК Выпуск
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Т_Номенклатура
	|		ПО Т_Номенклатура.Ссылка = Выпуск.Продукция
	|ГДЕ
	|	Выпуск.ДокументВыпуска = &Ссылка
	|СГРУППИРОВАТЬ ПО
	|	Выпуск.Продукция,
	|	Т_Номенклатура.Наименование
	|;
	|
	|ВЫБРАТЬ
	|	Затраты.Затрата КАК Затрата,
	|	Затраты.Продукция КАК Продукция,
	|	Т_Продукция.Наименование КАК ПродукцияИмя,
	|	СУММА(Затраты.Количество) КАК Количество,
	|	СУММА(Затраты.Сумма) КАК Сумма
	|ИЗ
	|	РегистрНакопления.ЗатратыНаВыпускПродукции КАК Затраты
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Т_Продукция
	|		ПО Т_Продукция.Ссылка = Затраты.Продукция
	|ГДЕ
	|	Затраты.ДокументВыпуска = &Ссылка
	|	И Затраты.Затрата ССЫЛКА Справочник.Номенклатура
	|СГРУППИРОВАТЬ ПО
	|	Затраты.Затрата,
	|	Затраты.Продукция,
	|	Т_Продукция.Наименование";

	Пакет = Запрос.ВыполнитьПакет();

	Возврат КарточкаДокумента(Пакет);

КонецФункции // ПроизводственныйДокумент()

Функция КарточкаДокумента(Пакет)

	ВыборкаШапки = Пакет[0].Выбрать();

	Если НЕ ВыборкаШапки.Следующий() Тогда
		ВызватьИсключение ОшибкаЗапроса("document not found");
	КонецЕсли;

	Документ = Новый Структура;
	Документ.Вставить("id", Строка(ВыборкаШапки.Ссылка.УникальныйИдентификатор()));
	Документ.Вставить("number", СокрЛП(Строка(ВыборкаШапки.Номер)));
	Документ.Вставить("date", MCP_JSON.ДатаВСтроку(ВыборкаШапки.Дата));
	Документ.Вставить("posted", ВыборкаШапки.Проведен);
	Документ.Вставить("deletion_mark", ВыборкаШапки.ПометкаУдаления);
	Документ.Вставить("firm", ЯчейкаСсылки(ВыборкаШапки.Организация, ВыборкаШапки.ОрганизацияИмя));
	Документ.Вставить("warehouse", ЯчейкаСсылки(ВыборкаШапки.Склад, ВыборкаШапки.СкладИмя));
	Документ.Вставить("department", ЯчейкаСсылки(ВыборкаШапки.Подразделение, ВыборкаШапки.ПодразделениеИмя));
	Документ.Вставить("responsible", ЯчейкаСсылки(ВыборкаШапки.Ответственный, ВыборкаШапки.ОтветственныйИмя));
	Документ.Вставить("comment", СокрЛП(Строка(ВыборкаШапки.Комментарий)));

	Продукция = Новый Массив;
	Выборка = Пакет[1].Выбрать();

	Пока Выборка.Следующий() Цикл

		Запись = Новый Структура;
		Запись.Вставить("product", ЯчейкаСсылки(Выборка.Номенклатура, Выборка.НоменклатураИмя));
		Запись.Вставить("qty", MCP_Утилиты.ВЧисло(Выборка.Количество));
		Запись.Вставить("unit", СокрЛП(Строка(Выборка.Единица)));
		Запись.Вставить("production_group", ЯчейкаСсылки(Выборка.Группа, Выборка.ГруппаИмя));
		Запись.Вставить("specification", ЯчейкаСсылки(Выборка.Спецификация, Выборка.СпецификацияИмя));
		Запись.Вставить("quality", СокрЛП(Строка(Выборка.Качество)));
		Продукция.Добавить(Запись);

	КонецЦикла;

	Материалы = Новый Массив;
	Выборка = Пакет[2].Выбрать();

	Пока Выборка.Следующий() Цикл

		Запись = Новый Структура;
		Запись.Вставить("material", ЯчейкаСсылки(Выборка.Номенклатура, Выборка.НоменклатураИмя));
		Запись.Вставить("qty", MCP_Утилиты.ВЧисло(Выборка.Количество));
		Запись.Вставить("unit", СокрЛП(Строка(Выборка.Единица)));
		Запись.Вставить("cost_article", ЯчейкаСсылки(Выборка.СтатьяЗатрат, Выборка.СтатьяЗатратИмя));
		Материалы.Добавить(Запись);

	КонецЦикла;

	// Движения регистров - это ФАКТ: то, что реально записала себестоимость.
	// Табличные части выше - то, что ввели руками. Расхождение между ними и есть
	// самое интересное в этой карточке.
	Выпуск = Новый Массив;
	СуммаВыпуска = 0;
	КоличествоВыпуска = 0;
	Выборка = Пакет[3].Выбрать();

	Пока Выборка.Следующий() Цикл

		Запись = Новый Структура;
		Запись.Вставить("product", ЯчейкаСсылки(Выборка.Номенклатура, Выборка.НоменклатураИмя));
		Запись.Вставить("qty", MCP_Утилиты.ВЧисло(Выборка.Количество));
		Запись.Вставить("amount", MCP_Утилиты.ВЧисло(Выборка.Сумма));
		Выпуск.Добавить(Запись);

		СуммаВыпуска = СуммаВыпуска + MCP_Утилиты.ВЧисло(Выборка.Сумма);
		КоличествоВыпуска = КоличествоВыпуска + MCP_Утилиты.ВЧисло(Выборка.Количество);

	КонецЦикла;

	Списание = Новый Массив;
	СуммаСписания = 0;
	Выборка = Пакет[4].Выбрать();

	Пока Выборка.Следующий() Цикл

		Запись = Новый Структура;
		Запись.Вставить("material", ЯчейкаСсылки(Выборка.Затрата, Выборка.Затрата));
		Запись.Вставить("product", ЯчейкаСсылки(Выборка.Продукция, Выборка.ПродукцияИмя));
		Запись.Вставить("qty", MCP_Утилиты.ВЧисло(Выборка.Количество));
		Запись.Вставить("amount", MCP_Утилиты.ВЧисло(Выборка.Сумма));
		Списание.Добавить(Запись);

		СуммаСписания = СуммаСписания + MCP_Утилиты.ВЧисло(Выборка.Сумма);

	КонецЦикла;

	Итоги = Новый Структура;
	Итоги.Вставить("output_qty", КоличествоВыпуска);
	Итоги.Вставить("cost_received", Окр(СуммаВыпуска, 2));
	Итоги.Вставить("cost_written_off", Окр(СуммаСписания, 2));
	Итоги.Вставить("difference", Окр(СуммаВыпуска - СуммаСписания, 2));

	Результат = Новый Структура;
	Результат.Вставить("document", Документ);
	Результат.Вставить("products", Продукция);
	Результат.Вставить("materials", Материалы);
	Результат.Вставить("output_movements", Выпуск);
	Результат.Вставить("consumption_movements", Списание);
	Результат.Вставить("summary", Итоги);
	// В этой конфигурации в производстве нет ни оплаты труда, ни накладных расходов
	// как отдельных сумм карточки: они распределяются отдельными механизмами.
	Результат.Вставить("note",
		"cost_written_off is what the costing mechanism actually posted to"
		+ " ЗатратыНаВыпускПродукции; the materials table above is what was entered by hand");

	Возврат Результат;

КонецФункции // КарточкаДокумента()

Функция ДокументВыпускаПоИдентификатору(Параметры)

	Значение = MCP_Утилиты.Значение(Параметры, "document_id");

	УИД = MCP_Утилиты.УникальныйИдентификаторИзСтроки(Значение);

	Если УИД = Неопределено Тогда
		ВызватьИсключение ОшибкаЗапроса("document_id is required (UUID)");
	КонецЕсли;

	Ссылка = Документы.ОтчетПроизводстваЗаСмену.ПолучитьСсылку(УИД);

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Документ.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ОтчетПроизводстваЗаСмену КАК Документ
	|ГДЕ
	|	Документ.Ссылка = &Ссылка";

	Если Запрос.Выполнить().Пустой() Тогда
		ВызватьИсключение ОшибкаЗапроса(
			"document not found: production_document reads ОтчетПроизводстваЗаСмену;"
			+ " get the id from production_output with group_by [""document""]");
	КонецЕсли;

	Возврат Ссылка;

КонецФункции // ДокументВыпускаПоИдентификатору()

#EndRegion

#Region Админ

// Поддерживается ли админ-действие. Симметрично ОтчетПоддерживается(): гейт показывает
// инструмент по скоупу, поэтому нереализованное действие должно отвечать понятным 400,
// а не падать.
//
Функция ДействиеПоддерживается(Действие) Экспорт

	Реализованные = "event_log,object_history,find_document";

	Возврат Найти("," + Реализованные + ",", "," + СокрЛП(Строка(Действие)) + ",") > 0;

КонецФункции // ДействиеПоддерживается()

// Диспетчер админ-действий. event_log и object_history - одна и та же выгрузка журнала
// с разным отбором: первый спрашивает "что делал пользователь / что привело к ошибке",
// второй - "кто и когда трогал этот объект".
//
Функция ВыполнитьДействиеАдмина(Действие, Параметры) Экспорт

	Если ТипЗнч(Параметры) <> Тип("Соответствие") И ТипЗнч(Параметры) <> Тип("Структура") Тогда
		Параметры = Новый Соответствие;
	КонецЕсли;

	Если Действие = "event_log" ИЛИ Действие = "object_history" Тогда
		Возврат ЧитатьЖурналРегистрации(Параметры);

	ИначеЕсли Действие = "find_document" Тогда
		Возврат НайтиДокумент(Параметры);

	КонецЕсли;

	ВызватьИсключение ОшибкаЗапроса("Unknown admin action: " + Строка(Действие));

КонецФункции // ВыполнитьДействиеАдмина()

// Чтение журнала регистрации.
//
// Выгрузка идёт в ПРИВИЛЕГИРОВАННОМ РЕЖИМЕ - чтобы не расширять права ИБ-пользователя,
// под которым работает HTTP-сервис: граница доступа здесь - скоуп mcp:admin:eventlog
// (журнал содержит персональные данные), а не права пользователя 1С.
//
// Параметры (из тела запроса):
//  period      - {from,to}     - окно выгрузки (по умолчанию текущие сутки);
//  level       - Строка|Массив - error | warning | information | note;
//  user        - Строка        - подстрока имени или ФИО ИБ-пользователя;
//  session     - Число         - номер сеанса;
//  events      - Массив        - имена событий ("_$Data$_.Post", "_$Data$_.Update", ...);
//  object_type - Строка        - "Document.Имя" или "Catalog.Имя";
//  object_id   - Строка        - UUID объекта (вместе с object_type - отбор по Данным);
//  limit       - Число         - максимум событий (по умолчанию 100, не более 500).
//
Функция ЧитатьЖурналРегистрации(Параметры)

	Начало = Неопределено;
	Окончание = Неопределено;

	// Период с СОХРАНЕНИЕМ времени суток: узкое окно критично для производительности.
	// На нагруженной базе выгрузка за полные сутки уходит в таймаут.
	РазобратьПериодЖурнала(MCP_Утилиты.Значение(Параметры, "period"), Начало, Окончание);

	Лимит = БезопасныйЛимит(MCP_Утилиты.ВЧисло(MCP_Утилиты.Значение(Параметры, "limit")), 100, 500);

	Отбор = Новый Структура;
	Отбор.Вставить("ДатаНачала", Начало);
	Отбор.Вставить("ДатаОкончания", Окончание);

	Уровни = УровниЖурнала(MCP_Утилиты.Значение(Параметры, "level"));

	Если Уровни <> Неопределено Тогда
		Отбор.Вставить("Уровень", Уровни);
	КонецЕсли;

	События = MCP_Утилиты.ВМассивСтрок(MCP_Утилиты.Значение(Параметры, "events"));

	Если События.Количество() > 0 Тогда
		Отбор.Вставить("Событие", События);
	КонецЕсли;

	Сеанс = MCP_Утилиты.ВЧисло(MCP_Утилиты.Значение(Параметры, "session"));

	Если Сеанс > 0 Тогда
		Сеансы = Новый Массив;
		Сеансы.Добавить(Сеанс);
		Отбор.Вставить("Сеанс", Сеансы);
	КонецЕсли;

	РазрешенныеИдентификаторы = Неопределено;
	НайденныеПользователи = Неопределено;
	ИскомоеИмя = "";

	ЗаполнитьОтборПоПользователю(Параметры, Отбор, РазрешенныеИдентификаторы,
		НайденныеПользователи, ИскомоеИмя);

	ЗаполнитьОтборПоОбъекту(Параметры, Отбор);

	Таблица = Новый ТаблицаЗначений;

	УстановитьПривилегированныйРежим(Истина);
	ВыгрузитьЖурналРегистрации(Таблица, Отбор, , , Лимит);
	УстановитьПривилегированныйРежим(Ложь);

	// Выгрузка упёрлась в окно сканирования - данные могут быть неполными.
	ОкноИсчерпано = (Таблица.Количество() >= Лимит);

	Возврат РезультатЖурнала(Таблица, Начало, Окончание, Лимит, РазрешенныеИдентификаторы,
		НайденныеПользователи, ОкноИсчерпано, ИскомоеИмя);

КонецФункции // ЧитатьЖурналРегистрации()

// Отбор по автору события.
//
// Ключ "Пользователь" принимает ПользовательИнформационнойБазы или СТРОКУ-имя, но НЕ UUID.
// Кладём и объект, и имя: удалённого либо пересозданного пользователя журнал хранит под
// прежним идентификатором, и зацепить его старые события можно только по имени-строке.
// Серверный отбор отдаёт события только этих авторов - без сканирования шумного журнала.
//
Процедура ЗаполнитьОтборПоПользователю(Параметры, Отбор, РазрешенныеИдентификаторы,
	НайденныеПользователи, ИскомоеИмя)

	Запрошенный = MCP_Утилиты.Значение(Параметры, "user");

	Если Запрошенный = Неопределено ИЛИ ПустаяСтрока(СокрЛП(Строка(Запрошенный))) Тогда
		Возврат;
	КонецЕсли;

	ИскомоеИмя = НРег(СокрЛП(Строка(Запрошенный)));
	РазрешенныеИдентификаторы = Новый Соответствие;
	НайденныеПользователи = Новый Массив;
	ОтборПользователей = Новый Массив;

	// ПолучитьПользователей() требует административных прав - отсюда привилегированный режим.
	УстановитьПривилегированныйРежим(Истина);

	Для Каждого Пользователь Из ПользователиИнформационнойБазы.ПолучитьПользователей() Цикл

		Если Найти(НРег(Пользователь.Имя), ИскомоеИмя) > 0
			ИЛИ Найти(НРег(Пользователь.ПолноеИмя), ИскомоеИмя) > 0 Тогда

			РазрешенныеИдентификаторы.Вставить(Строка(Пользователь.УникальныйИдентификатор), Истина);
			ОтборПользователей.Добавить(Пользователь);

			Если НЕ ПустаяСтрока(Пользователь.Имя) Тогда
				ОтборПользователей.Добавить(Пользователь.Имя);
			КонецЕсли;

			НайденныеПользователи.Добавить(?(ПустаяСтрока(Пользователь.ПолноеИмя),
				Пользователь.Имя, Пользователь.ПолноеИмя));

		КонецЕсли;

	КонецЦикла;

	УстановитьПривилегированныйРежим(Ложь);

	// Никто из живых не совпал - возможно, спрашивают про удалённого пользователя.
	// Задать его в отборе можно только строкой-именем.
	Если ОтборПользователей.Количество() = 0 Тогда
		ОтборПользователей.Добавить(СокрЛП(Строка(Запрошенный)));
	КонецЕсли;

	Отбор.Вставить("Пользователь", ОтборПользователей);

КонецПроцедуры // ЗаполнитьОтборПоПользователю()

// Отбор по объекту: конкретный (object_type + object_id) либо все объекты типа за период.
//
Процедура ЗаполнитьОтборПоОбъекту(Параметры, Отбор)

	ТипОбъекта = MCP_Утилиты.Значение(Параметры, "object_type");

	Если ТипОбъекта = Неопределено ИЛИ ПустаяСтрока(СокрЛП(Строка(ТипОбъекта))) Тогда
		Возврат;
	КонецЕсли;

	ТипОбъекта = СокрЛП(Строка(ТипОбъекта));
	ИдентификаторОбъекта = MCP_Утилиты.Значение(Параметры, "object_id");

	Если ИдентификаторОбъекта <> Неопределено
		И НЕ ПустаяСтрока(СокрЛП(Строка(ИдентификаторОбъекта))) Тогда

		Отбор.Вставить("Данные", СсылкаПоТипу(ТипОбъекта, СокрЛП(Строка(ИдентификаторОбъекта))));
		Возврат;

	КонецЕсли;

	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ТипОбъекта);

	Если ОбъектМетаданных = Неопределено Тогда
		ВызватьИсключение ОшибкаЗапроса("Unknown object_type: " + ТипОбъекта);
	КонецЕсли;

	СписокМетаданных = Новый Массив;
	СписокМетаданных.Добавить(ОбъектМетаданных);
	Отбор.Вставить("Метаданные", СписокМетаданных);

КонецПроцедуры // ЗаполнитьОтборПоОбъекту()

// Поиск документа по типу, номеру и дате - чтобы получить UUID для object_history.
//
// Параметры:
//  doc_type - Строка    - "ДокументОтгрузки" или "Document.ДокументОтгрузки";
//  number   - Строка    - подстрока номера;
//  period   - {from,to} - окно по дате;
//  limit    - Число     - максимум кандидатов (по умолчанию 20, не более 100).
//
Функция НайтиДокумент(Параметры)

	ИмяДокумента = ИмяТипаДокумента(MCP_Утилиты.Значение(Параметры, "doc_type"));

	Номер = MCP_Утилиты.Значение(Параметры, "number");
	ЕстьНомер = (Номер <> Неопределено И НЕ ПустаяСтрока(СокрЛП(Строка(Номер))));

	Период = MCP_Утилиты.Значение(Параметры, "period");
	ЕстьПериод = (ТипЗнч(Период) = Тип("Соответствие") ИЛИ ТипЗнч(Период) = Тип("Структура"));

	// Без номера и без периода выборка вернула бы весь документооборот.
	Если НЕ ЕстьНомер И НЕ ЕстьПериод Тогда
		ВызватьИсключение ОшибкаЗапроса("provide 'number' or 'period' to find a document");
	КонецЕсли;

	Лимит = БезопасныйЛимит(MCP_Утилиты.ВЧисло(MCP_Утилиты.Значение(Параметры, "limit")), 20, 100);

	Запрос = Новый Запрос;
	Условия = "";

	Если ЕстьНомер Тогда
		Условия = Условия + "
		|	И Документы.Номер ПОДОБНО &Номер СПЕЦСИМВОЛ ""~""";
		Запрос.УстановитьПараметр("Номер",
			"%" + MCP_Утилиты.ЭкранироватьПодобно(СокрЛП(Строка(Номер))) + "%");
	КонецЕсли;

	Если ЕстьПериод Тогда

		Начало = MCP_JSON.ДатаИзСтроки(MCP_Утилиты.Значение(Период, "from", ""));
		Окончание = MCP_JSON.ДатаИзСтроки(MCP_Утилиты.Значение(Период, "to", ""));

		Если НЕ ЗначениеЗаполнено(Начало) ИЛИ НЕ ЗначениеЗаполнено(Окончание) Тогда
			ВызватьИсключение ОшибкаЗапроса("period.from and period.to are required (YYYY-MM-DD)");
		КонецЕсли;

		Условия = Условия + "
		|	И Документы.Дата МЕЖДУ &Начало И &Окончание";
		Запрос.УстановитьПараметр("Начало", НачалоДня(Начало));
		Запрос.УстановитьПараметр("Окончание", КонецДня(Окончание));

	КонецЕсли;

	// ИмяДокумента проверено через Метаданные.Документы.Найти - это имя метаданных,
	// а не пользовательский ввод, поэтому подстановка в текст запроса безопасна.
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит, "ЧГ=0") + "
	|	Документы.Ссылка КАК Ссылка,
	|	Документы.Номер КАК Номер,
	|	Документы.Дата КАК Дата,
	|	Документы.Проведен КАК Проведен,
	|	Документы.ПометкаУдаления КАК ПометкаУдаления
	|ИЗ
	|	Документ." + ИмяДокумента + " КАК Документы
	|ГДЕ
	|	ИСТИНА" + Условия + "
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ";

	// Привилегированный режим - по той же причине, что и в журнале: граница доступа
	// это админ-скоуп, а не права ИБ-пользователя сервиса.
	УстановитьПривилегированныйРежим(Истина);
	Выборка = Запрос.Выполнить().Выбрать();

	Кандидаты = Новый Массив;

	Пока Выборка.Следующий() Цикл

		Кандидат = Новый Структура;
		Кандидат.Вставить("id", Строка(Выборка.Ссылка.УникальныйИдентификатор()));
		Кандидат.Вставить("object_type", "Document." + ИмяДокумента);
		Кандидат.Вставить("number", СокрЛП(Строка(Выборка.Номер)));
		Кандидат.Вставить("date", MCP_JSON.ДатаВСтроку(Выборка.Дата));
		Кандидат.Вставить("posted", Выборка.Проведен);
		Кандидат.Вставить("deletion_mark", Выборка.ПометкаУдаления);
		Кандидат.Вставить("presentation", СокрЛП(Строка(Выборка.Ссылка)));

		Кандидаты.Добавить(Кандидат);

	КонецЦикла;

	УстановитьПривилегированныйРежим(Ложь);

	Результат = Новый Структура;
	Результат.Вставить("doc_type", "Document." + ИмяДокумента);
	Результат.Вставить("candidates", Кандидаты);

	Возврат Результат;

КонецФункции // НайтиДокумент()

// "ДокументОтгрузки" либо "Document.ДокументОтгрузки" -> имя метаданных документа.
// СтрРазделить не используется: режим совместимости 8.2.13.
//
Функция ИмяТипаДокумента(ТипДокумента)

	Если ТипДокумента = Неопределено ИЛИ ПустаяСтрока(СокрЛП(Строка(ТипДокумента))) Тогда
		ВызватьИсключение ОшибкаЗапроса("doc_type is required");
	КонецЕсли;

	Имя = СокрЛП(Строка(ТипДокумента));
	Точка = Найти(Имя, ".");

	Если Точка > 0 Тогда
		Имя = СокрЛП(Сред(Имя, Точка + 1));
	КонецЕсли;

	Если Метаданные.Документы.Найти(Имя) = Неопределено Тогда
		ВызватьИсключение ОшибкаЗапроса("Unknown document type: " + Имя);
	КонецЕсли;

	Возврат Имя;

КонецФункции // ИмяТипаДокумента()

// Ссылка объекта из полного имени типа и UUID, без обращения к базе.
// Поддержаны документы и элементы справочников - то, по чему ведётся аудит.
//
Функция СсылкаПоТипу(ТипОбъекта, ИдентификаторОбъекта)

	Точка = Найти(ТипОбъекта, ".");

	Если Точка = 0 Тогда
		ВызватьИсключение ОшибкаЗапроса(
			"object_type must be like 'Document.Name' or 'Catalog.Name': " + ТипОбъекта);
	КонецЕсли;

	Вид = СокрЛП(Лев(ТипОбъекта, Точка - 1));
	Имя = СокрЛП(Сред(ТипОбъекта, Точка + 1));

	Идентификатор = MCP_Утилиты.УникальныйИдентификаторИзСтроки(ИдентификаторОбъекта);

	Если Идентификатор = Неопределено Тогда
		ВызватьИсключение ОшибкаЗапроса("object_id is not a valid UUID: " + ИдентификаторОбъекта);
	КонецЕсли;

	Если Вид = "Document" ИЛИ Вид = "Документ" Тогда

		Если Метаданные.Документы.Найти(Имя) = Неопределено Тогда
			ВызватьИсключение ОшибкаЗапроса("Unknown document type: " + Имя);
		КонецЕсли;

		Возврат Документы[Имя].ПолучитьСсылку(Идентификатор);

	ИначеЕсли Вид = "Catalog" ИЛИ Вид = "Справочник" Тогда

		Если Метаданные.Справочники.Найти(Имя) = Неопределено Тогда
			ВызватьИсключение ОшибкаЗапроса("Unknown catalog type: " + Имя);
		КонецЕсли;

		Возврат Справочники[Имя].ПолучитьСсылку(Идентификатор);

	КонецЕсли;

	ВызватьИсключение ОшибкаЗапроса(
		"Unsupported object_type kind '" + Вид + "' (expected Document or Catalog)");

КонецФункции // СсылкаПоТипу()

// "error" | "warning" | "information" | "note" (строка или массив) -> массив УровеньЖурналаРегистрации.
// Пустой результат - Неопределено, то есть без отбора по уровню.
//
Функция УровниЖурнала(Значение)

	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Уровни = Новый Массив;

	Для Каждого Элемент Из MCP_Утилиты.ВМассивСтрок(Значение) Цикл

		Метка = НРег(СокрЛП(Строка(Элемент)));

		Если Метка = "error" Тогда
			Уровни.Добавить(УровеньЖурналаРегистрации.Ошибка);
		ИначеЕсли Метка = "warning" Тогда
			Уровни.Добавить(УровеньЖурналаРегистрации.Предупреждение);
		ИначеЕсли Метка = "information" ИЛИ Метка = "info" Тогда
			Уровни.Добавить(УровеньЖурналаРегистрации.Информация);
		ИначеЕсли Метка = "note" Тогда
			Уровни.Добавить(УровеньЖурналаРегистрации.Примечание);
		КонецЕсли;

	КонецЦикла;

	Если Уровни.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Уровни;

КонецФункции // УровниЖурнала()

// Таблица выгрузки журнала -> структура ответа.
//
// Имена колонок платформа отдаёт на языке конфигурации, поэтому фактическое имя
// определяется через ИмяКолонки() - с русским и английским вариантами.
//
Функция РезультатЖурнала(Таблица, Начало, Окончание, Лимит, РазрешенныеИдентификаторы,
	НайденныеПользователи, ОкноИсчерпано, ИскомоеИмя = "")

	КолДата = ИмяКолонки(Таблица, "Дата", "Date");
	КолУровень = ИмяКолонки(Таблица, "Уровень", "Level");
	КолПользователь = ИмяКолонки(Таблица, "Пользователь", "User");
	КолИмяПользователя = ИмяКолонки(Таблица, "ИмяПользователя", "UserName");
	КолСобытие = ИмяКолонки(Таблица, "Событие", "Event");
	КолПредставлениеСобытия = ИмяКолонки(Таблица, "ПредставлениеСобытия", "EventPresentation");
	КолКомментарий = ИмяКолонки(Таблица, "Комментарий", "Comment");
	КолМетаданные = ИмяКолонки(Таблица, "ПредставлениеМетаданных", "MetadataPresentation");
	КолДанные = ИмяКолонки(Таблица, "ПредставлениеДанных", "DataPresentation");
	КолСеанс = ИмяКолонки(Таблица, "Сеанс", "Session");
	КолТранзакция = ИмяКолонки(Таблица, "СтатусТранзакции", "TransactionStatus");
	КолКомпьютер = ИмяКолонки(Таблица, "Компьютер", "Computer");

	ОтборПоАвтору = (РазрешенныеИдентификаторы <> Неопределено);

	События = Новый Массив;
	ДостигнутЛимит = Ложь;

	Для Каждого Строка Из Таблица Цикл

		Идентификатор = ?(КолПользователь = "", "", Строка(Строка[КолПользователь]));

		// Пост-фильтр-страховка: совпадение по UUID ИБ-пользователя либо по подстроке имени
		// из журнала. Имя переживает пересоздание пользователя, когда его текущий UUID уже
		// не равен записанному в старых событиях.
		Если ОтборПоАвтору Тогда

			ИмяВСтроке = ?(КолИмяПользователя = "", "", НРег(Строка(Строка[КолИмяПользователя])));

			Совпал = (РазрешенныеИдентификаторы[Идентификатор] = Истина)
				ИЛИ (ИскомоеИмя <> "" И Найти(ИмяВСтроке, ИскомоеИмя) > 0);

			Если НЕ Совпал Тогда
				Продолжить;
			КонецЕсли;

		КонецЕсли;

		Если События.Количество() >= Лимит Тогда
			ДостигнутЛимит = Истина;
			Прервать;
		КонецЕсли;

		Событие = Новый Структура;
		Событие.Вставить("date", ?(КолДата = "", "", MCP_JSON.ДатаВСтроку(Строка[КолДата])));
		Событие.Вставить("level", ?(КолУровень = "", "", УровеньВСтроку(Строка[КолУровень])));
		Событие.Вставить("user", ?(КолИмяПользователя = "", "", Строка(Строка[КолИмяПользователя])));
		Событие.Вставить("user_id", Идентификатор);
		Событие.Вставить("event", ?(КолСобытие = "", "", Строка(Строка[КолСобытие])));
		Событие.Вставить("event_presentation",
			?(КолПредставлениеСобытия = "", "", Строка(Строка[КолПредставлениеСобытия])));
		Событие.Вставить("comment", ?(КолКомментарий = "", "", Строка(Строка[КолКомментарий])));
		Событие.Вставить("metadata", ?(КолМетаданные = "", "", Строка(Строка[КолМетаданные])));
		Событие.Вставить("object", ?(КолДанные = "", "", Строка(Строка[КолДанные])));
		Событие.Вставить("session", ?(КолСеанс = "", 0, Строка[КолСеанс]));
		Событие.Вставить("transaction_status",
			?(КолТранзакция = "", "", Строка(Строка[КолТранзакция])));
		Событие.Вставить("computer", ?(КолКомпьютер = "", "", Строка(Строка[КолКомпьютер])));

		События.Добавить(Событие);

	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("period", ПериодЖурнала(Начало, Окончание));
	Результат.Вставить("count", События.Количество());
	Результат.Вставить("events", События);

	Если НайденныеПользователи <> Неопределено Тогда
		Результат.Вставить("matched_users", НайденныеПользователи);
	КонецЕсли;

	// Честно сигналим о возможной неполноте: либо упёрлись в лимит, либо выгрузка
	// обрезана окном сканирования - события пользователя могли попасть не целиком.
	Если ОтборПоАвтору И (ДостигнутЛимит ИЛИ ОкноИсчерпано) Тогда
		Результат.Вставить("note",
			"результат мог быть неполным: сузьте период (from/to со временем) или поднимите limit");
	КонецЕсли;

	Возврат Результат;

КонецФункции // РезультатЖурнала()

// Фактическое имя колонки таблицы: платформа может вернуть русское или английское.
// Пустая строка, если нет ни одного из вариантов.
//
Функция ИмяКолонки(Таблица, ИмяРус, ИмяАнгл)

	Если Таблица.Колонки.Найти(ИмяРус) <> Неопределено Тогда
		Возврат ИмяРус;
	КонецЕсли;

	Если Таблица.Колонки.Найти(ИмяАнгл) <> Неопределено Тогда
		Возврат ИмяАнгл;
	КонецЕсли;

	Возврат "";

КонецФункции // ИмяКолонки()

// УровеньЖурналаРегистрации -> стабильная строка, не зависящая от языка интерфейса.
//
Функция УровеньВСтроку(Значение)

	Если Значение = УровеньЖурналаРегистрации.Ошибка Тогда
		Возврат "error";
	ИначеЕсли Значение = УровеньЖурналаРегистрации.Предупреждение Тогда
		Возврат "warning";
	ИначеЕсли Значение = УровеньЖурналаРегистрации.Информация Тогда
		Возврат "information";
	ИначеЕсли Значение = УровеньЖурналаРегистрации.Примечание Тогда
		Возврат "note";
	КонецЕсли;

	Возврат Строка(Значение);

КонецФункции // УровеньВСтроку()

Функция ПериодЖурнала(Начало, Окончание)

	Период = Новый Структура;
	Период.Вставить("from", MCP_JSON.ДатаВСтроку(Начало));
	Период.Вставить("to", MCP_JSON.ДатаВСтроку(Окончание));

	Возврат Период;

КонецФункции // ПериодЖурнала()

// Период журнала С СОХРАНЕНИЕМ времени суток - в отличие от периодов отчётов, которые
// огрубляются до начала и конца суток. Узкое окно резко ускоряет выгрузку: на нагруженной
// базе регламентные задания забивают журнал, и сутки целиком уходят в таймаут.
//
//  период не задан     - текущие сутки целиком;
//  from/to со временем - точное окно;
//  to без времени      - конец этих суток, иначе дата отсекла бы весь день.
//
Процедура РазобратьПериодЖурнала(Период, Начало, Окончание)

	Если ТипЗнч(Период) <> Тип("Соответствие") И ТипЗнч(Период) <> Тип("Структура") Тогда
		Начало = НачалоДня(ТекущаяДата());
		Окончание = КонецДня(ТекущаяДата());
		Возврат;
	КонецЕсли;

	ЗначениеОт = MCP_Утилиты.Значение(Период, "from");
	ЗначениеДо = MCP_Утилиты.Значение(Период, "to");

	Если ЗначениеОт = Неопределено Тогда
		Начало = НачалоДня(ТекущаяДата());
	Иначе
		Начало = MCP_JSON.ДатаИзСтроки(ЗначениеОт);
		Если НЕ ЗначениеЗаполнено(Начало) Тогда
			ВызватьИсключение ОшибкаЗапроса("period.from is not a valid date");
		КонецЕсли;
	КонецЕсли;

	Если ЗначениеДо = Неопределено Тогда
		Окончание = КонецДня(ТекущаяДата());
	Иначе

		Окончание = MCP_JSON.ДатаИзСтроки(ЗначениеДо);

		Если НЕ ЗначениеЗаполнено(Окончание) Тогда
			ВызватьИсключение ОшибкаЗапроса("period.to is not a valid date");
		КонецЕсли;

		// Чистая дата без времени - включаем сутки целиком.
		Если Окончание = НачалоДня(Окончание) Тогда
			Окончание = КонецДня(Окончание);
		КонецЕсли;

	КонецЕсли;

	Если Начало > Окончание Тогда
		ВызватьИсключение ОшибкаЗапроса("period.from is later than period.to");
	КонецЕсли;

КонецПроцедуры // РазобратьПериодЖурнала()

